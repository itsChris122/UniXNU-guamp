# Kernel configuration of the guamp image (from gta4l, same SoC). CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
# No mockfs: it mounted the restore ramdisk (md0) before APFS and served the APFS image as /sbin/launchd.
# CONFIG_XNU_SOURCE_MOCKFS is not set
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# Kryo 260 (Cortex-A73/A53) is ARMv8.0: no PAN, "msr PAN, #1" before arm_vm_init is UNDEFINED there.
# CONFIG_XNU_NATIVE_PAN is not set

# Run the [kernel] archives of board.toml (corecrypto, ARM drivers, display stub) before the link.
CONFIG_XNU_BUILD_ARCHIVES=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/guamp-display-stub/libGuampDisplayStub.a"
CONFIG_XNU_ARMVIRT_PLATFORM=n
# The BCM2837 configuration reads its panic log at 0x3C0FC000, which is not RAM on SM6115 (the read hung
# PE_create_console). Take the panic region from the DT (/pram) instead; without /pram there is none.
CONFIG_XNU_DT_PANIC_REGION=y

# The archive builders reuse these flags and add -Werror; Apple clang 17 (Xcode 16.4) does not know
# -Wno-unnecessary-virtual-specifier, so keep the default list without it.
CONFIG_XNU_EXTRA_CFLAGS="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-suggest-destructor-override -Wno-ms-bitfield-padding"

# iPadOS from the eMMC (drivers/NativeEmmc): the owner-root path of UniXNU mounts the SystemOS cryptex over the
# root (union) and the Data volume (eMMC Data window, below) at /private/var before launchd. Its root and
# volume hooks come from NativeEmmc, linked as the "verified root" archive (force-loaded by the build script);
# scripts/build-xnu-4k-baseline.sh is the guamp copy that accepts it instead of the virtio driver.
CONFIG_XNU_GUAMP_EMMC_ROOT=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/native-emmc/libNativeEmmc.a"
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y

# Persistent Data: the iPadOS Data container lives in a writable window of the SHNGROOT image on userdata
# (strumenti/scrivi-dati-emmc.sh), published by NativeEmmc, and is mounted on /private/var by volume UUID
# (/dev/diskNs1: a whole container such as md0 has no volume index, APFS "invalid fsindex: -1").
CONFIG_XNU_GUAMP_EMMC_DATA=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="829D33D3-9308-4A72-A5A0-2DB1F2A92109"

# AMFI looks up the ApplePMGR nub once launchd runs ("AMFI: No PMGR?"). The sheng integration publishes the original
# nub with a guarded provider (package/ShengPlatformPower.cpp, scripts/build-guamp-platform-power.py, sheng-pmgr=2).
CONFIG_XNU_SHENG_PMGR=y
