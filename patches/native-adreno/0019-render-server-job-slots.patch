+        /* guamp 0019: the render server's job slots (above), waited for outside the lock; the kernel's own client is left alone. */
+        const bool slotted=method==NativeAdrenoMethodSubmit && connection->live_ && !connection->kernel_ && g.clock.now_us;
+        if(slotted)waitForSlots(connection->other_,&connection->live_);
         IOLockLock(g.lock);
+        bool slot_refused=false;
+        if(slotted && connection->live_) {
+            const size_t idle=idleSlotsLocked();
+            if(idle!=SIZE_MAX && idle<slotsWanted(connection->other_)) {
+                slot_refused=true;
+                volatile uint64_t &refused=native_adreno_slot_stats[connection->other_?1:4];
+                refused=refused+1;
+            }
