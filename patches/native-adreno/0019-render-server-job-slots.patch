         const bool limited=native_adreno_gpu_all && connection->other_ && connection->live_;
         uint64_t freed=0;
-        status=kIOReturnSuccess;
+        status=slot_refused?kIOReturnBusy:kIOReturnSuccess;   /* guamp 0019 */
