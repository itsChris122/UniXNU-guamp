+/* SPDX-License-Identifier: MIT */
+/* guamp (UniXNU-guamp patches/native-adreno/0005-gpu-all-dynamic-windows.patch): the bookkeeping of guamp-gpu-all=1, where every process
+ * that opens the accelerator gets a GPU connection (NativeAdrenoPublish.cpp). Plain logic without kernel calls, so the host test
+ * (drivers/GuampAdreno/tests/gpu_all_host.cpp) runs exactly this code.
+ *  - NagWindows: the GPU address windows of the processes other than the render server, taken from the part of the one GPU address
+ *    space above the render server's 1 GiB ([0x60000000, end of the aperture)) in 16 MiB granules, best fit, and given back when the
+ *    connection's teardown has finished. Replaces the fixed 170/256 MiB windows of slots 1..7.
+ *  - NagRates: opens per process name per minute, in place of the eight opens per name per boot: a process that crashes on every launch
+ *    cannot spin the GPU in a loop, while one that is opened again and again by the user (a screenshot, a gallery) keeps getting it.
+ *  - nagAllow*: the limits that keep the render server's memory and its share of the GPU table safe from the other processes. */
+#ifndef NATIVE_ADRENO_GPU_ALL_H
+#define NATIVE_ADRENO_GPU_ALL_H
+#include <stdint.h>
+#include <string.h>
+
+enum : uint64_t {NagGranule=0x1000000ull, NagBase=0x60000000ull, NagTop=0x100000000ull};
+enum : unsigned {NagMaxGranules=unsigned((NagTop-NagBase)/NagGranule)};
+
+struct NagWindows {
+    uint64_t end=NagBase;              /* exclusive end of the managed range (the aperture's end); empty before init */
+    uint8_t used[NagMaxGranules]{};    /* 1: granule belongs to a live (or still draining) connection */
+    void init(uint64_t aperture_end) {
+        end=aperture_end<NagBase?NagBase:(aperture_end>NagTop?NagTop:aperture_end);
+        memset(used,0,sizeof used);
+    }
+    unsigned granules() const {return unsigned((end-NagBase)/NagGranule);}
+    /* Best fit: the smallest free run that holds want; failing that the largest free run of at least min, whole (never more than want).
+     * Sizes are rounded up to granules. False (nothing changed) when no run of min exists. */
+    bool take(uint64_t want,uint64_t min,uint64_t *start,uint64_t *bytes) {
+        if(!start || !bytes || !want)return false;
+        if(min>want)min=want;
+        const unsigned need=unsigned((want+NagGranule-1)/NagGranule),least=unsigned((min+NagGranule-1)/NagGranule);
+        unsigned fit_at=0,fit_len=0,big_at=0,big_len=0;
+        for(unsigned i=0,n=granules();i<n;) {
+            if(used[i]) {++i;continue;}
+            unsigned run=0;
+            while(i+run<n && !used[i+run])++run;
+            if(run>=need && (!fit_len || run<fit_len)) {fit_at=i;fit_len=run;}
+            if(run>big_len) {big_at=i;big_len=run;}
+            i+=run;
+        }
+        unsigned at=0,len=0;
+        if(fit_len) {at=fit_at;len=need;}
+        else if(big_len && big_len>=least) {at=big_at;len=big_len;}
+        else return false;
+        for(unsigned i=0;i<len;++i)used[at+i]=1;
+        *start=NagBase+uint64_t(at)*NagGranule;*bytes=uint64_t(len)*NagGranule;
+        return true;
+    }
+    /* Gives back exactly what take() returned; anything else is ignored. */
+    void give(uint64_t start,uint64_t bytes) {
+        if(start<NagBase || (start-NagBase)%NagGranule || !bytes || bytes%NagGranule || start+bytes>end)return;
+        for(uint64_t at=(start-NagBase)/NagGranule,n=bytes/NagGranule;n;--n,++at)used[at]=0;
+    }
+    uint64_t freeBytes() const {
+        uint64_t total=0;
+        for(unsigned i=0,n=granules();i<n;++i)if(!used[i])total+=NagGranule;
+        return total;
+    }
+};
+
+struct NagRate {char name[20];uint64_t since_ms;uint32_t count;};
+struct NagRates {
+    NagRate rows[64]{};
+    /* One open of name at now_ms: true when it is within per_minute opens of the current minute of that name (0 = no limit). The table
+     * keeps the 64 most recently started names; a name pushed out starts afresh. */
+    bool admit(const char *name,uint64_t now_ms,uint32_t per_minute) {
+        NagRate *row=nullptr,*oldest=&rows[0];
+        for(auto &r:rows) {
+            if(r.name[0] && !strncmp(r.name,name,sizeof r.name)) {row=&r;break;}
+            if(!r.name[0]) {if(oldest->name[0])oldest=&r;}
+            else if(oldest->name[0] && r.since_ms<oldest->since_ms)oldest=&r;
+        }
+        if(!row) {
+            row=oldest;memset(row,0,sizeof *row);
+            strlcpy(row->name,name,sizeof row->name);row->since_ms=now_ms;
+        }
+        if(now_ms-row->since_ms>=60000) {row->since_ms=now_ms;row->count=0;}
+        if(per_minute && row->count>=per_minute)return false;
+        row->count=row->count+1;
+        return true;
+    }
+};
+
+/* The GPU table shared by every connection (NativeAdrenoVm: 16384 mappings, NativeAdrenoGpuContext attaches it with 131072 spans): the
+ * processes other than the render server stop at a quarter short of each, so the render server always finds room (it held about 4000
+ * mappings at most, i567). */
+enum : uint64_t {NagVmObjects=16384, NagVmSpans=131072, NagVmReservedObjects=4096, NagVmReservedSpans=32768};
+inline bool nagAllowMap(uint64_t objects,uint64_t spans,uint64_t new_spans) {
+    return objects<NagVmObjects-NagVmReservedObjects && spans+new_spans<=NagVmSpans-NagVmReservedSpans;
+}
+/* A BO allocation of bytes by a process other than the render server: within its own limit and within the limit of all of them together. */
+inline bool nagAllowBytes(uint64_t client_bytes,uint64_t others_bytes,uint64_t bytes,uint64_t per_client,uint64_t all_others) {
+    return bytes<=per_client && client_bytes<=per_client-bytes && bytes<=all_others && others_bytes<=all_others-bytes;
+}
+#endif
