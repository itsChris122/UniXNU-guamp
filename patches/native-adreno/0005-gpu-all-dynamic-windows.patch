+/* guamp-gpu-all: finishes the teardowns clientClose could not (jobs of the connection still on the GPU, typically a process killed in
+ * the middle of a frame: the hang detector of guamp-gpu-recover retires them within about two seconds if the GPU is stuck). Each one
+ * is tried every 100 ms with a 1 ms wait under the GPU lock, and terminated and released once it has finished. Never gives up: what a
+ * connection still holds may be in use by the GPU, so it is never forced. */
+void nativeAdrenoReaper(void *,wait_result_t)
+{
+    thread_set_thread_name(current_thread(),"guamp-gpu-reaper");
+    for(;;) {
+        AGXDeviceUserClient *done=nullptr;
+        IOLockLock(g.lock);
+        while(!g.deferred)IOLockSleep(g.lock,&g.deferred,THREAD_UNINT);
+        for(AGXDeviceUserClient **at=&g.deferred;*at;) {
+            AGXDeviceUserClient *c=*at;
+            const IOReturn status=c->live_?c->core_->releaseAll(&g.clock,1000):kIOReturnSuccess;
+            c->deferred_tries_=c->deferred_tries_+1;
+            if(status) {
+                if(c->deferred_tries_==600)IOLog("NativeAdrenoReaper: %s (pid %d) still draining after 60 s: %x\n",c->name_,c->pid_,status);
