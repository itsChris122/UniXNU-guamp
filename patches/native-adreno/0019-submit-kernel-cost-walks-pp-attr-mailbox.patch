+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_POLL_PLAN_H
+#define NATIVE_ADRENO_POLL_PLAN_H
+#include <stdint.h>
+/* guamp (UniXNU-guamp patches/native-adreno/0019): the mailbox poller's pause. 1 ms while the page is served (owner and words set), has
+ * been mapped at least once and saw a request within the last 1000 polls; idle_ms otherwise. A first request after an idle stretch
+ * waits at most idle_ms, every one after it 1 ms. */
+enum : uint32_t {NativeAdrenoMailboxBusyPolls=1000};
+static inline uint32_t nativeAdrenoMailboxSleepMs(bool served,uint32_t maps,uint32_t idle_polls,uint32_t idle_ms)
+{
+    if(!idle_ms)idle_ms=1;
+    if(!served || !maps)return idle_ms;
+    return idle_polls<NativeAdrenoMailboxBusyPolls?1:idle_ms;
+}
+#endif
