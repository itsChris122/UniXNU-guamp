diff --git a/NativeAdrenoWcScan.h b/NativeAdrenoWcScan.h
new file mode 100644
index 0000000..dad20b7
--- /dev/null
+++ b/NativeAdrenoWcScan.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_WC_SCAN_H
+#define NATIVE_ADRENO_WC_SCAN_H
+#include <stdint.h>
+#include <stddef.h>
+/* guamp (UniXNU-guamp patches/native-adreno/0019): the write-combine re-assertion's page check over the pmap's physical page attribute
+ * table (XNU osfmk/arm/pmap/pmap_data.h: pp_attr_table[atop(pa - vm_first_phys)], WIMG in PP_ATTR_WIMG_MASK, 0 = VM_WIMG_DEFAULT), the
+ * value pmap_cache_attributes() returns for a page inside [vm_first_phys, vm_last_phys). 4 KiB pages. */
+enum : uint16_t {NativeAdrenoPpAttrWimgMask=0x003f};
+/* The span lies wholly inside the table. */
+static inline bool nativeAdrenoWcScanInTable(uint64_t physical,uint64_t bytes,uint64_t first_phys,uint64_t last_phys)
+{
+    return bytes && physical>=first_phys && physical<last_phys && bytes<=last_phys-physical;
+}
+/* Calls reassert(physical) for each page whose attribute is not wcomb; returns how many. The entry is read again right before the
+ * call is skipped or made, as pmap_cache_attributes() would read it (no lock: the pmap reads it the same way). */
+template<typename Reassert>
+static inline uint32_t nativeAdrenoWcScan(const volatile uint16_t *table,uint64_t first_phys,uint64_t physical,uint64_t bytes,
+    unsigned wcomb,Reassert reassert)
+{
+    uint32_t found=0;
+    const volatile uint16_t *attr=table+((physical-first_phys)>>12);
+    const uint64_t pages=bytes>>12;
+    for(uint64_t i=0;i<pages;++i) {
+        const unsigned wimg=attr[i]&NativeAdrenoPpAttrWimgMask;
+        if(wimg!=wcomb) {reassert(physical+(i<<12));++found;}
+    }
+    return found;
+}
+#endif
