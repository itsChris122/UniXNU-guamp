-IOReturn NativeAdrenoVm::publishMapped()
+/* guamp 0010: mappings outside the submitter's window that publishMapped left alone, and their bytes (MiB). */
+extern "C" {volatile uint64_t native_adreno_publish_skipped[2];}
+IOReturn NativeAdrenoVm::publishMapped(uint64_t window_start,uint64_t window_bytes,uint64_t *maintained_bytes)
 {
     if(!attached_ || poisoned_)return kIOReturnNotReady;
     for(size_t i=0;i<high_;++i) {
         const Mapping &m=mappings_[i];
         if(!m.memory)continue;
         if(coherentMapping(m.writeback) || importedUntouched(m.memory,m.permissions)) {native_adreno_coherent_skips[2]=native_adreno_coherent_skips[2]+1;continue;}
+        if(window_bytes && (m.iova<window_start || m.iova-window_start>=window_bytes)) {
+            native_adreno_publish_skipped[0]=native_adreno_publish_skipped[0]+1;
+            native_adreno_publish_skipped[1]=native_adreno_publish_skipped[1]+m.memory->bytes();
+            continue;
+        }
         if(m.memory->publishForDevice(0,m.memory->bytes(),true,distrust_write_combined_))return fail(ArmSmmu4KIoError);
+        if(maintained_bytes)*maintained_bytes+=m.memory->bytes();
     }
     return kIOReturnSuccess;
 }
