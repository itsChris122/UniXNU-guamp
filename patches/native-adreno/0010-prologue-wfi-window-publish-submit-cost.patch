+    const uint64_t submit_began=submitNowUs();
+    struct CostNote {
+        uint64_t began;
+        ~CostNote() {
+            const uint64_t spent=submitNowUs()-began;
+            native_adreno_submit_cost[0]=native_adreno_submit_cost[0]+1;native_adreno_submit_cost[1]=native_adreno_submit_cost[1]+spent;
+            if(spent>native_adreno_submit_cost[4])native_adreno_submit_cost[4]=spent;
+        }
+    } cost_note{submit_began};
+    if(!native_adreno_publish_window)window_bytes=0;
     if(!fence)return kIOReturnBadArgument;*fence=0;
     if(!attached_ || poisoned_)return kIOReturnNotReady;
     if(!buffers || !count || count>SubmitMaxBuffers)return kIOReturnBadArgument;
@@ -197,7 +214,13 @@
     static uint32_t coherence_turn;
     const bool sample=!(coherence_turn++&63);
     if(sample)(void)vm_->sampleWord(buffers[0].iova,&cached,&before);
-    IOReturn status=vm_->publishMapped();
+    const uint64_t publish_began=submitNowUs();uint64_t maintained=0;
+    IOReturn status=vm_->publishMapped(window_start,window_bytes,&maintained);
+    {
+        const uint64_t spent=submitNowUs()-publish_began;
+        native_adreno_submit_cost[2]=native_adreno_submit_cost[2]+spent;native_adreno_submit_cost[3]=native_adreno_submit_cost[3]+(maintained>>10);
+        if(spent>native_adreno_submit_cost[5])native_adreno_submit_cost[5]=spent;
