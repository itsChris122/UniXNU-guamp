+/* guamp (UniXNU-guamp patches/native-adreno/0010): the cost of each submission, for the board's 10 s line: [0] submissions, [1] us in
+ * submit() in all, [2] us of it in the cache maintenance (publishMapped), [3] KiB maintained, [4] the longest submit() in us, [5] the
+ * longest maintenance in us. native_adreno_publish_window (board: guamp-adreno-publish-window, default 1) keeps a submission's
+ * maintenance to its client's window; 0 walks every client's mappings on every submission, as before. */
+extern "C" {volatile uint64_t native_adreno_submit_cost[6];volatile uint32_t native_adreno_publish_window=1;}
+static uint64_t submitNowUs() {uint64_t ns=0;absolutetime_to_nanoseconds(mach_absolute_time(),&ns);return ns/1000;}
