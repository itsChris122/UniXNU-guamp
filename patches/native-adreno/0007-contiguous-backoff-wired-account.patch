+/* guamp (patch 0007): a contiguous attempt that fails is not cheap in XNU: vm_page_find_contiguous scans every page of RAM three times and,
+ * between the scans, flushes the buffer cache and trims, then drains, the zone caches (zone_gc). Once memory is fragmented every 64 MiB
+ * block of the Metal runtime failed that way (fin6b: 519 failures in one boot, fin8: 14 in four minutes) and then took the scattered
+ * path anyway. After a failure of N bytes the contiguous-first attempts of N bytes or more are skipped for kContigBackoffNs (smaller ones
+ * still try, and the first attempt after the window tries again): the BO is the same scattered one, without the scans and cache flushes.
+ * native_adreno_bo_mem (NativeAdrenoMemory.cpp) [3..7] counts them. */
+extern "C" {extern volatile uint64_t native_adreno_bo_mem[8];}
+static const uint64_t kContigBackoffNs=15ull*1000*1000*1000;
+static uint64_t gContigFailBytes,gContigFailAt;
+static bool contigWorthTrying(uint64_t bytes)
+{
+    const uint64_t failed=__atomic_load_n(&gContigFailBytes,__ATOMIC_RELAXED);
+    if(!failed || bytes<failed)return true;
+    uint64_t window=0;
+    nanoseconds_to_absolutetime(kContigBackoffNs,&window);
+    if(mach_absolute_time()-__atomic_load_n(&gContigFailAt,__ATOMIC_RELAXED)>=window) {
+        __atomic_store_n(&gContigFailBytes,uint64_t(0),__ATOMIC_RELAXED);native_adreno_bo_mem[7]=0;
+        return true;
+    }
+    return false;
+}
+static void contigFailed(uint64_t bytes)
+{
+    const uint64_t failed=__atomic_load_n(&gContigFailBytes,__ATOMIC_RELAXED);
+    if(!failed || bytes<failed)__atomic_store_n(&gContigFailBytes,bytes,__ATOMIC_RELAXED);
+    __atomic_store_n(&gContigFailAt,mach_absolute_time(),__ATOMIC_RELAXED);
+    native_adreno_bo_mem[7]=__atomic_load_n(&gContigFailBytes,__ATOMIC_RELAXED)>>10;
+}
