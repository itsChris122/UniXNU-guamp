diff --git a/NativeAdrenoWrittenPlan.h b/NativeAdrenoWrittenPlan.h
new file mode 100644
index 0000000..ae6376c
--- /dev/null
+++ b/NativeAdrenoWrittenPlan.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_WRITTEN_PLAN_H
+#define NATIVE_ADRENO_WRITTEN_PLAN_H
+#include <stdint.h>
+/* guamp (UniXNU-guamp patches/native-adreno/0021): the GPU-written imports (render targets: IOSurfaces) a client's job may have written
+ * are cleaned and invalidated by physical address before the job (submit) and after it (completion), whoever still maps the pages.
+ * The board maps GPU-written imports clean once at map and leaves them alone afterwards (native_adreno_written_imports_owned: about
+ * 60 ms a frame otherwise); the bridge's own walk (adreno-metal 0001/0010, by virtual address in the writing process) misses the pages
+ * that process no longer maps (0060: the closing app's snapshot in SpringBoard) and SpringBoard then read stale or dirty lines over the
+ * GPU's pixels: black app switcher previews. Jobs name only their IBs, so the kernel does not know which mapping a job wrote; a mapping
+ * of the job's window is walked, as 0001/0010 walk a surface, at the first `limit` completed jobs of its window after it was mapped or
+ * after the window rested `gap` (no completed job of its window for that long): a new or reused capture surface is written right after
+ * a pause, while a window that draws frame after frame (an app's drawables) is walked only at its start.
+ *   walks  completed jobs walked since the mapping was (re)armed     seen  the last completion of its window (0: none yet)
+ *   limit  0: every job, no budget                                    gap   in the caller's time unit (0: armed only at map)
+ * At submission (completed false) nothing is recorded: the walk only says whether the mapping is still armed. */
+struct NativeAdrenoWrittenStep {
+    bool walk;        /* clean and invalidate the mapping now */
+    uint32_t walks;   /* the mapping's new count */
+    uint64_t seen;    /* the mapping's new time of last completion */
+};
+static inline NativeAdrenoWrittenStep nativeAdrenoWrittenStep(uint32_t walks,uint64_t seen,uint64_t now,uint32_t limit,uint64_t gap,
+    bool completed)
+{
+    if(seen && gap && now-seen>=gap)walks=0;   /* the window rested: armed again */
+    NativeAdrenoWrittenStep step{!limit || walks<limit,walks,seen};
+    if(completed) {
+        if(step.walk && limit)++step.walks;
+        step.seen=now?now:1;
+    }
+    return step;
+}
+#endif
