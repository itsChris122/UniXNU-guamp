+IOReturn NativeAdrenoVm::maintainWritten(uint64_t window_start,uint64_t window_bytes,bool completed,uint64_t now,uint64_t gap,
+    uint32_t limit,uint64_t max_bytes,uint64_t out[5])
+{
+    if(!out)return kIOReturnBadArgument;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<high_;++i) {
+        Mapping &m=mappings_[i];
+        if(!m.memory || !m.imported || !(m.permissions&ArmSmmu4KWrite))continue;   /* the mapping's own fields first (0019) */
+        /* Coherent mappings need nothing; without native_adreno_written_imports_owned acquireImported maintains them at every completion. */
+        if(coherentMapping(m.writeback) || native_adreno_io_coherent || !importedUntouched(m.imported,m.permissions))continue;
+        if(window_bytes && (m.iova<window_start || m.iova-window_start>=window_bytes))continue;
+        const NativeAdrenoWrittenStep step=nativeAdrenoWrittenStep(m.wr_walks,m.wr_seen,now,limit,gap,completed);
+        if(!step.walk) {
+            if(completed) {m.wr_walks=step.walks;m.wr_seen=step.seen;}
+            ++out[3];out[4]+=m.bytes;continue;
+        }
+        if(max_bytes && out[1] && out[1]+m.bytes>max_bytes) {   /* over the cap: still armed, walked by the next pass */
+            if(completed)m.wr_seen=step.seen;
+            ++out[2];continue;
+        }
+        /* Imports: NativeAdrenoMemory::maintainImported, DC CIVAC over each span's physical pages, whoever maps them (0060's case). */
+        if(m.memory->acquireDeviceWrites(0,m.memory->bytes()))return fail(ArmSmmu4KIoError);
+        if(completed) {m.wr_walks=step.walks;m.wr_seen=step.seen;}
+        ++out[0];out[1]+=m.bytes;
+    }
+    return kIOReturnSuccess;
+}
