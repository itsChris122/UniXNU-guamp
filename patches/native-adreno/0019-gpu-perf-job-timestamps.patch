+static size_t packet(uint32_t *words,size_t at,uint32_t opcode,const uint32_t *payload,uint32_t count);
+uint32_t NativeAdrenoRing::perfWords(bool framed) const
+{
+    if(!framed || generation_!=6 || !native_adreno_perf_ts)return 0;
+    return 2*RingPerfSampleWords+(native_adreno_a6xx_prologue_wfi?1u:0u);
+}
+uint32_t NativeAdrenoRing::emitPerfSample(uint32_t at,uint32_t slot,uint32_t which,bool idle)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    uint32_t words[1+RingPerfSampleWords]={0};
+    const uint64_t iova=fence_iova_+NativeAdrenoRingPerfOffset+16u*slot+8u*which;
+    const uint32_t payload[3]={RingAlwaysOn|(2u<<18)|RingRegToMem64,(uint32_t)iova,(uint32_t)(iova>>32)};
+    size_t n=idle?packet(words,0,RingWaitForIdle,nullptr,0):0;
+    if(idle && !n)return ~0u;
+    n=packet(words,n,RingRegToMem,payload,3);
+    if(!n)return ~0u;
+    for(size_t i=0;i<n;++i)ring_[(at+i)&mask]=words[i];
+    return (at+(uint32_t)n)&mask;
+}
+bool NativeAdrenoRing::perfSample(uint32_t fence,uint64_t *start,uint64_t *end)
+{
+    const uint32_t slot=fence&(NativeAdrenoRingPerfSlots-1);
+    if(!attached_ || poisoned_ || !fence || !start || !end || !(perf_marked_&(1ull<<slot)))return false;
