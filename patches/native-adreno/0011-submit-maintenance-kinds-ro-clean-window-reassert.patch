diff -ru c/NativeAdrenoVm.cpp d/NativeAdrenoVm.cpp
--- c/NativeAdrenoVm.cpp	2026-11-03 23:25:04.160117156 +0100
+++ d/NativeAdrenoVm.cpp	2026-11-04 00:12:50.000069141 +0100
@@ -426,6 +426,11 @@
 }
 /* guamp 0010: mappings outside the submitter's window that publishMapped left alone, and their bytes (MiB). */
 extern "C" {volatile uint64_t native_adreno_publish_skipped[2];}
+/* guamp 0011: the bytes publishMapped maintained by kind: [0] imported (the owner's cacheable pages), [1] write-combined BOs (only while
+ * write combining is distrusted), [2] other owned BOs; [3] 1 once write combining was distrusted. And native_adreno_publish_ro_clean
+ * (default 1): a mapping the GPU only reads is cleaned (DC CVAC) instead of cleaned and invalidated: nothing the GPU writes can be under
+ * it, and the owner's CPU keeps its lines (Core Animation's backing stores were invalidated on every submission). */
+extern "C" {volatile uint64_t native_adreno_publish_kinds[4];volatile uint32_t native_adreno_publish_ro_clean=1;}
 IOReturn NativeAdrenoVm::publishMapped(uint64_t window_start,uint64_t window_bytes,uint64_t *maintained_bytes)
 {
     if(!attached_ || poisoned_)return kIOReturnNotReady;
@@ -438,8 +443,12 @@
             native_adreno_publish_skipped[1]=native_adreno_publish_skipped[1]+m.memory->bytes();
             continue;
         }
-        if(m.memory->publishForDevice(0,m.memory->bytes(),true,distrust_write_combined_))return fail(ArmSmmu4KIoError);
+        const bool writes=!native_adreno_publish_ro_clean || (m.permissions&ArmSmmu4KWrite);
+        if(m.memory->publishForDevice(0,m.memory->bytes(),writes,distrust_write_combined_))return fail(ArmSmmu4KIoError);
         if(maintained_bytes)*maintained_bytes+=m.memory->bytes();
+        const unsigned kind=m.memory->imported()?0u:m.memory->writeCombined()?1u:2u;
+        if(kind!=1 || distrust_write_combined_)native_adreno_publish_kinds[kind]=native_adreno_publish_kinds[kind]+m.memory->bytes();
+        native_adreno_publish_kinds[3]=distrust_write_combined_?1:0;
     }
