 }
@@ -489,6 +498,19 @@
         const IOReturn status=m.memory->reassertWriteCombined(reset);
         if(status)return status;
     }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoVm::reassertWriteCombinedIn(uint64_t window_start,uint64_t window_bytes,uint32_t *reset) const
+{
+    if(!reset)return kIOReturnBadArgument;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(size_t i=0;i<high_;++i) {
+        const Mapping &m=mappings_[i];
+        if(!m.memory)continue;
+        if(window_bytes && (m.iova<window_start || m.iova-window_start>=window_bytes))continue;
+        const IOReturn status=m.memory->reassertWriteCombined(reset);
+        if(status)return status;
+    }
     return kIOReturnSuccess;
 }
