@@ -451,10 +462,15 @@ IOReturn NativeAdrenoVm::publishMapped(uint64_t window_start,uint64_t window_byt
             native_adreno_publish_client[1]=native_adreno_publish_client[1]+m.memory->bytes();
             continue;
         }
+        if(m.memory->imported() && !(m.permissions&ArmSmmu4KWrite) && native_adreno_ro_imports_owned && !sweep_read_only) {   /* guamp 0013 */
+            native_adreno_publish_ro_owned[0]=native_adreno_publish_ro_owned[0]+1;
+            native_adreno_publish_ro_owned[1]=native_adreno_publish_ro_owned[1]+m.memory->bytes();
+            continue;
+        }
         const bool writes=!native_adreno_publish_ro_clean || (m.permissions&ArmSmmu4KWrite);
