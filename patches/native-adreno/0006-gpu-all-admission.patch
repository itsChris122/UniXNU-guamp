guamp: guamp-gpu-all, limits at open instead of on a live connection's calls; deny list (NativeAdreno 81a0b01 + 0001..0005)

fin1 (kernel 66f47f0, resa10): SpringBoard faulted in libvulkan_freedreno with X0 = -2 right after two BoMaps refused by 0005's
table reserve: Turnip turns a refused map or allocation into VK_ERROR_OUT_OF_DEVICE_MEMORY (-2) and its callers use it. Now:
- a live connection is refused only a BoAlloc over its own ceiling (guamp-gpu-all-bo, 768 MiB by default: a runaway process);
- the shared GPU table reserve and the other processes' BO total are checked when a connection is opened (a refused open is a
  nil device, the behaviour of every process before gpu-all);
- native_adreno_gpu_all_deny (board: guamp-gpu-all-deny, default "SpringBoard,mediaserverd"): those processes are refused at open;
- native_adreno_gpu_all_stats2: table objects/spans, opens refused (deny, table, total), BoAllocs refused.

diff --git a/NativeAdrenoGpuAll.h b/NativeAdrenoGpuAll.h
index cccbd59..ed3c614 100644
--- a/NativeAdrenoGpuAll.h
+++ b/NativeAdrenoGpuAll.h
@@ -89,6 +89,35 @@ enum : uint64_t {NagVmObjects=16384, NagVmSpans=131072, NagVmReservedObjects=409
 inline bool nagAllowMap(uint64_t objects,uint64_t spans,uint64_t new_spans) {
     return objects<NagVmObjects-NagVmReservedObjects && spans+new_spans<=NagVmSpans-NagVmReservedSpans;
 }
+/* guamp (patch 0006): a refused BoMap or BoAlloc of a LIVE connection is VK_ERROR_OUT_OF_DEVICE_MEMORY (-2) inside Turnip, which its
+ * callers do not check: the process then faults on the value -2 (fin1: SpringBoard SIGSEGV, X0 fffffffe, in libvulkan_freedreno, right
+ * after two BoMaps refused by nagAllowMap). So the table reserve and the limit of all processes together are applied when a connection
+ * is OPENED (a refused open is a nil device, which every client handles as before gpu-all), never to a live connection's calls. */
+inline bool nagTablePressure(uint64_t objects,uint64_t spans) {
+    return objects>=NagVmObjects-NagVmReservedObjects || spans>=NagVmSpans-NagVmReservedSpans;
+}
+/* name is in list: comma-separated process names compared on their first 16 characters (the process name), "Name*" a prefix, "*" every
+ * name, blanks around a name ignored. Null or empty list: none. */
+inline bool nagListed(const char *list,const char *name) {
+    if(!list || !name)return false;
+    for(const char *at=list;*at;) {
+        size_t length=0;
+        while(at[length] && at[length]!=',')++length;
+        const char *item=at;
+        size_t n=length;
+        while(n && *item==' ') {++item;--n;}
+        while(n && item[n-1]==' ')--n;
+        if(n) {
+            const bool prefix=item[n-1]=='*';
+            const size_t cmp=prefix?n-1:n;
+            if(prefix && !cmp)return true;
+            const size_t limit=cmp<16?cmp:16;
+            if(!strncmp(name,item,limit) && (prefix || limit==16 || name[limit]==0))return true;
+        }
+        at+=length+(at[length]==','?1:0);
+    }
+    return false;
+}
 /* A BO allocation of bytes by a process other than the render server: within its own limit and within the limit of all of them together. */
 inline bool nagAllowBytes(uint64_t client_bytes,uint64_t others_bytes,uint64_t bytes,uint64_t per_client,uint64_t all_others) {
     return bytes<=per_client && client_bytes<=per_client-bytes && bytes<=all_others && others_bytes<=all_others-bytes;
