+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_REASSERT_PLAN_H
+#define NATIVE_ADRENO_REASSERT_PLAN_H
+#include <stdint.h>
+/* guamp (UniXNU-guamp patches/native-adreno/0012): when a submission re-asserts the write-combined attribute of its window's BOs.
+ * mode 0: every BO at every submission (0011). mode 1: only the BOs a cache-mode event (NativeAdrenoNoteCacheModeEvent) may have touched
+ * since their last re-assertion; while the last event is younger than the quiet time they are re-asserted at every submission and keep
+ * their old epoch (IOKit may still be building a view), afterwards once more and they take the current epoch. Every `check`-th
+ * submission (0: never) walks every BO of the window whatever its epoch: pages found reset in a BO whose epoch was current mean an event
+ * the count missed, and the caller then falls back to mode 0 for good. */
+struct NativeAdrenoReassertPlan {
+    bool all;      /* every write-combined BO of the window, epochs aside */
+    bool settle;   /* the BOs re-asserted take the current epoch */
+};
+static inline NativeAdrenoReassertPlan nativeAdrenoReassertPlan(uint32_t mode,uint32_t check,uint32_t tick,uint64_t now,
+    uint64_t last_event,uint64_t quiet)
+{
+    NativeAdrenoReassertPlan plan{true,false};
+    if(!mode)return plan;
+    plan.all=check && !(tick%check);
+    plan.settle=now-last_event>=quiet;
+    return plan;
+}
+/* Whether a BO last re-asserted at mapping_epoch is walked by a pass at epoch. */
+static inline bool nativeAdrenoReassertWalks(uint32_t mapping_epoch,uint32_t epoch,bool all)
+{
+    return all || mapping_epoch!=epoch;
+}
+#endif
