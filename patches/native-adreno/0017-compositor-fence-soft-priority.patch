guamp: per-process fences on the single ring: the display copy waits for the render server (backboardd) last fence instead of the ring newest, and soft priority: other processes keep at most guamp-gpu-other-depth submissions in flight (their next submit waits outside the GPU lock, at most guamp-gpu-other-wait-us)

diff --git a/NativeAdrenoProcFence.h b/NativeAdrenoProcFence.h
new file mode 100644
index 0000000..37c9813
--- /dev/null
+++ b/NativeAdrenoProcFence.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_PROC_FENCE_H
+#define NATIVE_ADRENO_PROC_FENCE_H
+#include <stdint.h>
+/* guamp (UniXNU-guamp patches/native-adreno/0017): the fences of each process's last submissions, on the single ring of this GPU
+ * (no preemption: the CP runs the ring in order, so a job waits for every job queued before it).
+ *  - The display copy waits for the render server's last fence (native_adreno_compositor_fence), not the ring's newest: the
+ *    swapped surface is the render server's work, and an app's jobs queued after it no longer hold the screen (05/11 Maps: 43
+ *    copy waits timed out at 500 ms, 0.3-2.6 fps).
+ *  - Soft priority: a process other than the render server may have at most `depth` submissions in flight; its next submission
+ *    waits (outside the GPU lock, at most a time limit) until the one `depth` back retired, so a render server job queues behind at
+ *    most `depth` jobs of each app instead of a whole backlog. */
+enum {NativeAdrenoProcFenceSlots=16,NativeAdrenoProcFenceHistory=4};
+struct NativeAdrenoProcFence {
+    int32_t pid;          /* 0: free */
+    uint32_t count;       /* submissions recorded */
+    uint32_t last[NativeAdrenoProcFenceHistory];   /* fence of submission i at last[i % History] */
+    bool compositor;      /* the render server (backboardd) */
+    char name[20];
+};
+/* Fence a process must see retired before its next submission, with at most `depth` in flight (0: none to wait for). */
+static inline uint32_t nativeAdrenoThrottleTarget(const NativeAdrenoProcFence &p,uint32_t depth)
+{
+    if(!depth || depth>NativeAdrenoProcFenceHistory || p.count<depth)return 0;
+    return p.last[(p.count-depth)%NativeAdrenoProcFenceHistory];
+}
+static inline bool nativeAdrenoFenceRetired(uint32_t retired,uint32_t fence) {return !fence || (int32_t)(retired-fence)>=0;}
+static inline void nativeAdrenoNoteFence(NativeAdrenoProcFence &p,uint32_t fence)
+{
+    p.last[p.count%NativeAdrenoProcFenceHistory]=fence;p.count=p.count+1;
+}
+/* The slot of pid, or the one to take for it: a free one, else the one whose last fence is oldest. */
+static inline unsigned nativeAdrenoProcSlot(const NativeAdrenoProcFence *table,int32_t pid,bool *found)
+{
+    *found=false;
+    if(pid<=0)return NativeAdrenoProcFenceSlots;   /* the kernel's own submissions are nobody's */
+    for(unsigned i=0;i<NativeAdrenoProcFenceSlots;++i)if(table[i].pid==pid) {*found=true;return i;}
+    for(unsigned i=0;i<NativeAdrenoProcFenceSlots;++i)if(!table[i].pid)return i;
+    unsigned take=0;
+    for(unsigned i=1;i<NativeAdrenoProcFenceSlots;++i) {
+        const NativeAdrenoProcFence &a=table[i],&b=table[take];
+        const uint32_t na=a.count?a.last[(a.count-1)%NativeAdrenoProcFenceHistory]:0,nb=b.count?b.last[(b.count-1)%NativeAdrenoProcFenceHistory]:0;
+        if((int32_t)(na-nb)<0)take=i;
+    }
+    return take;
+}
+static inline bool nativeAdrenoIsCompositor(const char *name)
+{
+    static const char want[]="backboardd";
+    for(unsigned i=0;i<sizeof want;++i)if(name[i]!=want[i])return false;
+    return true;
+}
+#endif
