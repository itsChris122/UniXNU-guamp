+/* guamp (UniXNU-guamp patches/native-adreno/0017, NativeAdrenoProcFence.h): each process's last fences, written under the GPU lock by
+ * submit(), read without it (fences only grow: a stale read waits a little more or less). native_adreno_compositor_fence: the render
+ * server's last fence (0 none yet). native_adreno_retired_fence: the board's reader of the CP timestamp (null: no soft priority).
+ * native_adreno_other_depth (guamp-gpu-other-depth, default 2, 0 off, max 4) and native_adreno_other_wait_us (guamp-gpu-other-wait-us,
+ * default 50000). native_adreno_throttle_stats: [0] submissions that waited, [1] of them up to the limit, [2] us waited, [3] longest. */
+extern "C" {
+NativeAdrenoProcFence native_adreno_proc_fences[NativeAdrenoProcFenceSlots];
+volatile uint32_t native_adreno_compositor_fence,native_adreno_other_depth=2,native_adreno_other_wait_us=50000;
+uint32_t (*native_adreno_retired_fence)(void);
+volatile uint64_t native_adreno_throttle_stats[4];
+}
+static void noteProcessFence(uint32_t fence)
+{
+    const int32_t pid=proc_selfpid();
+    bool found=false;
+    const unsigned slot=nativeAdrenoProcSlot(native_adreno_proc_fences,pid,&found);
+    if(slot>=NativeAdrenoProcFenceSlots)return;
+    NativeAdrenoProcFence &p=native_adreno_proc_fences[slot];
+    if(!found) {
+        p=NativeAdrenoProcFence{};
+        proc_selfname(p.name,sizeof p.name);p.name[sizeof p.name-1]=0;
+        p.compositor=nativeAdrenoIsCompositor(p.name);
+        __atomic_store_n(&p.pid,pid,__ATOMIC_RELEASE);
+    }
+    nativeAdrenoNoteFence(p,fence);
+    if(p.compositor)__atomic_store_n(&native_adreno_compositor_fence,fence,__ATOMIC_RELEASE);
+}
+/* The fence the calling process must see retired before it submits again (0: none, or the render server, or the switch off). */
+extern "C" uint32_t native_adreno_throttle_target(void)
+{
+    const uint32_t depth=native_adreno_other_depth;
+    if(!depth || !native_adreno_retired_fence)return 0;
+    const int32_t pid=proc_selfpid();
+    for(unsigned i=0;i<NativeAdrenoProcFenceSlots;++i) {
+        const NativeAdrenoProcFence &p=native_adreno_proc_fences[i];
+        if(__atomic_load_n(&p.pid,__ATOMIC_ACQUIRE)==pid && pid)return p.compositor?0:nativeAdrenoThrottleTarget(p,depth);
+    }
+    return 0;
+}
