index 0000000..d6ad213
--- /dev/null
+++ b/tests/coachz_bb_uimprov_model_test.c
@@ -0,0 +1,183 @@
+/* guamp: host model of the UIM provisioning session (coachz_bb_uimprov.h): card status parsing, the 0x38 open and close, once per
+   card, then the follow-up of a session whose USIM stays "detected" (own card status every 10 s, close and reopen after 20 s). */
+#include <stdio.h>
+#include <string.h>
+#include "coachz_bb_uimprov.h"
+
+static int failures;
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); failures++; } } while (0)
+
+static const uint8_t usim_aid[16] = { 0xa0, 0, 0, 0, 0x87, 0x10, 0x02, 0xff, 0x39, 0xff, 0xff, 0x89, 0x06, 0x05, 0, 0xff };
+static const uint8_t isim_aid[16] = { 0xa0, 0, 0, 0, 0x87, 0x10, 0x04, 0xff, 0x39, 0xff, 0xff, 0x89, 0x06, 0x05, 0, 0xff };
+
+static uint32_t app(uint8_t *p, uint8_t type, uint8_t state, const uint8_t *aid)
+{
+    uint32_t w = 0;
+    p[w++] = type; p[w++] = state; p[w++] = 2; p[w++] = 0; p[w++] = 0; p[w++] = 0; p[w++] = 16;
+    memcpy(p + w, aid, 16); w += 16;
+    p[w++] = 0; p[w++] = 3 /* PIN1 disabled */; p[w++] = 3; p[w++] = 10; p[w++] = 1; p[w++] = 3; p[w++] = 10;
+    return w;
+}
+/* type 2 answer to 0x2f or type 4 indication 0x32; card one present (ISIM then USIM) or absent, card two in error */
+static uint32_t card_status(uint8_t *sdu, uint8_t type, uint16_t gw, int present, uint8_t usim_state, int truncate)
+{
+    uint8_t t[200];
+    uint32_t w = 0;
+    t[w++] = (uint8_t)gw; t[w++] = (uint8_t)(gw >> 8);
+    for (int i = 0; i < 6; i++) t[w++] = 0xff;
+    t[w++] = 2;
+    t[w++] = present ? 1 : 0; t[w++] = 0; t[w++] = 3; t[w++] = 10; t[w++] = present ? 0 : 3; t[w++] = present ? 2 : 0;
+    if (present) { w += app(t + w, 5, 1, isim_aid); w += app(t + w, CBU_APP_USIM, usim_state, usim_aid); }
+    t[w++] = 2; t[w++] = 0; t[w++] = 3; t[w++] = 10; t[w++] = 3; t[w++] = 0;
+    if (truncate) w -= 10;
+    uint32_t n = 7;
+    sdu[0] = type; cbd_wr16(sdu + 1, 5); cbd_wr16(sdu + 3, type == 2 ? CBU_GET_CARD_STATUS : CBU_STATUS_CHANGE);
+    if (type == 2) { const uint8_t ok[4] = { 0, 0, 0, 0 }; n += cbd_tlv(sdu + n, 512, 0x02, ok, 4); }
+    n += cbd_tlv(sdu + n, 512, 0x10, t, w);
+    const uint8_t hot[3] = { 2, 1, 1 };
+    n += cbd_tlv(sdu + n, 512, 0x11, hot, 3);
+    cbd_wr16(sdu + 5, n - 7);
+    return n;
+}
+static uint32_t answer(uint8_t *a, uint32_t txn, uint32_t message, uint16_t error)
+{
+    uint32_t n = 7;
+    a[0] = 2; cbd_wr16(a + 1, txn); cbd_wr16(a + 3, message);
+    uint8_t r[4] = { (uint8_t)(error ? 1 : 0), 0, (uint8_t)error, (uint8_t)(error >> 8) };
+    n += cbd_tlv(a + n, 25, 0x02, r, 4); cbd_wr16(a + 5, n - 7);
+    return n;
+}
+
+int main(void)
+{
+    uint8_t sdu[512], req[96], ans[32];
+    struct cbu_status s;
+    struct cbu_prov p;
+    uint32_t error = 99;
+    memset(&p, 0, sizeof p);
+
+    /* card present, USIM detected, no primary GW session: one request with slot 1 and the USIM AID (not the ISIM) */
+    uint32_t n = card_status(sdu, 2, CBU_NO_SESSION, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s));
+    CHECK(s.gw_primary == CBU_NO_SESSION && s.cards == 2 && s.present == 1);
+    CHECK(s.card_state[0] == 1 && s.card_apps[0] == 2 && s.card_state[1] == 2 && s.card_error[1] == 3);
+    CHECK(s.slot == 1 && s.app_type == CBU_APP_USIM && s.app_state == 1 && s.pin1_state == 3 && s.perso_state == 2 && s.aid_len == 16);
+    CHECK(s.tlvs == 3 && s.tlv_type[0] == 2 && s.tlv_type[1] == 0x10 && s.tlv_type[2] == 0x11 && s.tlv_len[2] == 3);
+    CHECK(!memcmp(s.aid, usim_aid, 16));
+    CHECK(cbu_tick(&p, 500) == CBU_DO_NOTHING);                      /* nothing before a card status */
+    CHECK(cbu_need(&p, &s, 1000));
+    uint32_t txn = cbu_next_txn(&p);
+    uint32_t len = cbu_request(req, sizeof req, txn, &s, 1);
+    const uint8_t want[] = { 0, (uint8_t)txn, (uint8_t)(txn >> 8), 0x38, 0, 26, 0, 0x01, 2, 0, 0, 1, 0x10, 18, 0, 1, 16 };
+    CHECK(len == 7 + 5 + 3 + 18);
+    CHECK(!memcmp(req, want, sizeof want) && !memcmp(req + sizeof want, usim_aid, 16));
+    CHECK(txn >= CBU_TXN_BASE);
+    cbu_sent(&p, txn, 1000, CBU_WAIT_OPEN);
+    /* while it is pending, the same status asks nothing more; the indication form parses the same way */
+    n = card_status(sdu, 4, CBU_NO_SESSION, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s) && s.slot == 1);
+    CHECK(!cbu_need(&p, &s, 2000));
+    CHECK(cbu_tick(&p, 2000) == CBU_DO_NOTHING);
+    /* the answer: matched by message and transaction, others are left to the eSIM code */
+    n = answer(ans, txn + 1, 0x38, 0);
+    CHECK(!cbu_answer(&p, ans, n, &error));
+    n = answer(ans, txn, 0x2f, 0);
+    CHECK(!cbu_answer(&p, ans, n, &error));
+    n = answer(ans, txn, 0x38, 0);
+    CHECK(cbu_answer(&p, ans, n, &error) == CBU_WAIT_OPEN && error == 0 && !p.pending);
+
+    /* fin57: the session opens but the USIM stays detected: own card status every 10 s, then a close at 20 s */
+    n = card_status(sdu, 4, 0x0001, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s) && s.gw_primary == 1);
+    CHECK(!cbu_need(&p, &s, 3000) && p.done && !p.ready && p.session_ms == 3000);
+    CHECK(cbu_tick(&p, 3000) == CBU_DO_NOTHING);                     /* 10 s between polls, from the session */
+    CHECK(cbu_tick(&p, 13000) == CBU_DO_POLL);
+    txn = cbu_next_txn(&p);
+    len = cbu_status_request(req, sizeof req, txn);
+    CHECK(len == 7 && req[0] == 0 && cbd_rd16(req + 3) == 0x2f && cbd_rd16(req + 5) == 0);
+    cbu_sent(&p, txn, 13000, CBU_WAIT_STATUS);
+    CHECK(cbu_tick(&p, 14000) == CBU_DO_NOTHING);                    /* pending */
+    n = card_status(sdu, 2, 0x0001, 1, 1, 0);
+    cbd_wr16(sdu + 1, txn);
+    CHECK(cbu_answer(&p, sdu, n, &error) == CBU_WAIT_STATUS && !error);
+    CHECK(cbu_parse(sdu, n, &s) && !cbu_need(&p, &s, 14000));
+    CHECK(cbu_tick(&p, 18000) == CBU_DO_NOTHING);
+    CHECK(cbu_tick(&p, 23000) == CBU_DO_CLOSE);                      /* 20 s after the session opened */
+    txn = cbu_next_txn(&p);
+    len = cbu_request(req, sizeof req, txn, &p.last, 0);
+    const uint8_t close[] = { 0, (uint8_t)txn, (uint8_t)(txn >> 8), 0x38, 0, 5, 0, 0x01, 2, 0, 0, 0 };
+    CHECK(len == sizeof close && !memcmp(req, close, sizeof close));
+    cbu_sent(&p, txn, 23000, CBU_WAIT_CLOSE);
+    n = answer(ans, txn, 0x38, 0);
+    CHECK(cbu_answer(&p, ans, n, &error) == CBU_WAIT_CLOSE && !p.done && p.reopens == 1);
+    /* reopen right away from the last status */
+    CHECK(cbu_need(&p, &p.last, 23100));
+    txn = cbu_next_txn(&p);
+    cbu_sent(&p, txn, 23100, CBU_WAIT_OPEN);
+    n = answer(ans, txn, 0x38, 0);
+    CHECK(cbu_answer(&p, ans, n, &error) == CBU_WAIT_OPEN);
+    /* the second session: stuck again, a second close; after that only polls until the watch ends */
+    n = card_status(sdu, 4, 0x0001, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s) && !cbu_need(&p, &s, 24000));
+    CHECK(cbu_tick(&p, 44000) == CBU_DO_CLOSE);
+    txn = cbu_next_txn(&p);
+    cbu_sent(&p, txn, 44000, CBU_WAIT_CLOSE);
+    n = answer(ans, txn, 0x38, 0);
+    CHECK(cbu_answer(&p, ans, n, &error) == CBU_WAIT_CLOSE && p.reopens == 2);
+    CHECK(cbu_need(&p, &p.last, 44100));
+    txn = cbu_next_txn(&p);
+    cbu_sent(&p, txn, 44100, CBU_WAIT_OPEN);
+    n = answer(ans, txn, 0x38, 0);
+    CHECK(cbu_answer(&p, ans, n, &error) == CBU_WAIT_OPEN);
+    n = card_status(sdu, 4, 0x0001, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s) && !cbu_need(&p, &s, 45000));
+    CHECK(cbu_tick(&p, 70000) == CBU_DO_POLL);                       /* no third close */
+    cbu_sent(&p, cbu_next_txn(&p), 70000, CBU_WAIT_STATUS);
+    p.pending = 0;
+    CHECK(cbu_tick(&p, 45000 + CBU_WATCH_MS) == CBU_DO_NOTHING);      /* the watch ends */
+    /* ready: nothing more */
+    memset(&p, 0, sizeof p);
+    p.tries = 1;
+    n = card_status(sdu, 4, 0x0001, 1, CBU_APP_READY, 0);
+    CHECK(cbu_parse(sdu, n, &s) && !cbu_need(&p, &s, 1000) && p.ready);
+    CHECK(cbu_tick(&p, 30000) == CBU_DO_NOTHING);
+    /* a session the modem opened by itself is left alone */
+    memset(&p, 0, sizeof p);
+    n = card_status(sdu, 4, 0x0001, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s) && !cbu_need(&p, &s, 1000));
+    CHECK(cbu_tick(&p, 30000) == CBU_DO_NOTHING);
+
+    /* no answer: after the timeout a new card status tries again, at most CBU_TRIES times per card */
+    memset(&p, 0, sizeof p);
+    n = card_status(sdu, 2, CBU_NO_SESSION, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s));
+    uint32_t now = 0, sent = 0;
+    for (int i = 0; i < 6; i++, now += CBU_TIMEOUT_MS) if (cbu_need(&p, &s, now)) { cbu_sent(&p, cbu_next_txn(&p), now, CBU_WAIT_OPEN); sent++; }
+    CHECK(sent == CBU_TRIES);
+    /* card removed: tries reset, nothing sent; a new card is tried again */
+    n = card_status(sdu, 4, CBU_NO_SESSION, 0, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s) && !s.present && !s.slot);
+    CHECK(!cbu_need(&p, &s, now) && p.tries == 0);
+    n = card_status(sdu, 4, CBU_NO_SESSION, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &s) && cbu_need(&p, &s, now + 2 * CBU_TIMEOUT_MS));
+
+    /* the log key changes with the state, not with the transaction */
+    struct cbu_status a, b;
+    n = card_status(sdu, 4, 0x0001, 1, 1, 0);
+    CHECK(cbu_parse(sdu, n, &a));
+    cbd_wr16(sdu + 1, 77);
+    CHECK(cbu_parse(sdu, n, &b) && cbu_key(&a) == cbu_key(&b));
+    n = card_status(sdu, 4, 0x0001, 1, CBU_APP_READY, 0);
+    CHECK(cbu_parse(sdu, n, &b) && cbu_key(&a) != cbu_key(&b));
+
+    /* malformed or other messages are not parsed */
+    n = card_status(sdu, 2, CBU_NO_SESSION, 1, 1, 1);
+    CHECK(!cbu_parse(sdu, n, &s));
+    n = card_status(sdu, 2, CBU_NO_SESSION, 1, 1, 0);
+    sdu[3] = 0x20;
+    CHECK(!cbu_parse(sdu, n, &s));
+    CHECK(!cbu_parse(sdu, 5, &s));
+
+    printf("%s: %d failures\n", __FILE__, failures);
+    return failures != 0;
+}
