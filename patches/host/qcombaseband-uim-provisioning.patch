+// guamp: UIM provisioning session (coachz_bb_uimprov.h). Every card status the modem gives CommCenter is looked at; with a card and no
+// primary GW session the bridge asks the modem, on the eSIM code's UIM client, to open it for the card's USIM (once per card, 3 tries).
+static struct cbu_prov bb_prov;
+static uint8_t bb_prov_req[96];
+static void bb_uim_status_note(uint32_t service, const uint8_t *sdu, uint32_t n)
+{
+  struct cbu_status s;
+  if (service != CBU_SVC_UIM || !cbu_parse(sdu, n, &s)) return;
+  if (bb_prov.logged < 24) {
+    bb_prov.logged++;
+    printf("COACHZ baseband: UIM card status (%s): primary GW session 0x%04x, %u cards, slot one card %u error %u apps %u, slot two card %u error %u apps %u; %s in slot %u state %u PIN1 %u perso %u\n",
+           sdu[0] == 4u ? "indication" : "answer", s.gw_primary, s.cards, s.card_state[0], s.card_error[0], s.card_apps[0], s.card_state[1],
+           s.card_error[1], s.card_apps[1], s.app_type == CBU_APP_USIM ? "USIM" : s.app_type == CBU_APP_SIM ? "SIM" : "no application", s.slot,
+           s.app_state, s.pin1_state, s.perso_state);
+  }
+  const uint32_t now = bb_now_ms();
+  if (bb_esim.freeze || bb_esim.active >= 0 || bb_esim_slot < 0 || !cbu_need(&bb_prov, &s, now)) return;
+  const struct cbq_server *server = cbq_server_find(&bb_qmux, CBE_SVC_UIM);
+  if (!server) return;
+  const uint32_t txn = cbu_next_txn(&bb_prov), len = cbu_request(bb_prov_req, sizeof bb_prov_req, txn, &s);
+  if (!len) return;
+  const uint32_t queued = bb_tx_count;
+  bb_queue_tx(CBQ_PORT_BASE + (uint32_t)bb_esim_slot, server->node, server->port, bb_prov_req, len);
+  if (bb_tx_count == queued) return;
+  cbu_sent(&bb_prov, txn, now);
+  printf("COACHZ baseband: UIM provisioning session asked for slot %u (%s, state %u), try %u\n", s.slot,
+         s.app_type == CBU_APP_USIM ? "USIM" : "SIM", s.app_state, bb_prov.tries);
+}
+
