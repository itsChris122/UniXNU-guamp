diff --git a/baseband/coachz_bb_uimprov.h b/baseband/coachz_bb_uimprov.h
new file mode 100644
index 0000000..31af4b9
--- /dev/null
+++ b/baseband/coachz_bb_uimprov.h
@@ -0,0 +1,191 @@
+/* guamp: UIM provisioning session for a modem whose firmware waits for the host to choose the SIM application.
+ *
+ * The SM6115 modem (Moto G9 Play, Android firmware) reads the card but does not open the GW provisioning session by itself: on
+ * Android QCRIL sends UIM Change Provisioning Session (0x38) for the card's USIM. Until then Get Card Status has no primary GW
+ * session (index 0xffff), the USIM stays "detected", the modem camps for emergency calls only ("SOS") and CommCenter, which on an
+ * Apple modem never sends 0x38, reads no file of the card (no ICCID, IMSI or PIN state). postmarketOS does the same for these modems
+ * (msm-modem-uim-selection: --uim-change-provisioning-session slot=N,activate=yes,session-type=primary-gw-provisioning,aid=USIM).
+ *
+ * The bridge watches every card status (CommCenter's Get Card Status answers and the Status Change indications) and, while a card is
+ * present with a USIM (or SIM) application and there is no primary GW session, sends 0x38 once per card on its own UIM client. The
+ * modem then initialises the application and indicates the new status to CommCenter, which goes on as with an Apple modem.
+ *
+ * fin57 (07/11): the session opened (0x0000) and PIN1 went to "disabled", but the USIM stayed "detected" with no further indication.
+ * So after the session exists the bridge also follows the application: its own Get Card Status every 10 s for 2 minutes while the
+ * application is not ready (each status logged when it changes), and when it is still "detected" 20 s after the session opened it
+ * closes and reopens the session (msm-modem-uim-selection does the same for a "bugged" session), at most twice per card.
+ * The card status is logged as states only (card, application type, state, personalization, PIN1, the TLV list), never the AID. */
+#ifndef COACHZ_BB_UIMPROV_H
+#define COACHZ_BB_UIMPROV_H
+#include <stdint.h>
+#include "coachz_bb_data.h"
+
+#define CBU_SVC_UIM 0x0bu
+#define CBU_GET_CARD_STATUS 0x002fu
+#define CBU_STATUS_CHANGE 0x0032u
+#define CBU_CHANGE_PROVISIONING 0x0038u
+#define CBU_NO_SESSION 0xffffu
+#define CBU_CARD_PRESENT 1u
+#define CBU_APP_SIM 1u
+#define CBU_APP_USIM 2u
+#define CBU_APP_DETECTED 1u
+#define CBU_APP_ILLEGAL 6u
+#define CBU_APP_READY 7u
+#define CBU_SLOTS 4u
+#define CBU_TLVS 8u
+#define CBU_TRIES 3u
+#define CBU_TIMEOUT_MS 10000u
+#define CBU_POLL_MS 10000u            /* the bridge's own Get Card Status while the application is not ready */
+#define CBU_WATCH_MS 120000u          /* ... for this long after the session opened */
+#define CBU_STUCK_MS 20000u           /* "detected" this long with a session: close and reopen it */
+#define CBU_REOPENS 2u
+#define CBU_TXN_BASE 0x7e00u          /* far from the eSIM client's own transactions on the same UIM client */
+
+struct cbu_status {
+    uint16_t gw_primary;
+    uint8_t cards, present, tlvs;
+    uint8_t card_state[CBU_SLOTS], card_apps[CBU_SLOTS], card_error[CBU_SLOTS], upin_state[CBU_SLOTS];
+    uint8_t slot;                     /* 1-based slot of the chosen application, 0 when there is none */
+    uint8_t app_type, app_state, pin1_state, perso_state, perso_feature, perso_retries, aid_len;
+    uint8_t tlv_type[CBU_TLVS];
+    uint16_t tlv_len[CBU_TLVS];
+    uint8_t aid[32];
+};
+
+/* Card status (TLV 0x10) of a Get Card Status answer without error or of a Status Change indication: 1 when parsed. */
+static inline int cbu_parse(const uint8_t *sdu, uint32_t n, struct cbu_status *s)
+{
+    if (n < 7u || !cbd_sdu_ok(sdu, n)) return 0;
+    const uint32_t message = cbd_rd16(sdu + 3);
+    if (!((sdu[0] == 2u && message == CBU_GET_CARD_STATUS && !cbd_error(sdu, n)) || (sdu[0] == 4u && message == CBU_STATUS_CHANGE)))
+        return 0;
+    uint32_t len = 0;
+    const uint8_t *p = cbd_find(sdu, n, 0x10, &len);
+    if (!p || len < 9u) return 0;
+    for (uint32_t i = 0; i < sizeof *s; i++) ((uint8_t *)s)[i] = 0;
+    for (uint32_t at = 7u, end = 7u + cbd_rd16(sdu + 5); at < end && s->tlvs < CBU_TLVS; at += 3u + cbd_rd16(sdu + at + 1)) {
+        s->tlv_type[s->tlvs] = sdu[at]; s->tlv_len[s->tlvs] = cbd_rd16(sdu + at + 1); s->tlvs++;
+    }
+    s->gw_primary = cbd_rd16(p);
+    s->cards = p[8];
+    uint32_t at = 9u;
+    for (uint32_t c = 0; c < s->cards; c++) {
+        if (len - at < 6u) return 0;
+        const uint8_t state = p[at], upin = p[at + 1], error = p[at + 4], apps = p[at + 5];
+        at += 6u;
+        if (c < CBU_SLOTS) { s->card_state[c] = state; s->card_error[c] = error; s->card_apps[c] = apps; s->upin_state[c] = upin; }
+        if (state == CBU_CARD_PRESENT) s->present++;
+        for (uint32_t a = 0; a < apps; a++) {
+            if (len - at < 7u) return 0;
+            const uint8_t type = p[at], app_state = p[at + 1], aid_len = p[at + 6];
+            if (len - at < 7u + aid_len + 7u) return 0;
+            const uint8_t *aid = p + at + 7u, *pins = aid + aid_len;
+            const int better = state == CBU_CARD_PRESENT && aid_len && aid_len <= sizeof s->aid && app_state != CBU_APP_ILLEGAL &&
+                (type == CBU_APP_USIM ? s->app_type != CBU_APP_USIM : (type == CBU_APP_SIM && !s->slot));
+            if (better && c < 255u) {
+                s->slot = (uint8_t)(c + 1u); s->app_type = type; s->app_state = app_state; s->perso_state = p[at + 2];
+                s->perso_feature = p[at + 3]; s->perso_retries = p[at + 4]; s->pin1_state = pins[1]; s->aid_len = aid_len;
+                for (uint32_t i = 0; i < aid_len; i++) s->aid[i] = aid[i];
+            }
+            at += 7u + aid_len + 7u;
+        }
+    }
+    return 1;
+}
+
+/* A short fingerprint of what the log line shows, to print a status only when it changes. */
+static inline uint32_t cbu_key(const struct cbu_status *s)
+{
+    uint32_t k = 2166136261u;
+    const uint8_t v[] = { (uint8_t)s->gw_primary, (uint8_t)(s->gw_primary >> 8), s->cards, s->card_state[0], s->card_state[1],
+        s->card_error[0], s->card_error[1], s->card_apps[0], s->card_apps[1], s->upin_state[0], s->slot, s->app_type, s->app_state,
+        s->pin1_state, s->perso_state, s->perso_feature, s->perso_retries, s->tlvs };
+    for (uint32_t i = 0; i < sizeof v; i++) k = (k ^ v[i]) * 16777619u;
+    for (uint32_t i = 0; i < s->tlvs; i++) k = (k ^ s->tlv_type[i] ^ (uint32_t)s->tlv_len[i] << 8) * 16777619u;
+    return k;
+}
+
+/* UIM Change Provisioning Session: open (activate 1, with the application) or close (activate 0) the primary GW session. */
+static inline uint32_t cbu_request(uint8_t *sdu, uint32_t room, uint32_t txn, const struct cbu_status *s, int activate)
+{
+    if (!s->slot || !s->aid_len || room < 7u + 5u + 5u + s->aid_len) return 0;
+    const uint8_t session[2] = { 0u /* primary GW provisioning */, (uint8_t)(activate ? 1u : 0u) };
+    uint8_t app[2 + sizeof s->aid];
+    app[0] = s->slot; app[1] = s->aid_len;
+    for (uint32_t i = 0; i < s->aid_len; i++) app[2 + i] = s->aid[i];
+    uint32_t w = cbd_tlv(sdu + 7, room - 7u, 0x01, session, 2);
+    if (activate) w += cbd_tlv(sdu + 7 + w, room - 7u - w, 0x10, app, 2u + s->aid_len);
+    return cbd_request(sdu, txn, CBU_CHANGE_PROVISIONING, w);
+}
+/* Get Card Status from the bridge's client. */
+static inline uint32_t cbu_status_request(uint8_t *sdu, uint32_t room, uint32_t txn)
+{
+    return room < 7u ? 0 : cbd_request(sdu, txn, CBU_GET_CARD_STATUS, 0);
+}
+
+enum { CBU_WAIT_NONE, CBU_WAIT_OPEN, CBU_WAIT_CLOSE, CBU_WAIT_STATUS };
+enum { CBU_DO_NOTHING, CBU_DO_POLL, CBU_DO_CLOSE };
+struct cbu_prov {
+    uint8_t tries, pending, done, logged, reopens, have, ready;
+    uint16_t txn, wait_txn;
+    uint32_t deadline, sent, answered, last_error, session_ms, polled_ms, key;
+    struct cbu_status last;           /* the last parsed status with a card: the application for a close or reopen */
+};
+
+/* After a parsed card status: 1 when the bridge should open the session now (then cbu_sent with CBU_WAIT_OPEN). */
+static inline int cbu_need(struct cbu_prov *p, const struct cbu_status *s, uint32_t now)
+{
+    if (p->pending && (int32_t)(now - p->deadline) >= 0) p->pending = 0;
+    if (s->slot || !s->present) { p->last = *s; p->have = 1; }
+    if (!s->present) {                                                  /* no card: a new card starts again */
+        p->tries = 0; p->done = 0; p->reopens = 0; p->session_ms = 0; p->ready = 0;
+        return 0;
+    }
+    if (s->gw_primary != CBU_NO_SESSION) {                              /* the session exists (the modem or the request made it) */
+        if (!p->session_ms) { p->session_ms = now ? now : 1u; p->polled_ms = now; }   /* first own card status 10 s later */
+        p->done = 1;
+        p->ready = s->app_state == CBU_APP_READY;
+        return 0;
+    }
+    p->done = 0; p->session_ms = 0; p->ready = 0;
+    return s->slot && !p->pending && p->tries < CBU_TRIES;
+}
+/* Periodic (bridge lock held): what the bridge should do for a session it opened whose application is not ready yet. */
+static inline int cbu_tick(struct cbu_prov *p, uint32_t now)
+{
+    if (p->pending && (int32_t)(now - p->deadline) >= 0) p->pending = 0;
+    if (p->pending || !p->have || !p->done || p->ready || !p->session_ms || !p->tries) return CBU_DO_NOTHING;
+    const uint32_t age = now - p->session_ms;
+    if (age >= CBU_STUCK_MS && p->last.app_state == CBU_APP_DETECTED && p->last.slot && p->reopens < CBU_REOPENS) return CBU_DO_CLOSE;
+    if (age < CBU_WATCH_MS && now - p->polled_ms >= CBU_POLL_MS) return CBU_DO_POLL;
+    return CBU_DO_NOTHING;
+}
+static inline uint32_t cbu_next_txn(struct cbu_prov *p)
+{
+    p->txn = (uint16_t)(p->txn + 1u);
+    return CBU_TXN_BASE + (p->txn & 0xffu);
+}
+static inline void cbu_sent(struct cbu_prov *p, uint32_t txn, uint32_t now, int what)
+{
+    if (what == CBU_WAIT_OPEN) p->tries++;
+    if (what == CBU_WAIT_CLOSE) p->reopens++;
+    if (what == CBU_WAIT_STATUS) p->polled_ms = now;
+    p->sent++; p->pending = (uint8_t)what; p->wait_txn = (uint16_t)txn; p->deadline = now + CBU_TIMEOUT_MS;
+}
+/* The modem's answer on the bridge's UIM client: the CBU_WAIT_ kind it answered (error in *error), 0 when it is not the bridge's.
+ * After a close the session counts as gone, so the caller can reopen it right away (cbu_need on the last status). */
+static inline int cbu_answer(struct cbu_prov *p, const uint8_t *sdu, uint32_t n, uint32_t *error)
+{
+    if (!p->pending || n < 7u || !cbd_sdu_ok(sdu, n) || sdu[0] != 2u || cbd_rd16(sdu + 1) != p->wait_txn) return 0;
+    const uint32_t message = cbd_rd16(sdu + 3);
+    if (message != (p->pending == CBU_WAIT_STATUS ? CBU_GET_CARD_STATUS : CBU_CHANGE_PROVISIONING)) return 0;
+    const int what = p->pending;
+    *error = cbd_error(sdu, n);
+    p->pending = 0; p->answered++; p->last_error = *error;
+    if (what == CBU_WAIT_CLOSE) {
+        p->done = 0; p->session_ms = 0; p->tries = 0;
+        p->last.gw_primary = CBU_NO_SESSION;
+    }
+    return what;
+}
+#endif
