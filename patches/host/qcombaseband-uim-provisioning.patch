+// guamp: UIM provisioning session (coachz_bb_uimprov.h). Every card status the modem gives CommCenter (and the bridge's own) is looked
+// at; with a card and no primary GW session the bridge asks the modem, on the eSIM code's UIM client, to open it for the card's USIM
+// (once per card, 3 tries), then follows the application until it is ready: its own Get Card Status every 10 s, and a close and
+// reopen of the session when the USIM is still "detected" 20 s later (twice at most).
+static struct cbu_prov bb_prov;
+static uint8_t bb_prov_req[96];
+static const char *const bb_prov_what[] = { "", "open", "close", "card status" };
+static int bb_uim_send(int what, const struct cbu_status *s)
+{
+  if (bb_esim.freeze || bb_esim.active >= 0 || bb_esim_slot < 0) return 0;
+  const struct cbq_server *server = cbq_server_find(&bb_qmux, CBE_SVC_UIM);
+  if (!server) return 0;
+  const uint32_t now = bb_now_ms(), txn = cbu_next_txn(&bb_prov);
+  const uint32_t len = what == CBU_WAIT_STATUS ? cbu_status_request(bb_prov_req, sizeof bb_prov_req, txn) :
+    cbu_request(bb_prov_req, sizeof bb_prov_req, txn, s, what == CBU_WAIT_OPEN);
+  if (!len) return 0;
+  const uint32_t queued = bb_tx_count;
+  bb_queue_tx(CBQ_PORT_BASE + (uint32_t)bb_esim_slot, server->node, server->port, bb_prov_req, len);
+  if (bb_tx_count == queued) return 0;
+  cbu_sent(&bb_prov, txn, now, what);
+  if (what != CBU_WAIT_STATUS)
+    printf("COACHZ baseband: UIM provisioning session %s asked for slot %u (%s, state %u), try %u, reopen %u\n", bb_prov_what[what], s->slot,
+           s->app_type == CBU_APP_USIM ? "USIM" : "SIM", s->app_state, bb_prov.tries, bb_prov.reopens);
+  return 1;
+}
+static void bb_uim_status(const char *source, const struct cbu_status &s)
+{
+  const uint32_t key = cbu_key(&s);
+  if (key != bb_prov.key && bb_prov.logged < 40) {
+    bb_prov.key = key;
+    bb_prov.logged++;
+    char tlvs[8 * 10 + 1];
+    uint32_t w = 0;
+    for (uint32_t i = 0; i < s.tlvs; i++) w += (uint32_t)snprintf(tlvs + w, sizeof tlvs - w, "%s%x/%u", i ? "," : "", s.tlv_type[i], s.tlv_len[i]);
+    tlvs[w < sizeof tlvs ? w : sizeof tlvs - 1] = 0;
+    printf("COACHZ baseband: UIM card status (%s, %u ms): primary GW session 0x%04x, %u cards, slot one card %u upin %u error %u apps %u, slot two card %u error %u apps %u; %s in slot %u state %u PIN1 %u perso %u feature %u retries %u; TLVs %s\n",
+           source, bb_now_ms(), s.gw_primary, s.cards, s.card_state[0], s.upin_state[0], s.card_error[0], s.card_apps[0], s.card_state[1],
+           s.card_error[1], s.card_apps[1], s.app_type == CBU_APP_USIM ? "USIM" : s.app_type == CBU_APP_SIM ? "SIM" : "no application", s.slot,
+           s.app_state, s.pin1_state, s.perso_state, s.perso_feature, s.perso_retries, tlvs);
+  }
+  if (cbu_need(&bb_prov, &s, bb_now_ms())) bb_uim_send(CBU_WAIT_OPEN, &s);
+}
+static void bb_uim_status_note(uint32_t service, const uint8_t *sdu, uint32_t n)
+{
+  struct cbu_status s;
+  if (service == CBU_SVC_UIM && cbu_parse(sdu, n, &s)) bb_uim_status(sdu[0] == 4u ? "indication" : "answer", s);
+}
+// The modem's answer to one of the bridge's own requests: 1 when it was one.
+static int bb_uim_answer(const uint8_t *sdu, uint32_t n)
+{
+  uint32_t error = 0;
+  const int what = cbu_answer(&bb_prov, sdu, n, &error);
+  if (!what) return 0;
+  if (what == CBU_WAIT_STATUS) {
+    struct cbu_status s;
+    if (!error && cbu_parse(sdu, n, &s)) bb_uim_status("bridge", s);
+    else printf("COACHZ baseband: UIM card status of the bridge: error 0x%x\n", error);
+    return 1;
+  }
+  printf("COACHZ baseband: UIM provisioning session %s answer: error 0x%x\n", bb_prov_what[what], error);
+  if (what == CBU_WAIT_CLOSE && cbu_need(&bb_prov, &bb_prov.last, bb_now_ms())) bb_uim_send(CBU_WAIT_OPEN, &bb_prov.last);
+  return 1;
+}
+// Periodic, from coachz_baseband_poll (bb_lock held).
+static void bb_uim_tick(void)
+{
+  const int action = cbu_tick(&bb_prov, bb_now_ms());
+  if (action == CBU_DO_POLL) bb_uim_send(CBU_WAIT_STATUS, &bb_prov.last);
+  else if (action == CBU_DO_CLOSE) bb_uim_send(CBU_WAIT_CLOSE, &bb_prov.last);
+}
+
