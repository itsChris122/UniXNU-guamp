+static void bb_nas_request_note(uint32_t service, const uint8_t *sdu, uint32_t n)
+{
+  if (!cbn_logged_request(service, sdu, n)) return;
+  char hex[3 * 40 + 1];
+  uint32_t w = 0;
+  const uint32_t len = cbd_rd16(sdu + 5);
+  for (uint32_t i = 0; i < len && i < 40 && 7u + i < n; i++) w += (uint32_t)snprintf(hex + w, sizeof hex - w, "%02x ", sdu[7 + i]);
+  hex[w ? w - 1 : 0] = 0;
+  printf("COACHZ baseband: CommCenter %s request TLVs (%u bytes, %u ms): %s\n",
+         service == CBN_SVC_NAS ? "NAS 0x33 system selection" : "DMS 0x2e operating mode", len, bb_now_ms(), hex);
