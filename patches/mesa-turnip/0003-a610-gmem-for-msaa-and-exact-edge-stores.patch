+extern "C" void tu_guamp_count_exact_store(void);
+
+/* guamp (UniXNU-guamp patches/mesa-turnip/0003): whether the fast tile store of a linear colour view, whose blocks are aligned up to
+ * gmem_align_w x gmem_align_h past x2/y2, writes past the end of a row (the row's blocks wider than its pitch) or past the memory the
+ * image is bound to. Turnip's own images are padded for it and never are; tiled and depth/stencil layouts are left as they are. */
+static bool
+tu_guamp_store_leaves_image(const struct tu_physical_device *phys_dev, const struct tu_image_view *iview, uint32_t x2, uint32_t y2)
+{
+   const struct tu_image *image = iview->image;
+   if (!image || (image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT) || !image->mem || !image->mem->bo)
+      return false;
+   if (vk_format_is_depth_or_stencil(image->vk.format) || image->layout[0].cpp == 0 ||
+       fdl_tile_mode(&image->layout[0], iview->vk.base_mip_level) != TILE6_LINEAR)
+      return false;
+   const uint64_t align_w = phys_dev->info->gmem_align_w, align_h = phys_dev->info->gmem_align_h;
+   const uint64_t pitch = iview->view.pitch;
+   const uint64_t row_bytes = align64(x2, align_w) * image->layout[0].cpp;
+   if (row_bytes > pitch)
+      return true;
+   const uint64_t rows = align64(y2, align_h);
+   const uint64_t layers = iview->vk.layer_count ? iview->vk.layer_count : 1;
+   const uint64_t end = iview->view.base_addr + (layers - 1) * (uint64_t) iview->view.layer_size + (rows - 1) * pitch + row_bytes;
+   const struct tu_bo *bo = image->mem->bo;
+   return rows == 0 || end > bo->iova + bo->size;
+}
+
 static bool
 tu_attachment_store_unaligned(struct tu_cmd_buffer *cmd, uint32_t a)
 {
@@ -6017,6 +6043,14 @@ tu_attachment_store_unaligned(struct tu_cmd_buffer *cmd, uint32_t a)
           y1 % phys_dev->info->gmem_align_h ||
           (y2 % phys_dev->info->gmem_align_h && need_y2_align))
          return true;
+
+      /* guamp 0003: an unaligned x2/y2 at the image's edge writes into "padding space", which Turnip's own layouts have and an image
+       * over a host import (an IOSurface, a no-copy buffer: the caller's pitch and size) may not: the fast store's whole
+       * gmem_align_w x gmem_align_h blocks would reach into the next row or past the memory. Such a store takes the exact path. */
+      if (tu_guamp_store_leaves_image(phys_dev, iview, x2, y2)) {
+         tu_guamp_count_exact_store();
+         return true;
+      }
    }
 
    return false;
