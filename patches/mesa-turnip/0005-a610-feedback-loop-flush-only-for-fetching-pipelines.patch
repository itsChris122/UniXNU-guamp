+/* guamp 0005: TU_GUAMP_FLOOP (default on): pipelines that read no input attachment drop the colour feedback loop of a subpass
+ * whose colour attachments are also its input attachments (tu_pipeline.cc), and a CCU clean + invalidate goes before the first
+ * draw of a pipeline that reads them after one that did not. 0/off = upstream rule (every pipeline of such a subpass flushed per
+ * overlap in sysmem). */
+extern "C" bool tu_guamp_floop_demote(void);
+extern "C" bool
+tu_guamp_floop_demote(void)
+{
+   static int on = -1;
+   int value = __atomic_load_n(&on, __ATOMIC_RELAXED);
+   if (value < 0) {
+      const char *text = getenv("TU_GUAMP_FLOOP");
+      value = !(text && (!strcmp(text, "0") || !strcmp(text, "off")));
+      __atomic_store_n(&on, value, __ATOMIC_RELAXED);
+   }
+   return value;
+}
+
 static enum tu_guamp_gmem_policy
