+/*
+ * guamp (06/11): one line for GuampMem (NativeEmmc GuampPerf.inc, every 30 s): processes and footprint per jetsam band, so a
+ * log shows whether launchd applied its jetsam properties (daemons in band 0/idle and 3..) or left them all at 180 (default).
+ * Up to 12 non-empty bands, lowest first.
+ */
+extern int filecache_thrashing_induced_jetsam;
+void guamp_memstat_band_report(char *buf, size_t len);
+
+void
+guamp_memstat_band_report(char *buf, size_t len)
+{
+	size_t used = 0;
+	unsigned int shown = 0, idle = 0, total = 0;
+	if (!buf || len == 0) {
+		return;
+	}
+	buf[0] = '\0';
+	proc_list_lock();
+	for (unsigned int band = 0; band < MEMSTAT_BUCKET_COUNT; band++) {
+		memstat_bucket_t *bucket = &memstat_bucket[band];
+		if (bucket->count == 0) {
+			continue;
+		}
+		total += bucket->count;
+		if (band == JETSAM_PRIORITY_IDLE) {
+			idle = bucket->count;
+		}
+		if (shown >= 12) {
+			continue;
+		}
+		uint64_t bytes = 0;
+		proc_t p;
+		TAILQ_FOREACH(p, &bucket->list, p_memstat_list) {
+			if (proc_task(p) != TASK_NULL) {
+				bytes += get_task_phys_footprint(proc_task(p));
+			}
+		}
+		int n = snprintf(buf + used, len - used, "%s%u:%u/%lluM", shown ? " " : "", band, bucket->count, bytes >> 20);
+		if (n < 0 || (size_t)n >= len - used) {
+			break;
+		}
+		used += (size_t)n;
+		shown++;
+	}
+	proc_list_unlock();
+	if (used < len) {
+		snprintf(buf + used, len - used, " (band:procs/footprint; %u procs, %u idle; fc-thrash kills %d)", total, idle,
+		    filecache_thrashing_induced_jetsam);
+	}
+}
