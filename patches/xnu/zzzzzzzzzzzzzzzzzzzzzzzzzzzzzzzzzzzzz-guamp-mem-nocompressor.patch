+/*
+ * guamp (zzz...-guamp-mem-nocompressor.patch, 06/11): without an active compressor (vm_compressor_mode 8 = freezer only, the
+ * owner's choice on guamp) the phantom cache was never allocated and compressor_needs_to_swap() never ran, so file cache
+ * thrashing was invisible to jetsam: fin50 kept 1.1 GiB of anonymous memory on the throttled queue, ~650 MiB of file cache that
+ * eMMC re-read 19k times per second, 308 processes and not one kill (available 669 MiB > pressure 459). Here vm_pageout_scan
+ * (one thread, no compressor thread racing it) evaluates the phantom cache and wakes the memorystatus thread, which kills in
+ * band order (idle daemons first) with cause fc-thrashing until the file cache stops thrashing. guamp-fc-thrash=0 turns it off.
+ */
+static int guamp_fc_thrash_enabled = -1;
+
+int
+guamp_filecache_thrash_enabled(void)
+{
+	if (guamp_fc_thrash_enabled < 0) {
+		unsigned int value = 1;
+		PE_parse_boot_argn("guamp-fc-thrash", &value, sizeof(value));
+		guamp_fc_thrash_enabled = value ? 1 : 0;
+	}
+	return guamp_fc_thrash_enabled;
+}
+
+void
+guamp_filecache_thrash_check(void)
+{
+	if (VM_CONFIG_COMPRESSOR_IS_ACTIVE || !guamp_filecache_thrash_enabled()) {
+		return;
+	}
+	if (vm_phantom_cache_check_pressure()) {
+		os_atomic_store(&memorystatus_phantom_cache_pressure, true, release);
+		if (vm_compressor_thrashing_detected == FALSE) {
+			vm_compressor_thrashing_detected = TRUE;
+			filecache_thrashing_induced_jetsam++;
+			memorystatus_thread_wake();
+		}
+	}
+}
