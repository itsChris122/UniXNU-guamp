+/*
+ * guamp (zzz...-guamp-mem-nocompressor.patch, 06/11): the three limits below are page counts tuned for 16 KiB pages. This kernel
+ * runs 4 KiB pages, so the free target was 2000 pages = 7.8 MiB, min 5.9 MiB and the privileged reserve 400 KiB (fin50: free 5 MiB
+ * for minutes, 1317 free pages, bursts of 8 MiB contiguous GPU requests). guamp-vm-free-scale=N multiplies the limits (default
+ * 16384 / PAGE_SIZE = 4: target 31 MiB, min 23 MiB, reserve 2 MiB (128 pages x 4, freezer compressor present), the same bytes as an
+ * iPhone); =1 gives back the stock values.
+ */
+static unsigned int guamp_vm_free_scale_value = 0;
+
+static unsigned int
+guamp_vm_free_scale(void)
+{
+	if (guamp_vm_free_scale_value == 0) {
+		unsigned int scale = PAGE_SIZE < 16384 ? (unsigned int)(16384 / PAGE_SIZE) : 1;
+		if (PE_parse_boot_argn("guamp-vm-free-scale", &scale, sizeof(scale)) && (scale == 0 || scale > 16)) {
+			scale = 1;
+		}
+		guamp_vm_free_scale_value = scale;
+		printf("guamp-vm-free-scale=%u (page %u bytes)\n", scale, (unsigned int)PAGE_SIZE);
+	}
+	return guamp_vm_free_scale_value;
+}
