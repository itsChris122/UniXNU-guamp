+static const char *const native_guamp_iphone_apps[] = {"Passbook.app"};
+int native_guamp_iphone_apps_copied, native_guamp_iphone_apps_error;
+static int
+native_guamp_install_iphone_apps(proc_t p, user_addr_t scratch, vfs_context_t ctx)
+{
+	static const char staged[] = "/private/var/staged_system_apps";
+	const uint32_t chunk = 1024 * 1024;
+	uint8_t *buffer = kalloc_data(chunk, Z_WAITOK);
+	char *path = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	int error = buffer && path ? native_staged_apps_mkdir(p, scratch, staged) : ENOMEM;
+	for (size_t i = 0; !error && i < sizeof(native_guamp_iphone_apps) / sizeof(native_guamp_iphone_apps[0]); i++) {
+		char source_path[128];
+		snprintf(source_path, sizeof(source_path), "/private/var/ngpu/iphone-apps/%s", native_guamp_iphone_apps[i]);
+		snprintf(path, MAXPATHLEN, "%s/%s", staged, native_guamp_iphone_apps[i]);
+		vnode_t source = NULLVP, vp = NULLVP;
+		if (!vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx)) {
+			vnode_put(vp);
+			printf("guamp-install-staged-apps: %s already staged\n", native_guamp_iphone_apps[i]);
+			continue;
+		}
+		int status = vnode_lookup(source_path, VNODE_LOOKUP_NOFOLLOW, &source, ctx);
+		if (!status && vnode_vtype(source) != VDIR) {
+			status = ENOTDIR;
+		}
+		if (!status) {
+			int failed = native_staged_apps_failed;
+			status = native_staged_apps_mkdir(p, scratch, path);
+			if (!status) {
+				native_staged_apps_walk(p, scratch, source, path, MAXPATHLEN, buffer, chunk, ctx);
+				status = native_staged_apps_failed != failed ? native_staged_apps_error : 0;
+			}
+		}
+		if (source != NULLVP) {
+			vnode_put(source);
+		}
+		if (!status) {
+			native_guamp_iphone_apps_copied++;
+		} else {
+			native_guamp_iphone_apps_error = status;
+		}
+		printf("guamp-install-staged-apps: %s from the addon: status %d (files %d, MiB %d)\n", native_guamp_iphone_apps[i], status,
+		    native_staged_apps_files, native_staged_apps_mib);
+	}
+	if (buffer) {
+		kfree_data(buffer, chunk);
+	}
+	if (path) {
+		kfree_data(path, MAXPATHLEN);
+	}
+	return error ? error : native_guamp_iphone_apps_error;
+}
