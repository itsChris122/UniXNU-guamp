diff -ru a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -5756,6 +5756,34 @@
 unsigned long cs_native4k_page_checks = 0;
 unsigned long cs_native4k_ready_blobs = 0;
 
+#if defined(XNU_GUAMP_CS_SEALED) && XNU_GUAMP_CS_SEALED
+extern int native_verified_block_root_authorized(dev_t);
+unsigned long cs_native4k_sealed_blobs = 0;
+
+/* The guamp system volumes (OS root, SystemOS cryptex) are read-only APFS volumes on NativeEmmc
+ * read-only ranges: APFS verifies every block it reads against the volume seal, so the code
+ * pages need no derived 4K digests and the whole-file read below is skipped for them.
+ */
+static boolean_t
+cs_native4k_sealed_volume(vnode_t vp)
+{
+	mount_t mp = vnode_mount(vp);
+	vnode_t devvp;
+	dev_t dev = NODEV;
+
+	if (mp == NULL || !(vfs_flags(mp) & MNT_RDONLY) ||
+	    strcmp(vfs_statfs(mp)->f_fstypename, "apfs") != 0) {
+		return FALSE;
+	}
+	devvp = vfs_devvp(mp);
+	if (devvp != NULLVP) {
+		dev = vnode_specrdev(devvp);
+		vnode_put(devvp);
+	}
+	return dev != NODEV && native_verified_block_root_authorized(dev);
+}
+#endif
+
 /* The original signed 16K hash authenticates the whole immutable input
  * buffer first. Only then derive native-page digests from that same buffer.
  * Publish nothing until every original block has passed, and make the
@@ -5792,6 +5820,14 @@
