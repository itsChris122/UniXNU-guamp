--- a/bsd/vfs/vfs_lookup.c
+++ b/bsd/vfs/vfs_lookup.c
@@ -2286,6 +2286,39 @@ guamp_path_probe_active(void)
 	}
 	return guamp_path_probe_used < limit;
 }
+static char guamp_path_probe_procs[96];
+static volatile SInt32 guamp_path_probe_procs_state = -1;
+static int
+guamp_path_probe_proc_match(void)
+{
+	if (guamp_path_probe_procs_state < 0) {
+		if (!PE_parse_boot_argn("guamp-path-probe-proc", guamp_path_probe_procs, sizeof(guamp_path_probe_procs) - 1)) {
+			guamp_path_probe_procs[0] = '\0';
+		}
+		guamp_path_probe_procs_state = guamp_path_probe_procs[0] && guamp_path_probe_procs[0] != '0' ? 1 : 0;
+	}
+	if (guamp_path_probe_procs_state == 0) {
+		return 0;
+	}
+	proc_t p = current_proc();
+	const char *name = p ? proc_best_name(p) : NULL;
+	if (name == NULL) {
+		return 0;
+	}
+	const char *at = guamp_path_probe_procs;
+	while (*at) {
+		const char *end = at;
+		while (*end && *end != ',') {
+			end++;
+		}
+		size_t len = (size_t)(end - at);
+		if (len && strncmp(name, at, len) == 0) {
+			return 1;
+		}
+		at = *end ? end + 1 : end;
+	}
+	return 0;
+}
 int
 guamp_path_probe_copy(user_addr_t path, enum uio_seg seg, char *buf, size_t size)
