--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7901,6 +7901,336 @@
 	    native_gpu_addon_files, native_gpu_addon_written, native_gpu_addon_same, native_gpu_addon_failed, native_gpu_addon_error,
 	    point, native_guamp_audio_plugin_stage, native_guamp_audio_plugin_status);
