+void
+guamp_ram_mapping_diag(uint64_t par, uint64_t *out)
+{
+    pmap_paddr_t pa = par & 0x000ffffffffff000ULL;
+    unsigned int native = pmap_cache_attributes((ppnum_t)atop(pa));
