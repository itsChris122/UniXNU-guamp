diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 7d13dba..6276634 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8619,6 +8619,550 @@ native_guamp_ls_auto_delete(proc_t p, user_addr_t scratch, uint32_t *deleted)
 	}
 	return error;
 }
+/* guamp-ls-auto=3 (owner 30/10, default): the apps of the /Applications view (Phone, Wallet, Watch) must be in the LaunchServices
+ * databases lsd loads, without paying lsd's full rebuild (~110 s of one core, boot 212 s instead of ~110 s) at every boot.
+ * Before launchd, each csstore of lsd's InternalDaemon containers ({,SystemDataOnly-}com.apple.LaunchServices-*.csstore) is read
+ * and checked for the string-table entry of every bundle in /private/var/ngpu/iphone-res/Applications (32-bit little-endian
+ * length, then "/Applications/<name>.app/": the form lsd stores bundle paths in; checked on the 28/10 and 29/10 stores, where
+ * MobileSafari has it and Phone/Wallet/Watch, never registered, do not). Then:
+ *  - every store has every app: the stores are kept (no rebuild) and a store that differs from its copy in
+ *    /private/var/db/guamp-ls-good/ is copied there ("good copy");
+ *  - a store misses an app and every such store has a good copy of the same container and size: the good copies are written over
+ *    them ("restored", lsd not running yet), unless the previous boot already restored (then a restore does not hold: rebuild);
+ *  - otherwise, or on any read/write error: the stores are deleted as with guamp-ls-auto=2 (full rebuild, the safe old path).
+ * A changed key (view fsid or addon apps) still rebuilds. The state of the last decision is in /private/var/db/guamp-ls-auto.state.
+ * A kernel thread then watches the stores for 20 min (every 15 s, stops at shutdown): a store whose size and date stayed the same
+ * for one period is checked again (log line "guamp-ls-auto: watch") and copied as good copy when it has every app, so the stores
+ * lsd writes after a rebuild are kept even if a later save loses the apps. Never panics. */
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#define NATIVE_GUAMP_LSV_APPS 16
+#define NATIVE_GUAMP_LSV_STORES 8
+#define NATIVE_GUAMP_LSV_CHUNK (256 * 1024)
+#define NATIVE_GUAMP_LSV_KEEP 256
+struct native_guamp_lsv_apps {
+	uint32_t count;
+	uint32_t length[NATIVE_GUAMP_LSV_APPS];
+	char path[NATIVE_GUAMP_LSV_APPS][96];
+};
+struct native_guamp_lsv_stores {
+	uint32_t count;
+	char container[NATIVE_GUAMP_LSV_STORES][64];
+	char name[NATIVE_GUAMP_LSV_STORES][64];
+};
+static const char native_guamp_lsv_base[] = "/private/var/mobile/Containers/Data/InternalDaemon";
+static const char native_guamp_lsv_good[] = "/private/var/db/guamp-ls-good";
+static const char native_guamp_lsv_state[] = "/private/var/db/guamp-ls-auto.state";
+uint32_t native_guamp_lsv_apps_found, native_guamp_lsv_restored, native_guamp_lsv_saved, native_guamp_lsv_watch_saved;
+int native_guamp_lsv_decision = -1;	/* 0 kept, 1 restored, 2 rebuild, 3 no store, 4 nothing to check */
+static int native_guamp_lsv_sleep_channel;
+static uint64_t
+native_guamp_lsv_ms(uint64_t start)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	return ns / 1000000;
+}
+static off_t
+native_guamp_lsv_number(const char *text)
+{
+	off_t value = 0;
+	for (; *text >= '0' && *text <= '9' && value < ((off_t)1 << 40); text++) {
+		value = value * 10 + (*text - '0');
+	}
+	return value;
+}
+static int
+native_guamp_lsv_app_list(struct native_guamp_lsv_apps *apps)
+{
+	char (*names)[64] = kalloc_data(NATIVE_GUAMP_LS_MAX * 64, Z_WAITOK | Z_ZERO);
+	uint32_t n = 0;
+	int error = names ? native_guamp_dir_names("/private/var/ngpu/iphone-res/Applications", DT_DIR, names, NATIVE_GUAMP_LS_MAX, &n) :
+	    ENOMEM;
+	apps->count = 0;
+	for (uint32_t i = 0; !error && i < n && apps->count < NATIVE_GUAMP_LSV_APPS; i++) {
+		size_t length = strlen(names[i]);
+		if (length < 5 || strcmp(names[i] + length - 4, ".app")) {
+			continue;
+		}
+		int written = snprintf(apps->path[apps->count], sizeof(apps->path[0]), "/Applications/%s/", names[i]);
+		if (written > 0 && (size_t)written < sizeof(apps->path[0])) {
+			apps->length[apps->count] = (uint32_t)written;
+			apps->count = apps->count + 1;
+		}
+	}
+	if (names) {
+		kfree_data(names, NATIVE_GUAMP_LS_MAX * 64);
+	}
+	return error;
+}
+static int
+native_guamp_lsv_store_list(struct native_guamp_lsv_stores *stores)
+{
+	char (*containers)[64] = kalloc_data(NATIVE_GUAMP_LS_MAX * 64, Z_WAITOK | Z_ZERO);
+	char (*files)[64] = kalloc_data(NATIVE_GUAMP_LS_MAX * 64, Z_WAITOK | Z_ZERO);
+	char *path = kalloc_data(256, Z_WAITOK | Z_ZERO);
+	uint32_t n_containers = 0;
+	int error = containers && files && path ? 0 : ENOMEM;
+	stores->count = 0;
+	if (!error) {
+		error = native_guamp_dir_names(native_guamp_lsv_base, DT_DIR, containers, NATIVE_GUAMP_LS_MAX, &n_containers);
+		if (error == ENOENT) {
+			error = 0;
+		}
+	}
+	for (uint32_t c = 0; !error && c < n_containers; c++) {
+		uint32_t n_files = 0;
+		snprintf(path, 256, "%s/%s/Library/Caches", native_guamp_lsv_base, containers[c]);
+		if (native_guamp_dir_names(path, DT_REG, files, NATIVE_GUAMP_LS_MAX, &n_files)) {
+			continue;
+		}
+		for (uint32_t f = 0; f < n_files && stores->count < NATIVE_GUAMP_LSV_STORES; f++) {
+			if (native_guamp_ls_store_match(files[f])) {
+				strlcpy(stores->container[stores->count], containers[c], sizeof(stores->container[0]));
+				strlcpy(stores->name[stores->count], files[f], sizeof(stores->name[0]));
+				stores->count = stores->count + 1;
+			}
+		}
+	}
+	if (containers) {
+		kfree_data(containers, NATIVE_GUAMP_LS_MAX * 64);
+	}
+	if (files) {
+		kfree_data(files, NATIVE_GUAMP_LS_MAX * 64);
+	}
+	if (path) {
+		kfree_data(path, 256);
+	}
+	return error;
+}
+static uint32_t
+native_guamp_lsv_match(const uint8_t *buffer, size_t size, const struct native_guamp_lsv_apps *apps)
+{
+	static const char prefix[] = "/Applications/";
+	uint32_t mask = 0;
+	for (size_t i = 4; i + sizeof(prefix) - 1 <= size; i++) {
+		if (buffer[i] != '/' || memcmp(buffer + i, prefix, sizeof(prefix) - 1)) {
+			continue;
+		}
+		uint32_t length = 0;
+		memcpy(&length, buffer + i - 4, 4);
+		for (uint32_t a = 0; a < apps->count; a++) {
+			if (length == apps->length[a] && i + length <= size && !memcmp(buffer + i, apps->path[a], length)) {
+				mask |= 1U << a;
+			}
+		}
+	}
+	return mask;
+}
+/* Mask of the apps whose path entry is in the store; EFTYPE when the file is not a csstore ("bdsl"). */
+static int
+native_guamp_lsv_scan(const char *path, const struct native_guamp_lsv_apps *apps, vfs_context_t ctx, uint32_t *mask, off_t *size)
+{
+	vnode_t vp = NULLVP;
+	*mask = 0;
+	*size = 0;
+	int error = vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	uint8_t *buffer = kalloc_data(NATIVE_GUAMP_LSV_CHUNK + NATIVE_GUAMP_LSV_KEEP, Z_WAITOK);
+	error = buffer ? 0 : ENOMEM;
+	if (!error && vnode_vtype(vp) != VREG) {
+		error = EFTYPE;
+	}
+	if (!error) {
+		error = vnode_size(vp, size, ctx);
+	}
+	off_t at = 0;
+	size_t kept = 0;
+	while (!error && at < *size) {
+		int want = (int)MIN((off_t)NATIVE_GUAMP_LSV_CHUNK, *size - at), resid = 0;
+		error = vn_rdwr(UIO_READ, vp, (caddr_t)(buffer + kept), want, at, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx));
+		size_t got = (size_t)(want - resid);
+		if (!error && !got) {
+			error = EIO;
+		}
+		if (!error && !at && (got < 4 || memcmp(buffer, "bdsl", 4))) {
+			error = EFTYPE;
+		}
+		if (error) {
+			break;
+		}
+		size_t total = kept + got;
+		*mask |= native_guamp_lsv_match(buffer, total, apps);
+		at += (off_t)got;
+		kept = MIN(total, (size_t)NATIVE_GUAMP_LSV_KEEP);
+		memmove(buffer, buffer + total - kept, kept);
+	}
+	if (buffer) {
+		kfree_data(buffer, NATIVE_GUAMP_LSV_CHUNK + NATIVE_GUAMP_LSV_KEEP);
+	}
+	vnode_close(vp, FREAD, ctx);
+	return error;
+}
+/* Copies from over to; to is created (0600) only with create, otherwise it must exist (its owner and mode stay). */
+static int
+native_guamp_lsv_copy(const char *from, const char *to, int create, vfs_context_t ctx, off_t *copied)
+{
+	vnode_t in = NULLVP, out = NULLVP;
+	off_t size = 0, at = 0;
+	*copied = 0;
+	int error = vnode_open(from, FREAD | O_NOFOLLOW, 0, 0, &in, ctx);
+	if (error) {
+		return error;
+	}
+	uint8_t *buffer = kalloc_data(NATIVE_GUAMP_LSV_CHUNK, Z_WAITOK);
+	error = buffer ? vnode_size(in, &size, ctx) : ENOMEM;
+	if (!error) {
+		error = vnode_open(to, (create ? O_CREAT : 0) | O_TRUNC | FWRITE | O_NOFOLLOW, 0600, 0, &out, ctx);
+	}
+	while (!error && at < size) {
+		int want = (int)MIN((off_t)NATIVE_GUAMP_LSV_CHUNK, size - at), resid = 0;
+		error = vn_rdwr(UIO_READ, in, (caddr_t)buffer, want, at, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;	/* the source shrank while being copied */
+		}
+		if (!error) {
+			error = vn_rdwr(UIO_WRITE, out, (caddr_t)buffer, want, at, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT, vfs_context_ucred(ctx),
+			    &resid, vfs_context_proc(ctx));
+		}
+		if (!error && resid) {
+			error = EIO;
+		}
+		at += want;
+	}
+	if (!error && out != NULLVP) {
+		error = VNOP_FSYNC(out, MNT_WAIT, ctx);
+	}
+	if (out != NULLVP) {
+		int close_error = vnode_close(out, FWRITE, ctx);
+		error = error ? error : close_error;
+	}
+	if (buffer) {
+		kfree_data(buffer, NATIVE_GUAMP_LSV_CHUNK);
+	}
+	vnode_close(in, FREAD, ctx);
+	*copied = error ? 0 : size;
+	return error;
+}
+static void
+native_guamp_lsv_read_small(const char *path, char *text, size_t size, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	memset(text, 0, size);
+	if (!vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx)) {
+		int resid = 0;
+		if (vn_rdwr(UIO_READ, vp, (caddr_t)text, (int)size - 1, 0, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid,
+		    vfs_context_proc(ctx))) {
+			memset(text, 0, size);
+		}
+		vnode_close(vp, FREAD, ctx);
+	}
+}
+static int
+native_guamp_lsv_write_small(const char *path, const char *text, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, 0600, 0, &vp, ctx);
+	if (!error) {
+		int resid = 0;
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)text, (int)strlen(text), 0, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;
+		}
+		if (!error) {
+			error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		}
+		int close_error = vnode_close(vp, FWRITE, ctx);
+		error = error ? error : close_error;
+	}
+	return error;
+}
+/* The good copy of a store: <good>/<name> and <good>/<name>.info = "<size> <container>\n" (written after the copy). */
+static int
+native_guamp_lsv_save_good(const char *container, const char *name, off_t size, vfs_context_t ctx, const char *why)
+{
+	char *path = kalloc_data(256, Z_WAITOK | Z_ZERO), *good = kalloc_data(256, Z_WAITOK | Z_ZERO);
+	char info[96], old_info[96];
+	off_t copied = 0;
+	int error = path && good ? 0 : ENOMEM;
+	if (!error) {
+		snprintf(path, 256, "%s/%s/Library/Caches/%s", native_guamp_lsv_base, container, name);
+		snprintf(good, 256, "%s/%s.info", native_guamp_lsv_good, name);
+		snprintf(info, sizeof(info), "%lld %s\n", (long long)size, container);
+		native_guamp_lsv_read_small(good, old_info, sizeof(old_info), ctx);
+		if (!strcmp(info, old_info)) {
+			goto out;	/* same container and size: already saved */
+		}
+		uint64_t start = mach_absolute_time();
+		snprintf(good, 256, "%s/%s", native_guamp_lsv_good, name);
+		error = native_guamp_lsv_copy(path, good, 1, ctx, &copied);
+		if (!error && copied != size) {
+			error = EAGAIN;	/* lsd changed it meanwhile: the next check saves it */
+		}
+		snprintf(good, 256, "%s/%s.info", native_guamp_lsv_good, name);
+		if (!error) {
+			error = native_guamp_lsv_write_small(good, info, ctx);
+		}
+		printf("guamp-ls-auto: good copy of %s/%s (%s): %lld bytes in %llu ms, status %d\n", container, name, why, (long long)copied,
+		    (unsigned long long)native_guamp_lsv_ms(start), error);
+		if (!error) {
+			native_guamp_lsv_saved = native_guamp_lsv_saved + 1;
+		}
+	}
+out:
+	if (path) {
+		kfree_data(path, 256);
+	}
+	if (good) {
+		kfree_data(good, 256);
+	}
+	return error;
+}
+/* Writes the good copy over a store that lost apps, if it is of the same container, complete and has every app. */
+static int
+native_guamp_lsv_restore(const char *container, const char *name, const struct native_guamp_lsv_apps *apps, vfs_context_t ctx)
+{
+	char *path = kalloc_data(256, Z_WAITOK | Z_ZERO), *good = kalloc_data(256, Z_WAITOK | Z_ZERO);
+	char info[96], *space = NULL;
+	off_t size = 0, copied = 0;
+	uint32_t mask = 0;
+	int error = path && good ? 0 : ENOMEM;
+	if (!error) {
+		snprintf(good, 256, "%s/%s.info", native_guamp_lsv_good, name);
+		native_guamp_lsv_read_small(good, info, sizeof(info), ctx);
+		space = strchr(info, ' ');
+		if (!space || strncmp(space + 1, container, strlen(container)) || space[1 + strlen(container)] != '\n') {
+			error = ENOENT;	/* no good copy of this container */
+		}
+	}
+	if (!error) {
+		snprintf(good, 256, "%s/%s", native_guamp_lsv_good, name);
+		error = native_guamp_lsv_scan(good, apps, ctx, &mask, &size);
+		if (!error && (mask != (1U << apps->count) - 1 || size != native_guamp_lsv_number(info))) {
+			error = EFTYPE;
+		}
+	}
+	if (!error) {
+		uint64_t start = mach_absolute_time();
+		snprintf(path, 256, "%s/%s/Library/Caches/%s", native_guamp_lsv_base, container, name);
+		error = native_guamp_lsv_copy(good, path, 0, ctx, &copied);
+		printf("guamp-ls-auto: restored %s/%s from its good copy: %lld bytes in %llu ms, status %d\n", container, name,
+		    (long long)copied, (unsigned long long)native_guamp_lsv_ms(start), error);
+	} else {
+		printf("guamp-ls-auto: no usable good copy of %s/%s (status %d)\n", container, name, error);
+	}
+	if (path) {
+		kfree_data(path, 256);
+	}
+	if (good) {
+		kfree_data(good, 256);
+	}
+	return error;
+}
+/* Mode 3 before launchd: returns 1 when the stores must be deleted (full rebuild), 0 to keep them. */
+static int
+native_guamp_lsv_decide(proc_t p, user_addr_t scratch)
+{
+	vfs_context_t ctx = vfs_context_current();
+	struct native_guamp_lsv_apps *apps = kalloc_data(sizeof(*apps), Z_WAITOK | Z_ZERO);
+	struct native_guamp_lsv_stores *stores = kalloc_data(sizeof(*stores), Z_WAITOK | Z_ZERO);
+	char *path = kalloc_data(256, Z_WAITOK | Z_ZERO);
+	char state[32], next[32];
+	uint32_t bad = 0, good_missing = 0, store_mask[NATIVE_GUAMP_LSV_STORES];
+	off_t store_size[NATIVE_GUAMP_LSV_STORES];
+	int rebuild = 1, error = apps && stores && path ? 0 : ENOMEM;
+	uint64_t start = mach_absolute_time();
+	native_guamp_lsv_read_small(native_guamp_lsv_state, state, sizeof(state), ctx);
+	strlcpy(next, "rebuilt\n", sizeof(next));
+	if (!error) {
+		(void)native_guamp_mkdir(p, scratch, "/private/var/db");
+		(void)native_guamp_mkdir(p, scratch, native_guamp_lsv_good);
+		error = native_guamp_lsv_app_list(apps);
+	}
+	if (!error && !apps->count) {
+		native_guamp_lsv_decision = 4;
+		rebuild = 0;
+		strlcpy(next, "noapps\n", sizeof(next));
+		goto out;
+	}
+	if (!error) {
+		error = native_guamp_lsv_store_list(stores);
+	}
+	if (!error && !stores->count) {
+		native_guamp_lsv_decision = 3;	/* lsd seeds a new database anyway */
+		rebuild = 0;
+		strlcpy(next, "fresh\n", sizeof(next));
+		goto out;
+	}
+	for (uint32_t s = 0; !error && s < stores->count; s++) {
+		snprintf(path, 256, "%s/%s/Library/Caches/%s", native_guamp_lsv_base, stores->container[s], stores->name[s]);
+		error = native_guamp_lsv_scan(path, apps, ctx, &store_mask[s], &store_size[s]);
+		printf("guamp-ls-auto: check %s/%s: %lld bytes, apps mask %x of %x, status %d\n", stores->container[s], stores->name[s],
+		    (long long)store_size[s], store_mask[s], (1U << apps->count) - 1, error);
+		if (!error && store_mask[s] != (1U << apps->count) - 1) {
+			bad |= 1U << s;
+		}
+	}
+	native_guamp_lsv_apps_found = apps->count;
+	if (error) {
+		goto out;	/* unreadable store: full rebuild */
+	}
+	if (!bad) {
+		rebuild = 0;
+		native_guamp_lsv_decision = 0;
+		strlcpy(next, "kept\n", sizeof(next));
+		for (uint32_t s = 0; s < stores->count; s++) {
+			(void)native_guamp_lsv_save_good(stores->container[s], stores->name[s], store_size[s], ctx, "boot");
+		}
+		goto out;
+	}
+	if (!strcmp(state, "restored\n") || !strcmp(state, "norestore\n")) {
+		strlcpy(next, "norestore\n", sizeof(next));	/* the restore of the previous boot did not hold */
+		printf("guamp-ls-auto: stores lost apps again after a restore (state %s): full rebuild\n", state[0] == 'r' ? "restored" :
+		    "norestore");
+		goto out;
+	}
+	for (uint32_t s = 0; s < stores->count; s++) {
+		if ((bad & (1U << s)) && native_guamp_lsv_restore(stores->container[s], stores->name[s], apps, ctx)) {
+			good_missing++;
+		}
+	}
+	if (!good_missing) {
+		rebuild = 0;
+		native_guamp_lsv_decision = 1;
+		native_guamp_lsv_restored = (uint32_t)__builtin_popcount(bad);
+		strlcpy(next, "restored\n", sizeof(next));
+	}
+out:
+	if (rebuild) {
+		native_guamp_lsv_decision = 2;
+	}
+	(void)native_guamp_lsv_write_small(native_guamp_lsv_state, next, ctx);
+	printf("guamp-ls-auto: verify %u apps, %u stores, bad mask %x, decision %d (%s), %llu ms, status %d\n", apps ? apps->count : 0,
+	    stores ? stores->count : 0, bad, native_guamp_lsv_decision,
+	    native_guamp_lsv_decision == 0 ? "kept" : native_guamp_lsv_decision == 1 ? "restored" : native_guamp_lsv_decision == 3 ?
+	    "no store, lsd seeds" : native_guamp_lsv_decision == 4 ? "no view apps" : "full rebuild", (unsigned long long)native_guamp_lsv_ms(start), error);
+	if (apps) {
+		kfree_data(apps, sizeof(*apps));
+	}
+	if (stores) {
+		kfree_data(stores, sizeof(*stores));
+	}
+	if (path) {
+		kfree_data(path, 256);
+	}
+	return rebuild;
+}
+/* The watch thread: 80 periods of 15 s; a store is checked once its size and date stay the same for a period. */
+static void
+native_guamp_lsv_watch(void *arg __unused, wait_result_t wait __unused)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct native_guamp_lsv_apps *apps = kalloc_data(sizeof(*apps), Z_WAITOK | Z_ZERO);
+	struct native_guamp_lsv_stores *stores = kalloc_data(sizeof(*stores), Z_WAITOK | Z_ZERO);
+	char *path = kalloc_data(256, Z_WAITOK | Z_ZERO);
+	char (*seen_name)[64] = kalloc_data(NATIVE_GUAMP_LSV_STORES * 64, Z_WAITOK | Z_ZERO);
+	off_t seen_size[NATIVE_GUAMP_LSV_STORES];
+	int64_t seen_time[NATIVE_GUAMP_LSV_STORES];
+	int seen_done[NATIVE_GUAMP_LSV_STORES];
+	if (!apps || !stores || !path || !seen_name || native_guamp_lsv_app_list(apps) || !apps->count) {
+		goto out;
+	}
+	memset(seen_size, 0, sizeof(seen_size));
+	memset(seen_time, 0, sizeof(seen_time));
+	memset(seen_done, 0, sizeof(seen_done));
+	for (int period = 0; period < 80; period++) {
+		(void)tsleep(&native_guamp_lsv_sleep_channel, PRIBIO, "guamp-ls-watch", 15 * hz);
+		if (get_system_inshutdown()) {
+			break;
+		}
+		if (native_guamp_lsv_store_list(stores)) {
+			continue;
+		}
+		for (uint32_t s = 0; s < stores->count && !get_system_inshutdown(); s++) {
+			snprintf(path, 256, "%s/%s/Library/Caches/%s", native_guamp_lsv_base, stores->container[s], stores->name[s]);
+			struct vnode_attr va;
+			vnode_t vp = NULLVP;
+			VATTR_INIT(&va);
+			VATTR_WANTED(&va, va_data_size);
+			VATTR_WANTED(&va, va_modify_time);
+			if (vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx)) {
+				continue;
+			}
+			int attr_error = vnode_getattr(vp, &va, ctx);
+			vnode_put(vp);
+			if (attr_error) {
+				continue;
+			}
+			uint32_t slot = NATIVE_GUAMP_LSV_STORES;
+			for (uint32_t k = 0; k < NATIVE_GUAMP_LSV_STORES; k++) {
+				if (!strcmp(seen_name[k], stores->name[s])) {
+					slot = k;
+					break;
+				}
+				if (slot == NATIVE_GUAMP_LSV_STORES && !seen_name[k][0]) {
+					slot = k;
+				}
+			}
+			if (slot == NATIVE_GUAMP_LSV_STORES) {
+				continue;
+			}
+			if (strcmp(seen_name[slot], stores->name[s]) || seen_size[slot] != (off_t)va.va_data_size ||
+			    seen_time[slot] != (int64_t)va.va_modify_time.tv_sec) {
+				strlcpy(seen_name[slot], stores->name[s], sizeof(seen_name[0]));
+				seen_size[slot] = (off_t)va.va_data_size;
+				seen_time[slot] = (int64_t)va.va_modify_time.tv_sec;
+				seen_done[slot] = 0;
+				continue;	/* changed: checked when it stays the same for a period */
+			}
+			if (seen_done[slot]) {
+				continue;
+			}
+			seen_done[slot] = 1;
+			uint32_t mask = 0;
+			off_t size = 0;
+			int error = native_guamp_lsv_scan(path, apps, ctx, &mask, &size);
+			printf("guamp-ls-auto: watch %u s: %s/%s %lld bytes, apps mask %x of %x, status %d\n", (period + 1) * 15,
+			    stores->container[s], stores->name[s], (long long)size, mask, (1U << apps->count) - 1, error);
+			if (!error && mask == (1U << apps->count) - 1 && size == seen_size[slot] &&
+			    !native_guamp_lsv_save_good(stores->container[s], stores->name[s], size, ctx, "watch")) {
+				native_guamp_lsv_watch_saved = native_guamp_lsv_watch_saved + 1;
+			} else if (!error && size == seen_size[slot] && mask != (1U << apps->count) - 1) {
+				seen_done[slot] = 1;
+			} else {
+				seen_done[slot] = 0;	/* changed during the check: again next period */
+			}
+		}
+	}
+out:
+	if (apps) {
+		kfree_data(apps, sizeof(*apps));
+	}
+	if (stores) {
+		kfree_data(stores, sizeof(*stores));
+	}
+	if (path) {
+		kfree_data(path, 256);
+	}
+	if (seen_name) {
+		kfree_data(seen_name, NATIVE_GUAMP_LSV_STORES * 64);
+	}
+}
+static void
+native_guamp_lsv_watch_start(void)
+{
+	thread_t thread = THREAD_NULL;
+	if (kernel_thread_start(native_guamp_lsv_watch, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("guamp-ls-auto: watch thread not started\n");
+	}
+}
