 }
 
+static bool native_sandbox_grant(IOService * service);
+/*
+ * The grant of a service (native_sandbox_grant: its NativeSandboxGrantProcess list) also covers reading that service's own "Native*" properties,
+ * the board's configuration for its Metal plugin (NativeTurnipDebug, NativeTurnipTrace, NativeMetalWithhold): app and extension profiles
+ * refuse them (PosterBoard, poster extensions, WidgetRenderer_Default), and the A610 then lost "noconform" and got no device. Other names,
+ * other services and processes not on the list keep the sandbox's verdict.
+ */
+static bool
+native_sandbox_get_grant(IORegistryEntry * entry, const char * name)
+{
+	IOService * service = OSDynamicCast(IOService, entry);
+	return service && name && 0 == strncmp(name, "Native", 6) && native_sandbox_grant(service);
+}
