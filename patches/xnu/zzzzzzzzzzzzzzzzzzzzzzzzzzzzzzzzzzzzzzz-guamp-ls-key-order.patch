+/*
+ * guamp 06/11 (fin50/fin51: ls-auto rebuilt 1 at every boot, ~90-180 s of black screen after the logo, lsd 85 % of a core):
+ * the hash was taken over the addon entries in file order, and the composer wrote the same 186 /Applications entries in
+ * another order (resa40-delta unsorted, resa41-delta sorted), so the same apps gave another key and a full LaunchServices
+ * rebuild. The key hash is now order-independent: the sum of the FNV-1a of each entry (header, name, compressed bytes),
+ * mixed with the entry count. The old order-dependent hash is kept in native_guamp_ls_auto_legacy_hash: a key file
+ * written by an older kernel that matches it counts as unchanged (no rebuild for the switch) and is rewritten in the new form.
+ */
+static uint64_t native_guamp_ls_auto_legacy_hash;
 static uint64_t
 native_guamp_ls_auto_apps_hash(uint32_t *entries)
 {
 	static const char prefix[] = "iphone-res/Applications/";
 	const uint8_t *addon = NULL;
-	uint64_t bytes = 0, hash = 0xcbf29ce484222325ULL, at = 24;
+	uint64_t bytes = 0, hash = 0xcbf29ce484222325ULL, at = 24, set = 0;
 	uint32_t count = 0;
 	*entries = 0;
+	native_guamp_ls_auto_legacy_hash = 0;
 	if (!native_ram_block_gpu_addon || !native_ram_block_gpu_addon(&addon, &bytes) || bytes < 24 || memcmp(addon, "NGPUADD2", 8)) {
 		return 0;
 	}
@@ -8825,11 +8835,18 @@ native_guamp_ls_auto_apps_hash(uint32_t *entries)
 		if (name_bytes > sizeof(prefix) && !strncmp(name, prefix, sizeof(prefix) - 1)) {
 			hash = native_guamp_ls_auto_fnv(hash, addon + at, 24 + (uint64_t)name_bytes);
 			hash = native_guamp_ls_auto_fnv(hash, addon + at + 24 + name_padded, packed);
+			uint64_t one = native_guamp_ls_auto_fnv(0xcbf29ce484222325ULL, addon + at, 24 + (uint64_t)name_bytes);
+			set += native_guamp_ls_auto_fnv(one, addon + at + 24 + name_padded, packed);
 			*entries = *entries + 1;
 		}
 		at += 24 + name_padded + packed_padded;
 	}
-	return *entries ? hash : 0;
+	if (!*entries) {
+		return 0;
