--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7510,8 +7510,13 @@ native_gpu_addon_install(proc_t p, user_addr_t scratch)
  * iPhone device class it logs "no apple logo found" and draws the bar alone in the middle of the screen. The iPhone XS 17.7 files
  * apple-logo@2x~iphone.png and apple-logo-black@2x~iphone.png (iphone-res/ProgressUI.framework, local files) restore the logo above
  * the bar, the same artwork and size as the kernel's boot logo (/chosen/guamp-logo). */
-volatile int native_guamp_iphone_res_stage[7] = {0, 0, 0, 0, 0, 0, 0};
-volatile int native_guamp_iphone_res_status[7] = {-1, -1, -1, -1, -1, -1, -1};
+/* The eighth view (owner 29/10, Phone from the iPhone XS 17.7) adds iPhone-only built-in apps to /Applications
+ * (iphone-res/Applications/<App>.app, local files: MobilePhone.app converted to arm64 and signed ad hoc, its CDHashes in the owner
+ * trust module). On the iPhone they live on the system volume, not among the staged deletable apps, so no migration installs them:
+ * LaunchServices registers them as system apps when it seeds its database (guamp-ls-rebuild=N in the same boot).
+ * guamp-iphone-applications=0 skips this view. */
+volatile int native_guamp_iphone_res_stage[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+volatile int native_guamp_iphone_res_status[8] = {-1, -1, -1, -1, -1, -1, -1, -1};
