+/* guamp-bt-tool=1 (with guamp-iphone-res=1, after its views): BlueTool's override scripts for the Bluetooth shim. BlueTool runs
+ * /etc/bluetool/<HWModel>.<script>.script in place of its built-in Broadcom sequence when that file exists (strings "HW Model there
+ * is override script file %s", "/etc/bluetool/%s.%s.script"); this iPadOS has no /private/etc/bluetool. The kernel writes reduced
+ * boot/init/deepsleep scripts (no firmware download "bcm -W", no calibration "bcm -Q"; the WCN3950 is brought up by the kernel's
+ * Bluetooth driver and the shim answers the Broadcom vendor commands) to Data's /private/var/ngpu/etc/bluetool, then shows that
+ * directory over the sealed /private/etc with the same read-only union bindfs view as the iPhone resources: /private/etc keeps every
+ * sealed name, only the new name bluetool comes from Data. HWModel is MobileGestalt's HWModelStr, the root compatible string
+ * (hw.model, "motorola,guamp" on this ADT); D22AP (target-type D22) and J120AP are written too. Never panics: failures are only
+ * logged (stage 5 = mounted, /private/etc/hosts and a script both visible). */
+static int native_guamp_write_file(proc_t p, user_addr_t scratch, const char *path, const uint8_t *data, size_t size, uid_t owner,
+    int mode, int overwrite);
+volatile int native_guamp_bt_tool_stage = 0;
+volatile int native_guamp_bt_tool_status = -1;
+volatile int native_guamp_bt_tool_written = 0;
+static void
+native_guamp_bt_tool(proc_t p, user_addr_t scratch)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("guamp-bt-tool", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	static const char *const directories[] = {"/private/var/ngpu/etc", "/private/var/ngpu/etc/bluetool"};
+	static const char *const models[] = {"motorola,guamp", "D22AP", "J120AP"};
+	static const char *const scripts[] = {"boot", "init", "deepsleep"};
+	static const char bt_boot[] = "wake on\nmsleep 100\nhci reset\nbcm -A\ndevice -D -S\nwake off\n";
+	static const char bt_idle[] = "msleep 10\n";
+	int error = 0;
+	for (size_t i = 0; i < sizeof(directories) / sizeof(directories[0]); i++) {
+		struct mkdir_args request = {.path = scratch + 0xc00, .mode = 0755};
+		int32_t result = 0;
+		int made = copyout(directories[i], request.path, strlen(directories[i]) + 1);
+		if (!made) {
+			made = mkdir(p, &request, &result);
+		}
+		if (made && made != EEXIST) {
+			printf("guamp-bt-tool: mkdir %s: error %d\n", directories[i], made);
+			error = made;
+		}
+	}
+	char path[96];
+	for (size_t m = 0; !error && m < sizeof(models) / sizeof(models[0]); m++) {
+		for (size_t s = 0; s < sizeof(scripts) / sizeof(scripts[0]); s++) {
+			const char *text = s == 0 ? bt_boot : bt_idle;
+			snprintf(path, sizeof(path), "/private/var/ngpu/etc/bluetool/%s.%s.script", models[m], scripts[s]);
+			int written = native_guamp_write_file(p, scratch, path, (const uint8_t *)text, strlen(text), 0, 0644, 1);
+			if (written) {
+				printf("guamp-bt-tool: %s: error %d\n", path, written);
+				error = written;
+			} else {
+				native_guamp_bt_tool_written = native_guamp_bt_tool_written + 1;
+			}
+		}
+	}
+	printf("guamp-bt-tool: %d scripts written, status %d\n", native_guamp_bt_tool_written, error);
+	static const char source[] = "/private/var/ngpu/etc", point[] = "/private/etc";
+	native_gpu_addon_mount(p, scratch, 0x800, source, sizeof(source), point, sizeof(point), "/private/etc/hosts",
+	    "/private/etc/bluetool/D22AP.boot.script", &native_guamp_bt_tool_stage, &native_guamp_bt_tool_status);
+	printf("guamp-bt-tool: %s stage %d status %d\n", point, native_guamp_bt_tool_stage, native_guamp_bt_tool_status);
+}
