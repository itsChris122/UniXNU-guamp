+	if (guamp_stuck_mode < 0) {
+		unsigned int guamp_stuck_arg = 1;
+		PE_parse_boot_argn("guamp-stuck-cpu", &guamp_stuck_arg, sizeof(guamp_stuck_arg));
+		guamp_stuck_mode = guamp_stuck_arg == 1;
+	}
 
 	/* Check for nested debugger entry. */
