+/*
+ * guamp: a core stalled forever on an MMIO access that never completes (a TrustZone-protected GPU register) never
+ * acknowledges SIGPdebug. Every later stackshot then halts all other cores for two debug_ack_timeout waits (enter and
+ * return). guamp-stuck-cpu=1 (default): after a timeout the silent cores are recorded and later non-panic debugger entries
+ * (stackshots) skip them; a core that clears its pending SIGPdebug (it answered after all) is taken back. Panics
+ * (proceed_on_sync_failure) keep the original behaviour.
+ */
+static uint64_t guamp_stuck_cpus;
+static int guamp_stuck_mode = -1;
+uint64_t guamp_stuck_cpu_mask(void);
+uint64_t
+guamp_stuck_cpu_mask(void)
+{
+	return os_atomic_load(&guamp_stuck_cpus, relaxed);
+}
+
 kern_return_t
 DebuggerXCallEnter(
 	boolean_t proceed_on_sync_failure, bool is_stackshot)
