+/*
+ * guamp 07/11 (perf-cpu) guamp-sched-little=1 (default; 0 = off): the kernel background threads marked TH_OPT_GUAMP_LITTLE
+ * (thread.c, thread_set_thread_name) are placed like the threads below guamp-sched-amp: idle Silver cores first.
+ */
+static uint32_t guamp_sched_little = 1;
+
+static inline bool
+guamp_sched_amp_little(thread_t thread)
+{
+	return thread->base_pri < (int)guamp_sched_amp_pri || (guamp_sched_little && (thread->options & TH_OPT_GUAMP_LITTLE));
+}
 static uint64_t guamp_sched_amp_placed[2];   /* idle core chosen: [0] Silver, [1] Gold (GuampCore line) */
 static uint64_t guamp_sched_rt_placed[2];
 
