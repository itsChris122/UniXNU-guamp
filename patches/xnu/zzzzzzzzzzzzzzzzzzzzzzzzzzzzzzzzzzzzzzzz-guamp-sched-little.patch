diff --git a/osfmk/kern/thread.c b/osfmk/kern/thread.c
index 539cb83..2037512 100644
--- a/osfmk/kern/thread.c
+++ b/osfmk/kern/thread.c
@@ -3767,11 +3767,34 @@ thread_has_thread_name(thread_t th)
 	return FALSE;
 }
 
+/*
+ * guamp 07/11 (perf-cpu): the kernel threads of the guamp drivers that poll in the background (Wi-Fi copy engines, USB
+ * mirror, Bluetooth UART, GPU DCVS sampling, statistics) name themselves here once at start. They run at kernel priority
+ * (81), so guamp-sched-amp sent them to the Gold cores first: in fin53 (live-20261106-092610, 190-370 s) ~1100 idle Gold
+ * picks per second against ~30 Silver ones, ~760 timer interrupts/s on every Gold core and ~20-90 on the Silver ones, while
+ * the render thread of backboardd used ~1 Gold core. A name in this list marks the thread TH_OPT_GUAMP_LITTLE and
+ * choose_processor tries the idle Silver cores first for it (sched_prim.c, guamp_sched_amp_preferred; still work
+ * conserving). Not in the list on purpose: touch, audio/mic/jack device nodes, ADSP (audio periods), the CA/GPU submit
+ * threads and the PC sampler. Only a thread that names itself is marked (options are written by their own thread).
+ */
+static const char *const guamp_little_names[] = {
+	"guamp-usb-mirror", "guamp-wifi", "guamp-wifi-scan", "guamp-wifi-prep", "guamp-bt", "guamp-gpu-dcvs",
+	"guamp-gpu-perf", "guamp-hid-stats", "guamp-jack", "guamp-modem-watch", "guamp-pmic", "guamp-rpm-test",
+};
+
 void
 thread_set_thread_name(thread_t th, const char* name)
 {
 	if (th && name) {
 		bsd_setthreadname(get_bsdthread_info(th), thread_tid(th), name);
+		if (th == current_thread() && get_threadtask(th) == kernel_task) {
+			for (unsigned int i = 0; i < sizeof(guamp_little_names) / sizeof(guamp_little_names[0]); i++) {
+				if (strcmp(name, guamp_little_names[i]) == 0) {
+					th->options |= TH_OPT_GUAMP_LITTLE;
+					break;
+				}
+			}
+		}
 	}
 }
 
diff --git a/osfmk/kern/thread.h b/osfmk/kern/thread.h
