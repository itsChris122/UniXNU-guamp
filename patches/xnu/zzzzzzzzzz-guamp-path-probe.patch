@@ -3483,8 +3483,8 @@
 	return error;
 }
 
-int
-getattrlist(proc_t p, struct getattrlist_args *uap, __unused int32_t *retval)
+static int
+getattrlist_guamp_inner(proc_t p, struct getattrlist_args *uap, __unused int32_t *retval)
 {
 	enum uio_seg segflg;
 	struct attrlist al;
@@ -4942,3 +4942,20 @@
 
 	return error;
 }
+/* guamp-path-probe (vfs_lookup.c): the getattrlist result. */
+extern int guamp_path_probe_active(void);
+extern int guamp_path_probe_copy(user_addr_t path, enum uio_seg seg, char *buf, size_t size);
+extern void guamp_path_probe_log(const char *what, const char *path, int error, vnode_t vp, long extra);
+int
+getattrlist(proc_t p, struct getattrlist_args *uap, int32_t *retval)
+{
+	char path[160];
+	int match = 0;
+	if (!guamp_path_probe_active() || !(match = guamp_path_probe_copy(uap->path,
+	    IS_64BIT_PROCESS(p) ? UIO_USERSPACE64 : UIO_USERSPACE32, path, sizeof(path)))) {
+		return getattrlist_guamp_inner(p, uap, retval);
+	}
+	int error = getattrlist_guamp_inner(p, uap, retval);
+	if (match == 1 || error) guamp_path_probe_log("getattrlist", path, error, NULLVP, 0);
+	return error;
+}
