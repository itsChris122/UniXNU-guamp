 {
 	struct vnode *vp;
 	struct vnode *dvp;
@@ -2332,3 +2332,19 @@
 
 	return error == 0 ? 1 : 0;
 }
+/* guamp-path-probe (vfs_lookup.c): the open result after the lookup. */
+extern int guamp_path_probe_active(void);
+extern int guamp_path_probe_copy(user_addr_t path, enum uio_seg seg, char *buf, size_t size);
+extern void guamp_path_probe_log(const char *what, const char *path, int error, vnode_t vp, long extra);
+int
+vn_open_auth(struct nameidata *ndp, int *fmodep, struct vnode_attr *vap, vnode_t authvp)
+{
+	char path[160];
+	int match = 0;
+	if (!guamp_path_probe_active() || !(match = guamp_path_probe_copy(ndp->ni_dirp, ndp->ni_segflg, path, sizeof(path)))) {
+		return vn_open_auth_guamp_inner(ndp, fmodep, vap, authvp);
+	}
+	int error = vn_open_auth_guamp_inner(ndp, fmodep, vap, authvp);
+	if (match == 1 || error) guamp_path_probe_log("open", path, error, error ? NULLVP : ndp->ni_vp, fmodep ? (long)*fmodep : 0);
+	return error;
+}
diff --git a/bsd/vfs/vfs_attrlist.c b/bsd/vfs/vfs_attrlist.c
