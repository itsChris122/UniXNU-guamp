  *		VNOP_READLINK:???
  */
-int
-namei(struct nameidata *ndp)
+static int
+namei_guamp_inner(struct nameidata *ndp)
 {
 	struct vnode *dp;       /* the directory we are searching */
 	struct vnode *usedvp = ndp->ni_dvp;  /* store pointer to vp in case we must loop due to
@@ -2209,3 +2209,104 @@
 		kdebug_lookup(vp ? vp : dvp, &ndp->ni_cnd);
 	}
 }
+/* guamp-path-probe=N (29/10, diagnostics, off by default): logs up to N path-based namei/vn_open_auth/getattrlist calls whose
+ * path names MobileSafari.framework, SafariCore.framework, WebContentExtension.appex or a /Cryptexes/ directory, with the result,
+ * the resolved vnode path, its type and its mount (fs type, flags, fsid). Finds where cryptex bundles stop being readable for
+ * NSBundle/lsd/ExtensionKit: a failed lookup, a refusal after the lookup (open/getattrlist error with namei OK) or an unexpected
+ * mount. */
+#include <pexpert/pexpert.h>
+#include <libkern/OSAtomic.h>
+#include <sys/persona.h>
+static volatile SInt32 guamp_path_probe_limit = -1;
+static volatile SInt32 guamp_path_probe_used = 0;
+int guamp_path_probe_active(void);
+int guamp_path_probe_copy(user_addr_t path, enum uio_seg seg, char *buf, size_t size);
+void guamp_path_probe_log(const char *what, const char *path, int error, vnode_t vp, long extra);
+int
+guamp_path_probe_active(void)
+{
+	SInt32 limit = guamp_path_probe_limit;
+	if (limit < 0) {
+		uint32_t n = 0;
+		if (!PE_parse_boot_argn("guamp-path-probe", &n, sizeof(n))) {
+			n = 0;
+		}
+		limit = n > 100000 ? 100000 : (SInt32)n;
+		guamp_path_probe_limit = limit;
+	}
+	return guamp_path_probe_used < limit;
+}
+int
+guamp_path_probe_copy(user_addr_t path, enum uio_seg seg, char *buf, size_t size)
+{
+	size_t done = 0;
+	buf[0] = '\0';
+	if (path == USER_ADDR_NULL) {
+		return 0;
+	}
+	if (UIO_SEG_IS_USER_SPACE(seg)) {
+		if (copyinstr(path, buf, size, &done)) {
+			buf[0] = '\0';
+			return 0;
+		}
+	} else {
+		strlcpy(buf, CAST_DOWN(const char *, path), size);
+	}
+	/* 30/10 (app-rotte): boot-time noise that used up the budget before Safari ran (MSUEarlyBootTask/usermanagerd logging
+	 * plists, lsd's empty App cryptex) is skipped; app group containers and the ExtensionKit directory are logged on failure
+	 * only (2), with the persona of the caller (sandbox keys group containers as PERSONA_ID_<persona>:<group>); the Info.plist
+	 * of Notes/TV/Podcasts/Safari (read by the app itself at launch) gives the persona each app runs in. */
+	if (strnstr(buf, "/Cryptexes/App/", size) != NULL || strnstr(buf, "/Logging/Subsystems/", size) != NULL) {
+		return 0;
+	}
+	if (strnstr(buf, "MobileSafari.framework", size) != NULL || strnstr(buf, "SafariCore.framework", size) != NULL ||
+	    strnstr(buf, "/Cryptexes/", size) != NULL || strnstr(buf, "WebContentExtension.appex", size) != NULL ||
+	    strnstr(buf, "NetworkingExtension.appex", size) != NULL || strnstr(buf, "WebKit.framework", size) != NULL ||
+	    strnstr(buf, "MobileNotes.app/Info.plist", size) != NULL || strnstr(buf, "AppleTV.app/Info.plist", size) != NULL ||
+	    strnstr(buf, "Podcasts.app/Info.plist", size) != NULL || strnstr(buf, "MobileSafari.app/Info.plist", size) != NULL) {
+		return 1;
+	}
+	return strnstr(buf, "/Containers/Shared/AppGroup/", size) != NULL || strnstr(buf, "/ExtensionKit/Extensions", size) != NULL ?
+	       2 : 0;
+}
+void
+guamp_path_probe_log(const char *what, const char *path, int error, vnode_t vp, long extra)
+{
+	if (OSIncrementAtomic(&guamp_path_probe_used) >= guamp_path_probe_limit) {
+		return;
+	}
+	char real[160] = "-";
+	int length = sizeof(real);
+	const char *fs = "-";
+	uint64_t flags = 0;
+	int32_t fsid = 0;
+	int type = -1;
+	if (vp != NULLVP) {
+		if (vn_getpath(vp, real, &length)) {
+			strlcpy(real, "?", sizeof(real));
+		}
+		type = vnode_vtype(vp);
+		mount_t mp = vnode_mount(vp);
+		if (mp) {
+			fs = vfs_statfs(mp)->f_fstypename;
+			flags = vfs_flags(mp);
+			fsid = vfs_statfs(mp)->f_fsid.val[0];
+		}
+	}
+	proc_t p = current_proc();
+	printf("guamp-path: %s[%d] %s %ld err %d %s -> %s type %d fs %s flags 0x%llx fsid 0x%x persona %d uid %d\n",
+	    p ? proc_best_name(p) : "?", p ? proc_pid(p) : -1, what, extra, error, path, real, type, fs, flags, fsid,
+	    p ? (int)persona_id_from_proc(p) : -2, (int)kauth_cred_getuid(kauth_cred_get()));
+}
+int
+namei(struct nameidata *ndp)
+{
+	char path[160];
+	int match = 0;
+	if (!guamp_path_probe_active() || !(match = guamp_path_probe_copy(ndp->ni_dirp, ndp->ni_segflg, path, sizeof(path)))) {
+		return namei_guamp_inner(ndp);
+	}
+	int error = namei_guamp_inner(ndp);
+	if (match == 1 || error) guamp_path_probe_log("namei", path, error, error ? NULLVP : ndp->ni_vp, (long)ndp->ni_cnd.cn_nameiop);
+	return error;
+}
