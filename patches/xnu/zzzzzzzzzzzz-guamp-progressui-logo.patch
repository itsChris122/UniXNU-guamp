diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7505,8 +7505,13 @@ native_gpu_addon_install(proc_t p, user_addr_t scratch)
 /* The sixth view (owner 29/10, Wallet from the iPhone XS) adds placeholders of iPhone-only deletable system apps to
  * /System/Library/AppPlaceholders (iphone-res/AppPlaceholders/<App>.app, local files): SystemAppMigrator and LaunchServices treat an
  * app in /private/var/staged_system_apps as a deletable system app only when its placeholder exists. */
-volatile int native_guamp_iphone_res_stage[6] = {0, 0, 0, 0, 0, 0};
-volatile int native_guamp_iphone_res_status[6] = {-1, -1, -1, -1, -1, -1};
+/* The seventh view (owner 29/10, boot logo) gives ProgressUI the iPhone Apple logo: PUIProgressWindow (backboardd's migration/update
+ * progress screen) loads <bundle>/apple-logo[-black]@<scale>x~<device class>.png; this iPadOS has only the ~ipad files, so with the
+ * iPhone device class it logs "no apple logo found" and draws the bar alone in the middle of the screen. The iPhone XS 17.7 files
+ * apple-logo@2x~iphone.png and apple-logo-black@2x~iphone.png (iphone-res/ProgressUI.framework, local files) restore the logo above
+ * the bar, the same artwork and size as the kernel's boot logo (/chosen/guamp-logo). */
+volatile int native_guamp_iphone_res_stage[7] = {0, 0, 0, 0, 0, 0, 0};
+volatile int native_guamp_iphone_res_status[7] = {-1, -1, -1, -1, -1, -1, -1};
