+#if defined(__arm64__)
+/* thread_getstatus: the machine-independent way BSD code reads user registers (kern_core.c declares it the same way) */
+extern kern_return_t thread_getstatus(thread_t act, int flavor, thread_state_t tstate, mach_msg_type_number_t *count);
+/*
+ * guamp: one log line per crashing process (the ones the kernel would turn into a corpse). Corpses are off
+ * (-no_corpses) and ReportCrash wrote no reports, so this is the only record of where a daemon died: exception code
+ * and subcode, the user registers of the dying thread, the shared cache slide, a frame pointer backtrace and the main
+ * image. Runs on the exiting thread of the process itself, before the task is torn down; copyin failures only shorten
+ * the line.
+ */
+
+/* Read the current process's EL0 translation, not its contents. Preserve PAR
+ * and DAIF; IRQ/FIQ are masked only for this short, nonblocking sysreg sequence. */
+static void
+guamp_user_translation(const char *label, uint64_t address)
+{
+    if (address < 4096 || address >= (1ULL << 48)) { return; }
+    uint64_t daif, previous_par, par, sctlr, mair, tcr, ttbr;
+    __asm__ volatile (
+        "mrs %0, daif\nmsr daifset, #3\nmrs %1, par_el1\n"
+        "at s1e0r, %7\nisb\nmrs %2, par_el1\n"
+        "mrs %3, sctlr_el1\nmrs %4, mair_el1\nmrs %5, tcr_el1\nmrs %6, ttbr0_el1\n"
+        "msr par_el1, %1\nmsr daif, %0\nisb"
+        : "=&r"(daif), "=&r"(previous_par), "=&r"(par), "=&r"(sctlr),
+          "=&r"(mair), "=&r"(tcr), "=&r"(ttbr) : "r"(address) : "memory");
+    printf("GuampMap: %s va %llx PAR %llx attr %02llx SCTLR %llx MAIR %llx TCR %llx TTBR0 %llx\n",
+        label, address, par, (par >> 56) & 255, sctlr, mair, tcr, ttbr);
+}
+
+static void
+guamp_exit_trace(proc_t p, int rv, mach_exception_data_type_t code, mach_exception_data_type_t subcode)
+{
+	arm_thread_state64_t ts;
+	mach_msg_type_number_t count = ARM_THREAD_STATE64_COUNT;
+	if (p != current_proc() ||
+	    thread_getstatus(current_thread(), ARM_THREAD_STATE64, (thread_state_t)&ts, &count) != KERN_SUCCESS) {
+		printf("guamp exit: %s[%d] rv 0x%x code 0x%llx sub 0x%llx (no user state)\n", p->p_comm, proc_getpid(p), rv,
+		    (uint64_t)code, (uint64_t)subcode);
+		return;
+	}
+
+    if (strcmp(p->p_comm, "backboardd") == 0 && (rv == 10 || rv == 11)) {
+        arm_exception_state64_t exception;
+        mach_msg_type_number_t exception_count = ARM_EXCEPTION_STATE64_COUNT;
+        kern_return_t status = thread_getstatus(current_thread(), ARM_EXCEPTION_STATE64,
+            (thread_state_t)&exception, &exception_count);
+        if (status == KERN_SUCCESS) {
+            printf("GuampMap: saved exception ESR %x FAR %llx kind %x\n",
+                exception.esr, exception.far, exception.exception);
+        } else { printf("GuampMap: saved exception unavailable %d\n", status); }
+        guamp_user_translation("fault", (uint64_t)subcode);
+        if (ts.x[0] != (uint64_t)subcode) { guamp_user_translation("x0", ts.x[0]); }
+        if (ts.x[1] != (uint64_t)subcode && ts.x[1] != ts.x[0]) { guamp_user_translation("x1", ts.x[1]); }
+    }
+
+	char bt[16 * 13 + 1] = "";
+	size_t used = 0;
+	uint64_t frame = ts.fp;
+	for (unsigned depth = 0; depth < 16 && frame && !(frame & 15) && used + 14 < sizeof(bt); depth++) {
+		uint64_t pair[2];
+		if (copyin((user_addr_t)frame, pair, sizeof(pair))) {
+			break;
+		}
+		used += (size_t)snprintf(bt + used, sizeof(bt) - used, " %llx", pair[1]);
+		if (pair[0] <= frame || pair[0] - frame > 1048576) {
+			break;
+		}
+		frame = pair[0];
+	}
+	struct user64_dyld_all_image_infos info = {};
+	struct user64_dyld_image_info image = {};
+	char path[96] = "";
+	size_t copied = 0;
+	if (!copyin(task_get_all_image_info_addr(current_task()), &info, sizeof(info)) && info.infoArrayCount && info.infoArray &&
+	    !copyin(info.infoArray, &image, sizeof(image))) {
+		if (copyinstr(image.imageFilePath, path, sizeof(path), &copied)) {
+			path[0] = 0;
+		}
+	}
+	printf("guamp exit: %s[%d] rv 0x%x code 0x%llx sub 0x%llx PC %llx LR %llx SP %llx X0 %llx X1 %llx slide %llx image %llx %s bt%s\n",
+	    p->p_comm, proc_getpid(p), rv, (uint64_t)code, (uint64_t)subcode, (uint64_t)ts.pc,
+	    (uint64_t)ts.lr, (uint64_t)ts.sp, (uint64_t)ts.x[0],
+	    (uint64_t)ts.x[1], (uint64_t)info.sharedCacheSlide, image.imageLoadAddress,
+	    path, bt);
+}
+#endif /* __arm64__ */
