--- /dev/null
+++ b/bsd/kern/guamp_oslog_filter.h
@@ -0,0 +1,98 @@
+/*
+ * guamp-oslog (05/11): line filters of the os_log tee in sys_generic.c, kept free of kernel headers so that
+ * scripts/test-guamp-oslog-filter.sh can build them on the host.
+ *   guamp_oslog_keep()       guamp-oslog-skip / guamp-oslog-only (comma-separated substrings)
+ *   guamp_oslog_ring_note()  drops a line identical (same process, same first 400 characters) to one of the last
+ *                            16 kept, and says when to print "repeated N times" (N = 10, 100, 1000, ...)
+ * The ring is updated without a lock: two writers at once can at worst let a repeated line through.
+ */
+#ifndef GUAMP_OSLOG_FILTER_H
+#define GUAMP_OSLOG_FILTER_H
+
+/* bit 8 of the amfi_check_dyld_policy_self() flags: libsystem_trace reads OS_ACTIVITY_* only with it */
+#define GUAMP_AMFI_DEV_ENV_VARS 0x100ull
+#define GUAMP_OSLOG_RING 16
+#define GUAMP_OSLOG_CUT 400
+
+struct guamp_oslog_ring {
+	uint32_t hash[GUAMP_OSLOG_RING];
+	uint32_t count[GUAMP_OSLOG_RING];
+	uint32_t next;
+};
+
+/* does line contain one of the comma-separated substrings of list (empty items are ignored) */
+static inline int
+guamp_oslog_has(const char *line, const char *list)
+{
+	const char *tok = list;
+
+	while (tok != NULL && *tok) {
+		const char *end = tok;
+		while (*end && *end != ',') {
+			end++;
+		}
+		unsigned long tlen = (unsigned long)(end - tok);
+		if (tlen != 0) {
+			for (const char *at = line; *at; at++) {
+				unsigned long i = 0;
+				while (i < tlen && at[i] == tok[i]) {
+					i++;
+				}
+				if (i == tlen) {
+					return 1;
+				}
+			}
+		}
+		tok = *end ? end + 1 : end;
+	}
+	return 0;
+}
+
+static inline int
+guamp_oslog_keep(const char *line, const char *skip, const char *only)
+{
+	if (skip != NULL && skip[0] && guamp_oslog_has(line, skip)) {
+		return 0;
+	}
+	if (only != NULL && only[0] && !guamp_oslog_has(line, only)) {
+		return 0;
+	}
+	return 1;
+}
+
+static inline uint32_t
+guamp_oslog_hash(uint32_t pid, const char *line)
+{
+	uint32_t h = 2166136261u ^ pid;
+
+	for (int i = 0; i < GUAMP_OSLOG_CUT && line[i]; i++) {
+		h = (h ^ (uint8_t)line[i]) * 16777619u;
+	}
+	return h != 0 ? h : 1;
+}
+
+/* 1: a new line, print it; 0: seen among the last kept ones, drop it (*repeats != 0: print the count now) */
+static inline int
+guamp_oslog_ring_note(struct guamp_oslog_ring *r, uint32_t pid, const char *line, unsigned *repeats)
+{
+	uint32_t h = guamp_oslog_hash(pid, line);
+
+	*repeats = 0;
+	for (int i = 0; i < GUAMP_OSLOG_RING; i++) {
+		if (r->hash[i] == h) {
+			uint32_t n = ++r->count[i];
+			for (uint32_t m = 10; m != 0 && m <= n; m = m <= 100000000u ? m * 10 : 0) {
+				if (n == m) {
+					*repeats = n;
+				}
+			}
+			return 0;
+		}
+	}
+	uint32_t slot = r->next++ % GUAMP_OSLOG_RING;
+	r->hash[slot] = h;
+	r->count[slot] = 0;
+	return 1;
+}
+
+#endif /* GUAMP_OSLOG_FILTER_H */
