+/* 05/11: the AMFI dyld policy answer with "development environment variables allowed" (see the comment at the top). */
+int guamp_oslog_amfi_policy(struct proc *p, int call, user_addr_t arg, int error);
+int
+guamp_oslog_amfi_policy(struct proc *p, int call, user_addr_t arg, int error)
+{
+	uint64_t req[2], flags = 0;	/* { pid or 0, user address of the 64-bit flags } (libsystem_trace, arm64) */
+
+	if (call != 90 || arg == USER_ADDR_NULL || !guamp_oslog_enabled() || !guamp_oslog_amfi ||
+	    !proc_is64bit(p) || !guamp_oslog_match(p->p_comm)) {
+		return error;
+	}
+	if (copyin(arg, req, sizeof(req)) != 0 || req[1] == 0) {
+		return error;
+	}
+	if (error == 0 && copyin((user_addr_t)req[1], &flags, sizeof(flags)) != 0) {
+		return error;
+	}
+	flags |= GUAMP_AMFI_DEV_ENV_VARS;
+	if (copyout(&flags, (user_addr_t)req[1], sizeof(flags)) != 0) {
+		return error;
+	}
+	return 0;
+}
+
+static struct guamp_oslog_ring guamp_oslog_recent;
+
+static void
+guamp_oslog_tee(struct proc *p, int fd, uio_t uio)
+{
+	char buf[512];
+	int iovcnt = uio_iovcnt(uio);
+	if (!uio_isuserspace(uio)) {
+		return;
+	}
+	for (int i = 0; i < iovcnt && i < 8; i++) {
+		user_addr_t base = 0;
+		user_size_t len = 0;
+		if (uio_getiov(uio, i, &base, &len) != 0 || len == 0) {
+			continue;
+		}
+		size_t take = len < sizeof(buf) - 1 ? (size_t)len : sizeof(buf) - 1;
+		if (copyin(base, buf, take) != 0) {
+			continue;
+		}
+		buf[take] = '\0';
+		char *line = buf;
+		while (*line) {
+			if (guamp_oslog_left < -16) {
+				return;
+			}
+			char *nl = line;
+			while (*nl && *nl != '\n') {
+				nl++;
+			}
+			char saved = *nl;
+			*nl = '\0';
+			if (nl != line) {
+				unsigned repeats = 0;
+				int keep = guamp_oslog_keep(line, guamp_oslog_skip, guamp_oslog_only);
+				if (keep && guamp_oslog_dedup) {
+					keep = guamp_oslog_ring_note(&guamp_oslog_recent, (uint32_t)proc_getpid(p), line, &repeats);
+				}
+				if (!keep) {
+					if (repeats != 0 && guamp_oslog_left > 0) {
+						printf("guamp oslog: %s[%d] (a line seen before, repeated %u times)\n", p->p_comm,
+						    proc_getpid(p), repeats);
+					}
+					if (saved == '\0') {
+						break;
+					}
+					line = nl + 1;
+					continue;
+				}
+				SInt32 left = OSAddAtomic(-1, &guamp_oslog_left);
+				if (left <= 0) {
+					if (left == 0) {
+						printf("guamp oslog: line limit reached (guamp-oslog-lines)\n");
+					}
+					return;
+				}
+				printf("guamp oslog: %s[%d] %d %.400s\n", p->p_comm, proc_getpid(p), fd, line);
+			}
+			if (saved == '\0') {
+				break;
+			}
+			line = nl + 1;
+		}
+	}
+}
