+#include <pexpert/pexpert.h>
+#include <os/atomic_private.h>
+/*
+ * guamp-oslog (03/11, App Store "Cannot connect"): the unified log of iOS (tracev3) is written by logd only every
+ * few minutes, and what is still in its buffers is lost when the phone goes to fastboot, so the copy of Data
+ * misses the last minutes of a test. guamp-oslog=1 sets OS_ACTIVITY_DT_MODE=YES (libtrace then also writes each
+ * os_log line to stderr) in the environment of the processes of a list, at exec (kern_exec.c), and here copies what
+ * those processes write to fd 1 and 2 (usually /dev/null for launchd jobs and apps) into the kernel log, one
+ * "guamp oslog: name[pid] text" line per line written, cut at 400 characters.
+ *   guamp-oslog=1                 on, default list (App Store chain); 0 or absent: off
+ *   guamp-oslog-procs=a,b,c       own list instead of the default (process names; p_comm keeps 16 characters)
+ *   guamp-oslog-lines=<n>         lines at most in the whole boot (default 3000)
+ *   guamp-oslog-level=1|2         also OS_ACTIVITY_MODE=info (1) or debug (2): more lines, more noise
+ *   guamp-oslog-skip=a,b          05/11: lines containing any of these substrings are dropped (not counted)
+ *   guamp-oslog-only=a,b          05/11: only lines containing one of these substrings are kept (not counted otherwise)
+ *   guamp-oslog-dedup=0           05/11: keep repeated lines; by default a line identical to one of the last 16
+ *                                 kept is dropped and counted ("repeated N times" at 10, 100, 1000, ...)
+ * 05/11 (fin49, wifid): libsystem_trace honours OS_ACTIVITY_DT_MODE/OS_ACTIVITY_MODE only when
+ * amfi_check_dyld_policy_self() (mac_syscall "AMFI", 90) answers with bit 8 (allow development environment
+ * variables, _os_trace_allow_development_env_vars); on a release build platform daemons never get it, so wifid wrote
+ * nothing but AssertMacros lines (those go to stderr directly). For the listed processes __mac_syscall (mac_base.c)
+ * now adds that bit (guamp_oslog_amfi_policy); guamp-oslog-amfi=0 turns this off.
+ * 06/11 (fin50/fin51: still not one os_log line from wifid, CommCenter or bluetoothd): (1) the AMFI call is answered
+ * also when the sandbox refuses it (mac_proc_check_mac_syscall, before the policy: wifid & co. are sandboxed), and the
+ * first answers are logged ("guamp oslog: AMFI ..."); (2) with OS_ACTIVITY_DT_MODE alone _os_log_impl_mirror_to_stderr
+ * (libsystem_trace 17.7.11, 0x1a07141fc) drops every non-error line whose caller lives in /System/Library/, /usr/lib/
+ * or /System/Developer/, i.e. all of CoreWiFi (the unified auto-join), WiFiPolicy, CoreTelephony...; with
+ * ACTIVITY_LOG_STDERR set (byte 0x1f4847b6e) it mirrors them too. guamp-oslog-stderr=1 (default) adds
+ * ACTIVITY_LOG_STDERR=1; 0: DT mode only, as before.
+ * 06/11 (fin52: AMFI answered 0x169 to wifid, still no os_log line from any listed process): the libsystem_trace
+ * initializer (0x1a070e730) reads ACTIVITY_LOG_STDERR, OS_ACTIVITY_DT_MODE, OS_ACTIVITY_TOOLS_* only when the process
+ * is traced or issetugid() is 0; launchd daemons that go through a MAC label transition at exec (sandbox) may get
+ * P_SUGID, so the mirror flags 0x1f4847b6e/b6f stay 0. For the listed processes issetugid (kern_prot.c) now answers
+ * 0 (guamp_oslog_issetugid, first answers logged "guamp oslog: issetugid ..."); guamp-oslog-sugid=0 turns this off.
+ * 06/11 (fin53: AMFI 0x69 -> 0x169 and issetugid 0 seen for wifid, CommCenter, bluetoothd, right before the getenv()
+ * calls of _os_trace_init_slow, and still not one line with the " name[pid:tid] " header of the mirror): the mirror
+ * depends only on the libsystem_trace bytes ACTIVITY_LOG_STDERR (0x1f4847b6e) / OS_ACTIVITY_DT_MODE (0x1f4847b6f)
+ * (_os_log_impl_flatten_and_send 0x1a07051b0: mirror when either is set), and with both gates answered they can stay 0
+ * only if getenv() does not see the variables put at exec. The kernel no longer depends on the environment: at each
+ * issetugid() of a listed process (libc, libtrace and others call it early) it sets the ACTIVITY_LOG_STDERR byte in
+ * the process's own copy of the shared cache data (copy on write, like any write of the process), after checking that
+ * the cache is the one these addresses come from (17.7.11 21H461: "adrp/add ACTIVITY_LOG_STDERR" of
+ * _os_trace_init_slow at 0x1a070e750 and the string at 0x1a07171fc, slide from the shared region); with
+ * guamp-oslog-level=1|2 also the info (1) or info+debug (3) bits of the libtrace mode word (0x1f4847af8, the bits
+ * OS_ACTIVITY_MODE=info|debug sets). The first changes are logged: "guamp oslog: libtrace mirror for name[pid]:
+ * stderr byte 0 -> 1, mode a -> b, env DT_MODE yes|no" (the last field says whether OS_ACTIVITY_DT_MODE= is in the
+ * argument/environment area of the process: no = the exec injection did not happen, yes = it got there and was not
+ * read). guamp-oslog-poke=0 turns this off.
+ * 07/11 (fin55: "stderr byte 0 -> 1 ... env DT_MODE yes" for wifid, Bridge, nanoregistryd, still no mirrored line): the
+ * environment was there, so libtrace had set the bytes itself and the mirror is stopped by another gate. The gates
+ * (libsystem_trace 17.7.11): os_log_type_enabled is false with mode/ATM bit 0x100, with 0x400 unless DT mode, and
+ * for a log level 4 ("off"); _os_log_impl_flatten_and_send returns before sending and mirroring with mode/ATM bit
+ * 0x800 (0x1a0704790) and mirrors only when the level is not 4 (w19 = 0xff at 0x1a0704c98). logd can rewrite the
+ * mode word after the init (__XChangeMode), so the kernel now redoes the poke at every write of a listed process to
+ * fd 1/2, sets OS_ACTIVITY_DT_MODE too, clears guamp-oslog-mode-clear (default 0xd00) from the mode word, and logs
+ * the gates ("guamp oslog: libtrace state name[pid]: ... mode, atm (commpage, whole system), prefs (process_prefs.0),
+ * os_trace, buffers"), so the next log says which one is closed.
+ * 07/11 (fin56: the state line shows every gate open: mode 0x1, atm 0, buffers yes): the cause was in the tee itself.
+ * writev_uio passes a uio made by uio_create whose uio_iovcnt is still 0 when writev_internal runs (fp_writev counts
+ * the iovecs later, uio_calculateresid_user), so the tee copied nothing from any writev; the lines seen so far were
+ * all plain write() calls (objc, AssertMacros, fprintf), while _os_log_impl_mirror_to_stderr always writes with
+ * writev (__os_trace_writev). The tee now calls uio_calculateresid_user first. The environment of guamp_oslog_exec_env
+ * already reached libtrace (fin55 "env DT_MODE yes"), so the poke is not needed: guamp-oslog-poke is now 0 by
+ * default (=1 brings back the bytes, the mode word and the state line).
+ * The tee also joins the iovecs of one writev (the mirror writes header, message and newline separately).
+ * In DT mode the text is formatted inside the process, so <private> arguments may appear in clear: the lines stay in
+ * the kernel log (kpan, USB mirror), never on the network.
+ */
+static const char guamp_oslog_default[] = "AppStore,appstored,itunesstored,amsaccountsd,amsengagementd,akd,storekitd,"
+    "adid,fairplayd.A2,mobileactivationd,lockdownd,apsd";
+static char guamp_oslog_list[512];
+static int guamp_oslog_level;
+static SInt32 guamp_oslog_left;
+static int guamp_oslog_state = -1;	/* -1 not read yet, 0 off, 1 on */
+static char guamp_oslog_skip[256];
+static char guamp_oslog_only[256];
+static int guamp_oslog_dedup = 1;
+static int guamp_oslog_amfi = 1;
+static int guamp_oslog_stderr = 1;
+static int guamp_oslog_sugid = 1;
+static SInt32 guamp_oslog_sugid_said;
+static SInt32 guamp_oslog_amfi_said;
+static int guamp_oslog_poke_on = 0;
+static SInt32 guamp_oslog_poke_said;
+static SInt32 guamp_oslog_state_said;
+static int guamp_oslog_mode_clear = 0xd00;
+
+static int
+guamp_oslog_enabled(void)
+{
+	int state = os_atomic_load(&guamp_oslog_state, acquire);
+	if (state >= 0) {
+		return state;
+	}
+	int on = 0, lines = 3000, level = 0;
+	if (!PE_parse_boot_argn("guamp-oslog", &on, sizeof(on)) || on == 0) {
+		os_atomic_store(&guamp_oslog_state, 0, release);
+		return 0;
+	}
+	if (!PE_parse_boot_arg_str("guamp-oslog-procs", guamp_oslog_list, sizeof(guamp_oslog_list)) ||
+	    guamp_oslog_list[0] == '\0') {
+		strlcpy(guamp_oslog_list, guamp_oslog_default, sizeof(guamp_oslog_list));
+	}
+	PE_parse_boot_argn("guamp-oslog-lines", &lines, sizeof(lines));
+	PE_parse_boot_argn("guamp-oslog-level", &level, sizeof(level));
+	if (!PE_parse_boot_arg_str("guamp-oslog-skip", guamp_oslog_skip, sizeof(guamp_oslog_skip))) {
+		guamp_oslog_skip[0] = '\0';
+	}
+	if (!PE_parse_boot_arg_str("guamp-oslog-only", guamp_oslog_only, sizeof(guamp_oslog_only))) {
+		guamp_oslog_only[0] = '\0';
+	}
+	PE_parse_boot_argn("guamp-oslog-dedup", &guamp_oslog_dedup, sizeof(guamp_oslog_dedup));
+	PE_parse_boot_argn("guamp-oslog-amfi", &guamp_oslog_amfi, sizeof(guamp_oslog_amfi));
+	PE_parse_boot_argn("guamp-oslog-stderr", &guamp_oslog_stderr, sizeof(guamp_oslog_stderr));
+	PE_parse_boot_argn("guamp-oslog-sugid", &guamp_oslog_sugid, sizeof(guamp_oslog_sugid));
+	PE_parse_boot_argn("guamp-oslog-poke", &guamp_oslog_poke_on, sizeof(guamp_oslog_poke_on));
+	PE_parse_boot_argn("guamp-oslog-mode-clear", &guamp_oslog_mode_clear, sizeof(guamp_oslog_mode_clear));
+	guamp_oslog_left = lines > 0 ? lines : 0;
+	guamp_oslog_level = level;
+	os_atomic_store(&guamp_oslog_state, 1, release);
+	printf("guamp oslog: on, %d lines, level %d, processes %s\n", lines, level, guamp_oslog_list);
+	return 1;
+}
+
+/* name is a process name: the whole executable name at exec, p_comm (MAXCOMLEN characters at most) later. */
+static int
+guamp_oslog_match(const char *name)
+{
+	size_t len = strnlen(name, MAXCOMLEN + 1);
+	const char *tok = guamp_oslog_list;
+	if (len == 0) {
+		return 0;
+	}
+	while (*tok) {
+		const char *end = tok;
+		while (*end && *end != ',') {
+			end++;
+		}
+		size_t tlen = (size_t)(end - tok);
+		if (tlen == len && memcmp(tok, name, len) == 0) {
+			return 1;
+		}
+		if (len >= MAXCOMLEN && tlen > len && memcmp(tok, name, len) == 0) {
+			return 1;	/* name cut to MAXCOMLEN */
+		}
+		tok = *end ? end + 1 : end;
+	}
+	return 0;
+}
+
+/* Called by exec_extract_strings with the executable path; returns how many strings it put in env (0..3). */
+int guamp_oslog_exec_env(const char *path, const char **env);
+int
+guamp_oslog_exec_env(const char *path, const char **env)
+{
+	const char *base = path, *s;
+	char name[MAXCOMLEN + 1];
+	int n = 0;
+	if (path == NULL || !guamp_oslog_enabled()) {
+		return 0;
+	}
+	for (s = path; *s; s++) {
+		if (*s == '/') {
+			base = s + 1;
+		}
+	}
+	strlcpy(name, base, sizeof(name));
+	if (!guamp_oslog_match(base) && !guamp_oslog_match(name)) {
+		return 0;
+	}
+	env[n++] = "OS_ACTIVITY_DT_MODE=YES";
+	if (guamp_oslog_stderr) {
+		env[n++] = "ACTIVITY_LOG_STDERR=1";
+	}
+	if (guamp_oslog_level == 1) {
+		env[n++] = "OS_ACTIVITY_MODE=info";
+	} else if (guamp_oslog_level >= 2) {
+		env[n++] = "OS_ACTIVITY_MODE=debug";
+	}
+	return n;
+}
