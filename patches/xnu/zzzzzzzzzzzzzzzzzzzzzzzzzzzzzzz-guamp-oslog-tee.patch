+#include <vm/vm_shared_region.h>
+
+/* 06/11 (fin53): libsystem_trace 17.7.11 (21H461) addresses, unslid (see the comment at the top) */
+#define GUAMP_DSC_BASE          0x180000000ULL
+#define GUAMP_TRACE_INIT_ENV    0x1a070e750ULL          /* adrp x0, ...; add x0, x0, "ACTIVITY_LOG_STDERR" */
+#define GUAMP_TRACE_INIT_INSN   0x9107f000b0000040ULL
+#define GUAMP_TRACE_ENV_NAME    0x1a07171fcULL
+#define GUAMP_TRACE_MODE        0x1f4847af8ULL          /* uint32_t mode: 1 info, 2 debug */
+#define GUAMP_TRACE_LOG_STDERR  0x1f4847b6eULL          /* uint8_t ACTIVITY_LOG_STDERR, then OS_ACTIVITY_DT_MODE */
+#define GUAMP_TRACE_OS_TRACE    0x1f4847ae0ULL          /* _os_trace (dispatch once of the init, -1 when done) */
+#define GUAMP_TRACE_BUFFERS     0x1f4847ae8ULL          /* firehose buffers pointer (0: not connected to logd) */
+#define GUAMP_TRACE_B68         0x1f4847b68ULL
+#define GUAMP_TRACE_PREFS       0x1f4847b98ULL          /* process_prefs.0 */
+#define GUAMP_COMMPAGE_ATM      0xfffffc104ULL          /* _COMM_PAGE_ATM_DIAGNOSTIC_CONFIG (64-bit) */
+
+/* 1 when needle is in the argument/environment strings of p (the area KERN_PROCARGS2 returns), 0 not, -1 unknown */
+static int
+guamp_oslog_env_has(struct proc *p, const char *needle)
+{
+	char buf[256];
+	size_t nlen = strlen(needle);
+	user_addr_t end = (user_addr_t)p->user_stack;
+	size_t len = (size_t)p->p_argslen;
+
+	if (end == 0 || len == 0 || len > 256 * 1024 || nlen == 0 || nlen >= sizeof(buf) / 2 || len > end) {
+		return -1;
+	}
+	for (user_addr_t at = end - len; at < end;) {
+		size_t take = (size_t)(end - at) < sizeof(buf) ? (size_t)(end - at) : sizeof(buf);
+		if (copyin(at, buf, take) != 0) {
+			return -1;
+		}
+		for (size_t i = 0; i + nlen <= take; i++) {
+			if (memcmp(buf + i, needle, nlen) == 0) {
+				return 1;
+			}
+		}
+		if (take < sizeof(buf)) {
+			break;
+		}
+		at += take - (nlen - 1);
+	}
+	return 0;
+}
+
+/* 06/11: libtrace mirror state set by the kernel for a listed process (see the comment at the top); p is current_proc().
+ * why: 0 issetugid, 1 a write of the process to fd 1/2 (later, after logd may have changed the mode word). */
+static void
+guamp_oslog_poke(struct proc *p, int why)
+{
+	static const char name[] = "ACTIVITY_LOG_STDERR";
+	char seen[sizeof(name)];
+	mach_vm_offset_t start = 0;
+	uint64_t insn = 0, slide, trace = 0, buffers = 0;
+	uint32_t mode = 0, mode_was = 0, want = 0, atm = 0;
+	uint8_t was[2] = { 0, 0 }, on[2] = { 1, 1 }, prefs = 0, b68 = 0;
+	int changed = 0;
+
+	if (!guamp_oslog_poke_on || p != current_proc() || !proc_is64bit(p)) {
+		return;
+	}
+	vm_shared_region_t sr = vm_shared_region_get(current_task());
+	if (sr == NULL) {
+		return;
+	}
+	kern_return_t kr = vm_shared_region_start_address(sr, &start, TASK_NULL);
+	vm_shared_region_deallocate(sr);
+	if (kr != KERN_SUCCESS || start < GUAMP_DSC_BASE) {
+		return;
+	}
+	slide = start - GUAMP_DSC_BASE;
+	if (copyin((user_addr_t)(GUAMP_TRACE_INIT_ENV + slide), &insn, sizeof(insn)) != 0 || insn != GUAMP_TRACE_INIT_INSN ||
+	    copyin((user_addr_t)(GUAMP_TRACE_ENV_NAME + slide), seen, sizeof(seen)) != 0 ||
+	    memcmp(seen, name, sizeof(name)) != 0) {
+		if (OSAddAtomic(1, &guamp_oslog_poke_said) < 16) {
+			printf("guamp oslog: libtrace mirror for %s[%d]: not the expected shared cache (slide %#llx), left alone\n",
+			    p->p_comm, proc_getpid(p), (unsigned long long)slide);
+		}
+		return;
+	}
+	/* ACTIVITY_LOG_STDERR and OS_ACTIVITY_DT_MODE (DT mode also keeps os_log_type_enabled true under mode "off") */
+	if (copyin((user_addr_t)(GUAMP_TRACE_LOG_STDERR + slide), was, sizeof(was)) != 0) {
+		return;
+	}
+	if (was[0] == 0 || was[1] == 0) {
+		if (copyout(on, (user_addr_t)(GUAMP_TRACE_LOG_STDERR + slide), sizeof(on)) != 0) {
+			return;
+		}
+		changed = 1;
+	}
+	/* mode word: + info/debug (guamp-oslog-level), - the bits that stop every os_log of the process before the mirror
+	 * (0x100 disable, 0x400 off, 0x800: _os_log_impl_flatten_and_send 0x1a0704790 returns at once), set by
+	 * OS_ACTIVITY_MODE or later by logd (__XChangeMode) */
+	want = guamp_oslog_level == 1 ? 1u : guamp_oslog_level >= 2 ? 3u : 0u;
+	if (copyin((user_addr_t)(GUAMP_TRACE_MODE + slide), &mode_was, sizeof(mode_was)) == 0) {
+		mode = (mode_was | want) & ~(uint32_t)guamp_oslog_mode_clear;
+		if (mode != mode_was && copyout(&mode, (user_addr_t)(GUAMP_TRACE_MODE + slide), sizeof(mode)) == 0) {
+			changed = 1;
+		} else {
+			mode = mode_was;
+		}
+	}
+	if (!changed && why == 0) {
+		return;
+	}
+	/* the state the gates of os_log_type_enabled / flatten_and_send read: on every change, and on the first writes */
+	if (changed || OSAddAtomic(1, &guamp_oslog_state_said) < 4) {
+		if (OSAddAtomic(1, &guamp_oslog_poke_said) >= 40) {
+			return;
+		}
+		(void)copyin((user_addr_t)GUAMP_COMMPAGE_ATM, &atm, sizeof(atm));
+		(void)copyin((user_addr_t)(GUAMP_TRACE_PREFS + slide), &prefs, sizeof(prefs));
+		(void)copyin((user_addr_t)(GUAMP_TRACE_B68 + slide), &b68, sizeof(b68));
+		(void)copyin((user_addr_t)(GUAMP_TRACE_OS_TRACE + slide), &trace, sizeof(trace));
+		(void)copyin((user_addr_t)(GUAMP_TRACE_BUFFERS + slide), &buffers, sizeof(buffers));
+		int env = changed ? guamp_oslog_env_has(p, "OS_ACTIVITY_DT_MODE=") : -1;
+		printf("guamp oslog: libtrace %s %s[%d]: stderr/dt %u/%u -> 1/1, mode %#x -> %#x, atm %#x, prefs %#x, b68 %#x, "
+		    "os_trace %#llx, buffers %s, env DT_MODE %s\n", why ? "state" : "mirror for", p->p_comm, proc_getpid(p),
+		    (unsigned)was[0], (unsigned)was[1], mode_was, mode, atm, (unsigned)prefs, (unsigned)b68,
+		    (unsigned long long)trace, buffers ? "yes" : "no", env > 0 ? "yes" : env == 0 ? "no" : "-");
+	}
+}
+
+/* 06/11: issetugid() of the listed processes (see the comment at the top); sugid is proc_issetugid(p). */
+int guamp_oslog_issetugid(struct proc *p, int sugid);
+int
+guamp_oslog_issetugid(struct proc *p, int sugid)
+{
+	if (!guamp_oslog_enabled() || !guamp_oslog_match(p->p_comm)) {
+		return sugid;
+	}
+	guamp_oslog_poke(p, 0);
+	int answer = guamp_oslog_sugid ? 0 : sugid;
+	if (OSAddAtomic(1, &guamp_oslog_sugid_said) < 16) {
+		printf("guamp oslog: issetugid for %s[%d]: %d -> %d\n", p->p_comm, proc_getpid(p), sugid, answer);
+	}
+	return answer;
+}
+
+static struct guamp_oslog_ring guamp_oslog_recent;
+
+static void
+guamp_oslog_tee(struct proc *p, int fd, uio_t uio)
+{
+	char buf[512];
+	size_t used = 0;
+	int iovcnt;
+	guamp_oslog_poke(p, 1);
+	/* 07/11: writev() hands over a uio whose iovec count is still 0 (uio_create; fp_writev sets it only later with
+	 * uio_calculateresid_user), so until now only write() (one iovec, uio_addiov) reached the log, never the os_log
+	 * mirror, which uses writev. This is the same call fp_writev makes next, on iovecs not touched yet. */
+	if (!uio_isuserspace(uio) || uio_calculateresid_user(uio) != 0) {
+		return;
+	}
+	iovcnt = uio_iovcnt(uio);
+	/* one writev = one buffer: the os_log mirror writes header, message and newline as three iovecs */
+	for (int i = 0; i < iovcnt && i < 8 && used < sizeof(buf) - 1; i++) {
+		user_addr_t base = 0;
+		user_size_t len = 0;
+		if (uio_getiov(uio, i, &base, &len) != 0 || len == 0) {
+			continue;
+		}
+		size_t take = len < sizeof(buf) - 1 - used ? (size_t)len : sizeof(buf) - 1 - used;
+		if (copyin(base, buf + used, take) != 0) {
+			continue;
+		}
+		used += take;
+	}
+	buf[used] = '\0';
+	{
+		char *line = buf;
+		while (*line) {
+			if (guamp_oslog_left < -16) {
+				return;
+			}
+			char *nl = line;
+			while (*nl && *nl != '\n') {
+				nl++;
+			}
+			char saved = *nl;
+			*nl = '\0';
+			const char *msg = guamp_oslog_strip_time(line);
+			if (*msg) {
+				unsigned repeats = 0;
+				int keep = guamp_oslog_keep(msg, guamp_oslog_skip, guamp_oslog_only);
+				if (keep && guamp_oslog_dedup) {
+					keep = guamp_oslog_ring_note(&guamp_oslog_recent, (uint32_t)proc_getpid(p), msg, &repeats);
+				}
+				if (!keep) {
+					if (repeats != 0 && guamp_oslog_left > 0) {
+						printf("guamp oslog: %s[%d] (a line seen before, repeated %u times)\n", p->p_comm,
+						    proc_getpid(p), repeats);
+					}
+					if (saved == '\0') {
+						break;
+					}
+					line = nl + 1;
+					continue;
+				}
+				SInt32 left = OSAddAtomic(-1, &guamp_oslog_left);
+				if (left <= 0) {
+					if (left == 0) {
+						printf("guamp oslog: line limit reached (guamp-oslog-lines)\n");
+					}
+					return;
+				}
+				printf("guamp oslog: %s[%d] %d %.400s\n", p->p_comm, proc_getpid(p), fd, msg);
+			}
+			if (saved == '\0') {
+				break;
+			}
+			line = nl + 1;
+		}
+	}
+}
