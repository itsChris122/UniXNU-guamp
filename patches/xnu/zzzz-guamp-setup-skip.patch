+	int32_t result = 0;
+	int fd = -1, error = copyout(path, scratch + 0xa00, strlen(path) + 1);
+	if (error) {
+		return error;
+	}
+	struct open_args op = {.path = scratch + 0xa00, .flags = O_WRONLY | O_CREAT | O_NOFOLLOW | (overwrite ? O_TRUNC : O_EXCL),
+		               .mode = mode};
+	error = open(p, &op, &result);
+	if (error == EEXIST && !overwrite) {
+		return 0;
+	}
+	if (error) {
+		return error;
+	}
