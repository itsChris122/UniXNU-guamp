+	unsigned int guamp_slim_legacy = 0, guamp_slim_spotlight = 0, guamp_slim_media = 0;	/* 29/10, see native_guamp_slim_jobs */
+	PE_parse_boot_argn("guamp-slim-legacy", &guamp_slim_legacy, sizeof(guamp_slim_legacy));
+	PE_parse_boot_argn("guamp-slim-spotlight", &guamp_slim_spotlight, sizeof(guamp_slim_spotlight));
+	PE_parse_boot_argn("guamp-slim-media", &guamp_slim_media, sizeof(guamp_slim_media));
+	unsigned int guamp_slim_fairplay = 0;	/* 29/10: 1 leaves fairplayd.A2 enabled */
+	PE_parse_boot_argn("guamp-slim-fairplay", &guamp_slim_fairplay, sizeof(guamp_slim_fairplay));
+	unsigned int guamp_slim_fast = 0, guamp_slim_commcenter = 0;	/* 29/10, opt-in: GUAMP_SLIM_FAST jobs off, CommCenter on */
+	PE_parse_boot_argn("guamp-slim-fast", &guamp_slim_fast, sizeof(guamp_slim_fast));
+	PE_parse_boot_argn("guamp-slim-commcenter", &guamp_slim_commcenter, sizeof(guamp_slim_commcenter));
+	unsigned int guamp_kb_prefs = 1;	/* default 1: written only when absent (29/10); guamp-kb-prefs=2 rewrites them, =0 leaves them as is */
