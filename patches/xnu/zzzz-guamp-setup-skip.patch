+		} else if (error == ENOENT) {
+			absent++;
+			printf("guamp-ui-cache: cycle %u absent %s\n", cycle, paths[i]);
+			error = 0;
+		} else {
+			printf("guamp-ui-cache: cycle %u archive failed %d at %s; old backup never overwritten\n", cycle, error, paths[i]);
+			break;
+		}
+	}
+	if (!error) {
+		static const uint8_t note[] = "Cache invalidation completed before launchd; regeneration must be verified separately.\n";
+		error = native_guamp_write_file(p, scratch, marker, note, sizeof(note) - 1, 0, 0600, 0);
+	}
+	printf("guamp-ui-cache: cycle %u archived %u absent %u error %d; regeneration not yet verified\n",
+	    cycle, archived, absent, error);
+	native_guamp_ui_cache_archived = archived;
+	native_guamp_ui_cache_absent = absent;
+	native_guamp_ui_cache_error = error;
+	native_guamp_ui_cache_completed = !error;
+}
