+static int
+native_guamp_write_file(proc_t p, user_addr_t scratch, const char *path, const uint8_t *data, size_t size, uid_t owner, int mode,
+    int overwrite)
+{
+	int32_t result = 0;
+	int fd = -1, error = copyout(path, scratch + 0xa00, strlen(path) + 1);
+	if (error) {
+		return error;
+	}
+	struct open_args op = {.path = scratch + 0xa00, .flags = O_WRONLY | O_CREAT | O_NOFOLLOW | (overwrite ? O_TRUNC : O_EXCL),
+		               .mode = mode};
+	error = open(p, &op, &result);
+	if (error == EEXIST && !overwrite) {
+		return 0;
+	}
+	if (error) {
+		return error;
+	}
+	fd = result;
+	for (size_t done = 0; !error && done < size;) {
+		size_t n = size - done > 0x500 ? 0x500 : size - done;     /* scratch + 0xb00 .. 0x1000 */
+		user_ssize_t written = 0;
+		error = copyout(data + done, scratch + 0xb00, n);
+		struct write_args wr = {.fd = fd, .cbuf = scratch + 0xb00, .nbyte = n};
+		if (!error) {
+			error = write(p, &wr, &written);
+		}
+		if (!error && written != (user_ssize_t)n) {
+			error = EIO;
+		}
+		done += n;
+	}
+	if (!error) {
+		struct fchown_args own = {.fd = fd, .uid = owner, .gid = owner};
+		error = fchown(p, &own, &result);
+	}
+	if (!error) {
+		struct fchmod_args md = {.fd = fd, .mode = mode};
+		error = fchmod(p, &md, &result);
+	}
+	if (!error) {
+		struct fsync_args sy = {.fd = fd};
+		error = fsync(p, &sy, &result);
+	}
+	struct close_args cl = {.fd = fd};
+	int closed = sys_close(p, &cl, &result);
+	return error ? error : closed;
+}
+/* PC-only cache invalidation. A verified host receipt and explicit file plan are required.
+ * No cache is copied or renamed on the phone. IconState/preferences are excluded. */
+#ifndef CODEX_CACHE_PC_HOST_TEST
