+	for (size_t i = 0; i < sizeof(native_guamp_setup_files) / sizeof(native_guamp_setup_files[0]); i++) {
+		const uint8_t *data = native_guamp_setup_files[i].data;
+		size_t size = native_guamp_setup_files[i].size;
+		if ((data == native_guamp_kbprefs || data == native_guamp_dictprefs) && !guamp_kb_prefs) {
+			printf("guamp-kb-prefs=0: %s left as is\n", native_guamp_setup_files[i].path);
+			continue;
+		}
+		if (guamp_slim && data == native_guamp_disabled) {
+			int list = guamp_slim == 2 ? GUAMP_SLIM_BT : guamp_slim_legacy == 1 ? GUAMP_SLIM_LEGACY : GUAMP_SLIM_NOW;
+			int skip = list == GUAMP_SLIM_NOW ? (guamp_slim_spotlight == 1 ? GUAMP_SLIM_SPOTLIGHT : 0) |
+			    (guamp_slim_media == 1 ? GUAMP_SLIM_MEDIA : 0) | (guamp_slim_fairplay == 1 ? GUAMP_SLIM_FAIRPLAY : 0) |
+			    (guamp_slim_commcenter == 1 ? GUAMP_SLIM_COMMCENTER : 0) : 0;
+			int fast = list == GUAMP_SLIM_NOW && guamp_slim_fast == 1;
+			size_t built = native_guamp_slim_build(list | (fast ? GUAMP_SLIM_FAST : 0), skip);
+			printf("guamp-slim-fast=%d, guamp-slim-commcenter=%d (CommCenter %s)\n", fast, (skip & GUAMP_SLIM_COMMCENTER) ? 1 : 0,
+			    (skip & GUAMP_SLIM_COMMCENTER) ? "enabled" : "disabled");
+			if (built) {
+				data = (const uint8_t *)native_guamp_slim_plist;
+				size = built;
+			}
+			printf("guamp-slim=%u: launchd disabled list with %s (%s, spotlight %s, media %s, fairplayd %s, %zu bytes)\n", guamp_slim,
+			    guamp_slim == 2 ? "services + bluetoothd" : "services", list == GUAMP_SLIM_NOW ? "29/10 list" : "27/10 list",
+			    (skip & GUAMP_SLIM_SPOTLIGHT) ? "on" : "off", (skip & GUAMP_SLIM_MEDIA) ? "on" : "off",
+			    (list == GUAMP_SLIM_NOW && !(skip & GUAMP_SLIM_FAIRPLAY)) ? "off" : "on", built);
+		}
+		if (guamp_migration_rerun == 1 && strcmp(native_guamp_setup_files[i].path, "/private/var/mobile/Library/Preferences/com.apple.migration.plist") == 0) {
+			int32_t result = 0;
+			int mig_error = copyout(native_guamp_setup_files[i].path, scratch + 0xa00, strlen(native_guamp_setup_files[i].path) + 1);
+			if (!mig_error) {
+				struct unlink_args ua = {.path = scratch + 0xa00};
+				mig_error = unlink(p, &ua, &result);
+			}
+			printf("guamp-migration-rerun: %s removed, status %d\n", native_guamp_setup_files[i].path, mig_error);
+			continue;
+		}
