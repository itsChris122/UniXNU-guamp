+	    SecureDTGetProperty(chosen, "ui-home-reset-receipt", &receipt, &receipt_size) != kSuccess ||
+	    receipt_size != 65 || ((const char *)receipt)[64] != 0 ||
+	    SecureDTGetProperty(chosen, "ui-home-reset-files", &plan, &plan_size) != kSuccess ||
+	    !plan_size || plan_size > 4096) {
+		native_guamp_home_reset_error = EINVAL;
+		printf("guamp-home-reset: missing PC backup receipt/plan; no files changed\n");
+		return;
+	}
+	for (unsigned i = 0; i < 64; i++) {
+		char c = ((const char *)receipt)[i];
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+			native_guamp_home_reset_error = EINVAL;
+			return;
+		}
+	}
+	const char *start = plan, *end = start + plan_size;
+	unsigned count = 0;
+	for (const char *s = start; s < end;) {
+		size_t n = strnlen(s, (size_t)(end - s));
+		if (!n || n >= (size_t)(end - s) || n >= 512 || ++count > 6 || !native_guamp_home_reset_allowed(s)) {
+			native_guamp_home_reset_error = EINVAL;
+			printf("guamp-home-reset: invalid plan; no files changed\n");
+			return;
+		}
+		s += n + 1;
+	}
+	char marker[128];
+	snprintf(marker, sizeof(marker), "/private/var/db/codex-home-reset-%u.done", cycle);
+	int error = native_guamp_ui_pc_done(p, scratch, marker);
+	if (error == EEXIST) { native_guamp_home_reset_completed = 1; return; }
+	if (error != ENOENT) { native_guamp_home_reset_error = error; return; }
+	for (const char *s = start; s < end;) {
+		size_t n = strlen(s);
+		error = copyout(s, scratch + 0xa00, n + 1);
+		if (!error) {
+			int32_t result = 0;
+			struct unlink_args ua = {.path = scratch + 0xa00};
+			error = unlink(p, &ua, &result);
+		}
+		if (!error) native_guamp_home_reset_deleted++;
+		else if (error == ENOENT) { native_guamp_home_reset_absent++; error = 0; }
+		printf("guamp-home-reset: %s status %d\n", s, error);
+		if (error) break;
+		s += n + 1;
+	}
+	if (!error) {
+		static const uint8_t note[] = "Home reset complete. Original files backed up on PC.\n";
+		error = native_guamp_write_file(p, scratch, marker, note, sizeof(note) - 1, 0, 0600, 0);
+	}
+	native_guamp_home_reset_error = error;
+	native_guamp_home_reset_completed = !error;
