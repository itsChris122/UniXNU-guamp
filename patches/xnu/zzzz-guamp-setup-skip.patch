+uint32_t native_guamp_ui_cache_cycle_id, native_guamp_ui_cache_deleted,
+    native_guamp_ui_cache_absent, native_guamp_ui_cache_error, native_guamp_ui_cache_completed;
+static int
+native_guamp_ui_pc_done(proc_t p, user_addr_t scratch, const char *path)
+{
+	int32_t result = 0;
+	int error = copyout(path, scratch + 0xa00, strlen(path) + 1);
+	if (error) return error;
+	struct open_args op = {.path = scratch + 0xa00, .flags = O_RDONLY | O_NOFOLLOW, .mode = 0};
+	error = open(p, &op, &result);
+	if (!error) {
+		struct close_args cl = {.fd = result};
+		int32_t closed = 0;
+		error = sys_close(p, &cl, &closed);
+		return error ? error : EEXIST;
+	}
+	return error;
+}
+static bool
+native_guamp_ui_pc_allowed(const char *path)
+{
+	static const char *const bases[] = {
+		"/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist",
+		"/private/var/mobile/Library/Preferences/com.apple.MobileGestalt.plist",
+		"/private/var/mobile/Library/Preferences/com.apple.mobilegestalt.plist",
+		"/private/var/mobile/Library/Caches/com.apple.springboard",
+		"/private/var/mobile/Library/Caches/com.apple.SpringBoard",
+		"/private/var/mobile/Library/Caches/com.apple.UIStatusBar",
+		"/private/var/mobile/Library/Caches/com.apple.controlcenter",
+	};
+	for (const char *part = path; *part; part++) {
+		if ((part[0] == '.' && part[1] == '.') || !strncmp(part, "IconState", 9)) return false;
+	}
+	for (size_t i = 0; i < sizeof(bases) / sizeof(bases[0]); i++) {
+		size_t n = strlen(bases[i]);
+		if (!strncmp(path, bases[i], n) &&
+		    (path[n] == 0 || path[n] == '/' || !strncmp(path + n, ".codex-ui-slot-", 15))) return true;
+	}
+	return false;
+}
+static void
+native_guamp_ui_cache_cycle(proc_t p, user_addr_t scratch)
+{
+	unsigned cycle = 0;
+	if (!PE_parse_boot_argn("guamp-ui-cache-pc", &cycle, sizeof(cycle)) || !cycle) return;
+	native_guamp_ui_cache_cycle_id = cycle;
+	DTEntry chosen;
+	const void *receipt = NULL, *plan = NULL;
+	unsigned receipt_size = 0, plan_size = 0;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "ui-cache-pc-receipt", &receipt, &receipt_size) != kSuccess || receipt_size != 65 ||
+	    ((const char *)receipt)[64] != 0 ||
+	    SecureDTGetProperty(chosen, "ui-cache-pc-files", &plan, &plan_size) != kSuccess || !plan_size || plan_size > 8192) {
+		native_guamp_ui_cache_error = EINVAL;
+		printf("guamp-ui-cache-PC: missing host backup receipt/plan; no files changed\n");
+		return;
+	}
+	for (unsigned i = 0; i < 64; i++) {
+		char c = ((const char *)receipt)[i];
+		if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
+			native_guamp_ui_cache_error = EINVAL;
+			return;
+		}
+	}
+	const char *start = plan, *end = start + plan_size;
+	unsigned count = 0;
+	for (const char *s = start; s < end;) {
+		size_t n = strnlen(s, (size_t)(end - s));
+		if (!n || n >= (size_t)(end - s) || n >= 512 || ++count > 64 || !native_guamp_ui_pc_allowed(s)) {
+			native_guamp_ui_cache_error = EINVAL;
+			printf("guamp-ui-cache-PC: invalid file plan; no files changed\n");
+			return;
+		}
+		s += n + 1;
+	}
+	char marker[128];
+	snprintf(marker, sizeof(marker), "/private/var/db/codex-ui-cache-pc-%u.done", cycle);
+	int error = native_guamp_ui_pc_done(p, scratch, marker);
+	if (error == EEXIST) { native_guamp_ui_cache_completed = 1; return; }
+	if (error != ENOENT) { native_guamp_ui_cache_error = error; return; }
+	for (const char *s = start; s < end;) {
+		size_t n = strlen(s);
+		error = copyout(s, scratch + 0xa00, n + 1);
+		if (!error) {
+			int32_t result = 0;
+			struct unlink_args ua = {.path = scratch + 0xa00};
+			error = unlink(p, &ua, &result);
+		}
+		if (!error) native_guamp_ui_cache_deleted++;
+		else if (error == ENOENT) { native_guamp_ui_cache_absent++; error = 0; }
+		printf("guamp-ui-cache-PC: %s status %d\n", s, error);
+		if (error) break;
+		s += n + 1;
+	}
+	if (!error) {
+		static const uint8_t note[] = "PC backup receipt supplied; file invalidation complete.\n";
+		error = native_guamp_write_file(p, scratch, marker, note, sizeof(note) - 1, 0, 0600, 0);
+	}
+	native_guamp_ui_cache_error = error;
+	native_guamp_ui_cache_completed = !error;
+}
