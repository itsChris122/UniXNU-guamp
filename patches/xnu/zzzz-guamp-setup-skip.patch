+static void
+native_guamp_setup_skip(proc_t p, user_addr_t scratch)
+{
+	native_guamp_home_reset(p, scratch);
+	/* powerd (iOS 17) keeps its battery health record (service state and flags, maximum capacity, serial) in the
+	 * com.apple.batteryhealthdata domain under /var/MobileSoftwareUpdate/Hardware/Battery; cfprefsd refused every write
+	 * with "Directory needed" (log 28/10) because the Data volume has no such tree. */
+	static const char *const dirs[] = {"/private/var/db/com.apple.xpc.launchd", "/private/var/MobileSoftwareUpdate",
+	    "/private/var/MobileSoftwareUpdate/Hardware", "/private/var/MobileSoftwareUpdate/Hardware/Battery",
+	    "/private/var/MobileSoftwareUpdate/Hardware/Battery/Library",
+	    "/private/var/MobileSoftwareUpdate/Hardware/Battery/Library/Preferences"};
