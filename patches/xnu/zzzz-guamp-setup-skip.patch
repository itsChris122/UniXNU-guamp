+/* Explicit Home/Control Center reset requested by the owner. Separate from
+ * routine cache invalidation. Exact files only, after verified PC backup.
+ * Invoked before setup skip reseeds its minimal watchdog/setup preferences. */
+uint32_t native_guamp_home_reset_id, native_guamp_home_reset_deleted,
+    native_guamp_home_reset_absent, native_guamp_home_reset_error, native_guamp_home_reset_completed;
+static bool
+native_guamp_home_reset_allowed(const char *path)
+{
+	static const char *const files[] = {
+		"/private/var/mobile/Library/SpringBoard/IconState.plist",
+		"/private/var/mobile/Library/SpringBoard/DesiredIconState.plist",
+		"/private/var/mobile/Library/Preferences/com.apple.springboard.plist",
+		"/private/var/mobile/Library/Preferences/com.apple.controlcenter.plist",
+		"/private/var/mobile/Library/Preferences/com.apple.control-center.plist",
+		"/private/var/mobile/Library/ControlCenter/ModuleConfiguration.plist",
+	};
+	for (size_t i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+		if (!strcmp(path, files[i])) return true;
+	}
+	return false;
+}
+static void
+native_guamp_home_reset(proc_t p, user_addr_t scratch)
+{
+	unsigned cycle = 0;
+	if (!PE_parse_boot_argn("guamp-home-reset", &cycle, sizeof(cycle)) || !cycle) return;
+	native_guamp_home_reset_id = cycle;
+	DTEntry chosen;
+	const void *receipt = NULL, *plan = NULL;
+	unsigned receipt_size = 0, plan_size = 0;
