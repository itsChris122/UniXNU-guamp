+			printf("guamp: setup skip: %s: error %d\n", native_guamp_setup_files[i].path, error);
+		} else {
+			native_guamp_setup_written++;
+		}
+	}
+	/* guamp-mg-reset=1 (owner request 27/10): remove the MobileGestalt cache once so it is rebuilt with the
+	 * current ADT (e.g. the ringer switch). Counted in the periodic GuampUi line (deleted/absent). */
+	unsigned int guamp_mg_reset = 0;
+	PE_parse_boot_argn("guamp-mg-reset", &guamp_mg_reset, sizeof(guamp_mg_reset));
+	/* guamp-mg-adt-sync (default 1, =0 off; analisi/wifi/IMPOSTAZIONI-WIFI-20261029.md): MobileGestalt keeps the
+	 * capabilities it derives from the ADT in its cache (CacheData: "wifi" and "wi-fi" were cached false before
+	 * /chosen/mac-address-wifi0 existed, so Settings has no Wi-Fi row). The cache is invalidated once for each set of
+	 * those ADT properties: a stamp of them names a marker under /private/var/db; no marker, one reset. */
+	unsigned int guamp_mg_adt_sync = 1;
+	char mg_marker[64] = "";
+	PE_parse_boot_argn("guamp-mg-adt-sync", &guamp_mg_adt_sync, sizeof(guamp_mg_adt_sync));
+	if (guamp_mg_adt_sync && guamp_mg_reset != 1) {
+		static const char *const props[][2] = {
+			{"/chosen", "mac-address-wifi0"}, {"/chosen", "mac-address-bluetooth0"}, {"/product", "product-id"},
+			{"/product", "wifi-chipset"}, {"/product", "bluetooth-le"}, {"/arm-io/wlan", "local-mac-address"},
+		};
+		uint32_t stamp = 2166136261u;           /* FNV-1a over name, size and bytes of each property */
+		for (size_t i = 0; i < sizeof(props) / sizeof(props[0]); i++) {
+			DTEntry node;
+			const void *value = NULL;
+			unsigned size = 0;
+			const char *name = props[i][1];
+			if (SecureDTLookupEntry(NULL, props[i][0], &node) != kSuccess ||
+			    SecureDTGetProperty(node, name, &value, &size) != kSuccess) {
+				value = NULL;
+				size = 0;
+			}
+			for (const char *c = name; *c; c++) stamp = (stamp ^ (uint8_t)*c) * 16777619u;
+			stamp = (stamp ^ size) * 16777619u;
+			for (unsigned j = 0; j < size && j < 64; j++) stamp = (stamp ^ ((const uint8_t *)value)[j]) * 16777619u;
+		}
+		snprintf(mg_marker, sizeof(mg_marker), "/private/var/db/guamp-mg-adt-%08x.done", stamp);
+		int marked = native_guamp_ui_pc_done(p, scratch, mg_marker);
+		if (marked == ENOENT) {
+			printf("guamp-mg-adt-sync: ADT capabilities %08x are new: MobileGestalt cache reset once\n", stamp);
+			guamp_mg_reset = 1;
+		} else {
+			mg_marker[0] = 0;
+		}
+	}
+	if (guamp_mg_reset == 1) {
+		static const char *const mg[] = {
+			"/private/var/containers/Shared/SystemGroup/systemgroup.com.apple.mobilegestaltcache/Library/Caches/com.apple.MobileGestalt.plist",
+			"/private/var/mobile/Library/Preferences/com.apple.MobileGestalt.plist",
+			"/private/var/mobile/Library/Preferences/com.apple.mobilegestalt.plist",
+		};
+		for (size_t i = 0; i < sizeof(mg) / sizeof(mg[0]); i++) {
+			int32_t result = 0;
+			int mg_error = copyout(mg[i], scratch + 0xa00, strlen(mg[i]) + 1);
+			if (!mg_error) {
+				struct unlink_args ua = {.path = scratch + 0xa00};
+				mg_error = unlink(p, &ua, &result);
+			}
+			if (!mg_error) native_guamp_ui_cache_deleted++;
+			else if (mg_error == ENOENT) native_guamp_ui_cache_absent++;
+			else native_guamp_ui_cache_error = mg_error;
+			printf("guamp-mg-reset: %s status %d\n", mg[i], mg_error);
+		}
+		if (mg_marker[0]) {
+			static const uint8_t note[] = "MobileGestalt cache reset for these ADT capabilities.\n";
+			int marker_error = native_guamp_write_file(p, scratch, mg_marker, note, sizeof(note) - 1, 0, 0600, 0);
+			printf("guamp-mg-adt-sync: marker %s status %d\n", mg_marker, marker_error);
+		}
+	}
+	/* guamp-home-layout-reset=1 (owner request 27/10): SpringBoard rebuilds the default Home layout. */
+	unsigned int guamp_home_layout_reset = 0;
+	PE_parse_boot_argn("guamp-home-layout-reset", &guamp_home_layout_reset, sizeof(guamp_home_layout_reset));
+	if (guamp_home_layout_reset == 1) {
+		static const char *const home[] = {
+			"/private/var/mobile/Library/SpringBoard/IconState.plist",
+			"/private/var/mobile/Library/SpringBoard/DesiredIconState.plist",
+		};
+		for (size_t i = 0; i < sizeof(home) / sizeof(home[0]); i++) {
+			int32_t result = 0;
+			int home_error = copyout(home[i], scratch + 0xa00, strlen(home[i]) + 1);
+			if (!home_error) {
+				struct unlink_args ua = {.path = scratch + 0xa00};
+				home_error = unlink(p, &ua, &result);
+			}
+			if (!home_error) native_guamp_ui_cache_deleted++;
+			else if (home_error == ENOENT) native_guamp_ui_cache_absent++;
+			else native_guamp_ui_cache_error = home_error;
+			printf("guamp-home-layout-reset: %s status %d\n", home[i], home_error);
+		}
+	}
+	/* Preserve MobileGestalt answers. Identity experiments must back up and invalidate
+	 * the specific cache explicitly; never delete it as part of every boot. */
+	printf("guamp: MobileGestalt cache preserved (automatic removal disabled)\n");
+	native_guamp_ui_cache_cycle(p, scratch);
+	printf("guamp: setup skip: %d files written, last error %d\n", native_guamp_setup_written, native_guamp_setup_error);
+}
