+/* Builds the disabled.plist of one list (same XML layout as the stock array), skipping the opt-in groups in skip. Returns its size,
+ * 0 if it did not fit (the caller then keeps the stock list). */
+static size_t
+native_guamp_slim_build(int list, int skip)
+{
+	static const char head[] = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n";
+	size_t used = strlcpy(native_guamp_slim_plist, head, sizeof(native_guamp_slim_plist));
+	for (size_t i = 0; i < sizeof(native_guamp_slim_jobs) / sizeof(native_guamp_slim_jobs[0]); i++) {
+		if (!(native_guamp_slim_jobs[i].lists & list) || (native_guamp_slim_jobs[i].lists & skip)) {
+			continue;
+		}
+		int n = snprintf(native_guamp_slim_plist + used, sizeof(native_guamp_slim_plist) - used, "\t<key>%s</key>\n\t<%s/>\n",
+		    native_guamp_slim_jobs[i].label, native_guamp_slim_jobs[i].disabled ? "true" : "false");
+		if (n < 0 || (size_t)n >= sizeof(native_guamp_slim_plist) - used) {
+			return 0;
+		}
+		used += (size_t)n;
+	}
+	if (strlcat(native_guamp_slim_plist, "</dict>\n</plist>\n", sizeof(native_guamp_slim_plist)) >= sizeof(native_guamp_slim_plist)) {
+		return 0;
+	}
+	return strlen(native_guamp_slim_plist);
