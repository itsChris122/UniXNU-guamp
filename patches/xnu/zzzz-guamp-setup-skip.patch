+		struct write_args wr = {.fd = fd, .cbuf = scratch + 0xb00, .nbyte = n};
+		if (!error) {
+			error = write(p, &wr, &written);
+		}
+		if (!error && written != (user_ssize_t)n) {
+			error = EIO;
+		}
+		done += n;
+	}
+	if (!error) {
+		struct fchown_args own = {.fd = fd, .uid = owner, .gid = owner};
+		error = fchown(p, &own, &result);
+	}
+	if (!error) {
+		struct fchmod_args md = {.fd = fd, .mode = mode};
+		error = fchmod(p, &md, &result);
+	}
+	if (!error) {
+		struct fsync_args sy = {.fd = fd};
+		error = fsync(p, &sy, &result);
+	}
+	struct close_args cl = {.fd = fd};
