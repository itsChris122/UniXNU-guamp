+/* guamp-ls-auto (owner 29/10, default 1): rebuilds the LaunchServices databases by itself when the apps of the /Applications view
+ * may have become stale for lsd, instead of needing a new guamp-ls-rebuild=N cycle with every new image (Phone and Wallet vanished
+ * from the Home Screen in fin6 and fin8). lsd registers the view's apps only when it seeds its database; afterwards it knows them by
+ * file system node, and the bindfs view reports as st_dev its own fsid, which vfs_getnewfsid hands out from a boot-wide counter of
+ * mounts: a kernel or argument set that mounts one view more or less before /Applications gives the same apps another st_dev, and
+ * an addon with new or changed apps gives lsd bundles it never registered. The key /private/var/db/guamp-ls-auto.key holds the
+ * view's fsid and a hash of the addon entries below iphone-res/Applications/ (names, modes, sizes, compressed bytes; a boot without
+ * the addon keeps the stored hash). When the key differs, the csstores are deleted exactly as guamp-ls-rebuild does (lsd rebuilds
+ * them at its first start; a long boot only then) and the new key is written. A guamp-ls-rebuild cycle that ran in the same boot
+ * only refreshes the key. guamp-ls-auto=0 disables it, guamp-ls-auto=2 rebuilds at every boot. Never panics. */
+uint32_t native_guamp_ls_auto_rebuilt, native_guamp_ls_auto_deleted, native_guamp_ls_auto_entries;
+int native_guamp_ls_auto_error = -1;
+static uint64_t
+native_guamp_ls_auto_fnv(uint64_t hash, const uint8_t *data, uint64_t size)
+{
+	for (uint64_t i = 0; i < size; i++) {
+		hash = (hash ^ data[i]) * 0x100000001b3ULL;
+	}
+	return hash;
+}
+static uint64_t
+native_guamp_ls_auto_apps_hash(uint32_t *entries)
+{
+	static const char prefix[] = "iphone-res/Applications/";
+	const uint8_t *addon = NULL;
+	uint64_t bytes = 0, hash = 0xcbf29ce484222325ULL, at = 24;
+	uint32_t count = 0;
+	*entries = 0;
+	if (!native_ram_block_gpu_addon || !native_ram_block_gpu_addon(&addon, &bytes) || bytes < 24 || memcmp(addon, "NGPUADD2", 8)) {
+		return 0;
+	}
+	memcpy(&count, addon + 8, 4);
+	for (uint32_t i = 0; i < count && count <= 4096; i++) {
+		uint32_t name_bytes = 0;
+		uint64_t packed = 0;
+		if (bytes - at < 24) {
+			return 0;
+		}
+		memcpy(&name_bytes, addon + at, 4);
+		memcpy(&packed, addon + at + 16, 8);
+		uint64_t name_padded = (name_bytes + 7) & ~7ULL, packed_padded = (packed + 7) & ~7ULL;
+		if (name_bytes > 160 || packed > INT32_MAX || bytes - at - 24 < name_padded || bytes - at - 24 - name_padded < packed_padded) {
+			return 0;
+		}
+		const char *name = (const char *)(addon + at + 24);
+		if (name_bytes > sizeof(prefix) && !strncmp(name, prefix, sizeof(prefix) - 1)) {
+			hash = native_guamp_ls_auto_fnv(hash, addon + at, 24 + (uint64_t)name_bytes);
+			hash = native_guamp_ls_auto_fnv(hash, addon + at + 24 + name_padded, packed);
+			*entries = *entries + 1;
+		}
+		at += 24 + name_padded + packed_padded;
+	}
+	return *entries ? hash : 0;
+}
+/* The deletion of guamp-ls-rebuild (same containers, same name pattern), without its cycle marker. */
+static int
+native_guamp_ls_auto_delete(proc_t p, user_addr_t scratch, uint32_t *deleted)
+{
+	static const char base[] = "/private/var/mobile/Containers/Data/InternalDaemon";
+	char (*containers)[64] = kalloc_data(NATIVE_GUAMP_LS_MAX * 64, Z_WAITOK | Z_ZERO);
+	char (*files)[64] = kalloc_data(NATIVE_GUAMP_LS_MAX * 64, Z_WAITOK | Z_ZERO);
+	char *path = kalloc_data(256, Z_WAITOK | Z_ZERO);
+	uint32_t n_containers = 0;
+	int error = containers && files && path ? 0 : ENOMEM;
+	if (!error) {
+		error = native_guamp_dir_names(base, DT_DIR, containers, NATIVE_GUAMP_LS_MAX, &n_containers);
+		if (error == ENOENT) {
+			error = 0;	/* no lsd container yet: lsd seeds a fresh database anyway */
+		}
+	}
+	for (uint32_t c = 0; !error && c < n_containers; c++) {
+		uint32_t n_files = 0;
+		snprintf(path, 256, "%s/%s/Library/Caches", base, containers[c]);
+		if (native_guamp_dir_names(path, DT_REG, files, NATIVE_GUAMP_LS_MAX, &n_files)) {
+			continue;
+		}
+		for (uint32_t f = 0; f < n_files; f++) {
+			if (!native_guamp_ls_store_match(files[f])) {
+				continue;
+			}
+			snprintf(path, 256, "%s/%s/Library/Caches/%s", base, containers[c], files[f]);
+			struct unlink_args request = {.path = scratch + 0xa00};
+			int32_t result = 0;
+			int unlink_error = copyout(path, request.path, strlen(path) + 1);
+			if (!unlink_error) {
+				unlink_error = unlink(p, &request, &result);
+			}
+			if (!unlink_error) {
+				*deleted = *deleted + 1;
+			} else if (unlink_error != ENOENT) {
+				error = unlink_error;
+			}
+			printf("guamp-ls-auto: %s status %d\n", path, unlink_error);
+		}
+	}
+	if (containers) {
+		kfree_data(containers, NATIVE_GUAMP_LS_MAX * 64);
+	}
+	if (files) {
+		kfree_data(files, NATIVE_GUAMP_LS_MAX * 64);
+	}
+	if (path) {
+		kfree_data(path, 256);
+	}
+	return error;
+}
+static void
+native_guamp_ls_auto(proc_t p, user_addr_t scratch)
+{
+	static const char key_path[] = "/private/var/db/guamp-ls-auto.key";
+	uint32_t mode = 1;
+	if (PE_parse_boot_argn("guamp-ls-auto", &mode, sizeof(mode)) && !mode) {
+		printf("guamp-ls-auto: off (guamp-ls-auto=0)\n");
+		return;
+	}
+	size_t view = sizeof(native_guamp_iphone_res) / sizeof(native_guamp_iphone_res[0]);
+	for (size_t i = 0; i < sizeof(native_guamp_iphone_res) / sizeof(native_guamp_iphone_res[0]); i++) {
+		if (!strcmp(native_guamp_iphone_res[i].point, "/Applications")) {
+			view = i;
+		}
+	}
+	if (view == sizeof(native_guamp_iphone_res) / sizeof(native_guamp_iphone_res[0]) || native_guamp_iphone_res_stage[view] != 5) {
+		printf("guamp-ls-auto: /Applications view not mounted, nothing to do\n");
+		return;
+	}
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup("/Applications", 0, &vp, ctx);
+	if (error) {
+		native_guamp_ls_auto_error = error;
+		printf("guamp-ls-auto: /Applications lookup error %d\n", error);
+		return;
+	}
+	fsid_t fsid = vfs_statfs(vnode_mount(vp))->f_fsid;
+	vnode_put(vp);
+	uint64_t hash = native_guamp_ls_auto_apps_hash(&native_guamp_ls_auto_entries);
+	char old[48], key[48];
+	memset(old, 0, sizeof(old));
+	vp = NULLVP;
+	if (!vnode_open(key_path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx)) {
+		int resid = 0;
+		if (vn_rdwr(UIO_READ, vp, (caddr_t)old, sizeof(old) - 1, 0, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid, p)) {
+			memset(old, 0, sizeof(old));
+		}
+		vnode_close(vp, FREAD, ctx);
+	}
+	/* "ffffffff ffffffff hhhhhhhhhhhhhhhh\n": 35 bytes */
+	snprintf(key, sizeof(key), "%08x %08x %016llx\n", (uint32_t)fsid.val[0], (uint32_t)fsid.val[1], (unsigned long long)hash);
+	if (!native_guamp_ls_auto_entries && strlen(old) == 35) {
+		memcpy(key + 18, old + 18, 18);	/* no addon this boot: the apps written before are unchanged */
+	}
+	int rebuild = mode == 2 || strcmp(old, key);
+	int already = native_guamp_ls_rebuild_deleted > 0;	/* guamp-ls-rebuild=N deleted the stores in this boot */
+	error = 0;
+	if (rebuild && !already) {
+		error = native_guamp_ls_auto_delete(p, scratch, &native_guamp_ls_auto_deleted);
+		native_guamp_ls_auto_rebuilt = !error;
+	}
+	if (!error && strcmp(old, key)) {
+		(void)native_guamp_mkdir(p, scratch, "/private/var/db");
+		vp = NULLVP;
+		error = vnode_open(key_path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, 0600, 0, &vp, ctx);
+		if (!error) {
+			int resid = 0;
+			error = vn_rdwr(UIO_WRITE, vp, (caddr_t)key, 35, 0, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT, vfs_context_ucred(ctx), &resid, p);
+			if (!error && resid) {
+				error = EIO;
+			}
+			if (!error) {
+				error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+			}
+			int close_error = vnode_close(vp, FWRITE, ctx);
+			error = error ? error : close_error;
+		}
+	}
+	native_guamp_ls_auto_error = error;
+	printf("guamp-ls-auto: key %.34s (stored %.34s), %u app entries, %s, %u deleted, status %d\n", key, old[0] ? old : "none",
+	    native_guamp_ls_auto_entries, !rebuild ? "unchanged" : already ? "rebuilt by guamp-ls-rebuild" : "rebuild",
+	    native_guamp_ls_auto_deleted, error);
+}
