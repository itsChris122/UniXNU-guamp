+/*
+ * guamp 06/11 (ag-perf-cpu): idle entries (WFI) per second of every core, the time spent in the pre-WFI cache flush when
+ * guamp-idle-flush=1 (osfmk/arm/caches.c), and where guamp-sched-amp / guamp-sched-rt-big put the threads.
+ */
+extern uint64_t guamp_idle_wfi[8];
+extern uint64_t guamp_idle_flush_mach[8];
+static uint64_t guamp_cpu_idle_last_wfi[8];
+static uint64_t guamp_cpu_idle_last_flush[8];
+static uint64_t guamp_cpu_idle_last_placed[4];
+
+static void
+guamp_cpu_idle_report(uint64_t span)
+{
+	char line[400];
+	uint64_t span_ns = 0;
+	absolutetime_to_nanoseconds(span, &span_ns);
+	if (span_ns < NSEC_PER_MSEC) {
+		return;
+	}
+	int len = scnprintf(line, sizeof(line), "GuampIdle: wfi/s, flush us/s per core:");
+	for (int cpu = 0; cpu < 8; cpu++) {
+		uint64_t w = guamp_idle_wfi[cpu], f = guamp_idle_flush_mach[cpu];
+		uint64_t dw = w - guamp_cpu_idle_last_wfi[cpu], df = f - guamp_cpu_idle_last_flush[cpu];
+		guamp_cpu_idle_last_wfi[cpu] = w;
+		guamp_cpu_idle_last_flush[cpu] = f;
+		uint64_t df_ns = 0;
+		absolutetime_to_nanoseconds(df, &df_ns);
+		len += scnprintf(line + len, sizeof(line) - (size_t)len, " c%d %llu/%llu", cpu,
+		    (unsigned long long)(dw * NSEC_PER_SEC / span_ns), (unsigned long long)(df_ns * 1000 / span_ns));
+	}
+	uint64_t placed[4] = { guamp_sched_amp_placed[0], guamp_sched_amp_placed[1], guamp_sched_rt_placed[0], guamp_sched_rt_placed[1] };
+	uint64_t d[4];
+	for (int i = 0; i < 4; i++) {
+		d[i] = placed[i] - guamp_cpu_idle_last_placed[i];
+		guamp_cpu_idle_last_placed[i] = placed[i];
+	}
+	printf("%s; idle picks silver/gold %llu/%llu, realtime silver/gold %llu/%llu\n", line,
+	    (unsigned long long)d[0], (unsigned long long)d[1], (unsigned long long)d[2], (unsigned long long)d[3]);
+}
