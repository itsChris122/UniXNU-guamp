--- a/osfmk/arm/caches.c
+++ b/osfmk/arm/caches.c
@@ -333,12 +333,38 @@ platform_cache_disable(void)
 {
 }
 
+/*
+ * guamp 06/11 (ag-perf-cpu): cpu_idle() calls this before every WFI on non-Apple cores. FlushPoU_Dcache passes
+ * CLIDR_EL1.LoUIS (1 on Cortex-A53/A73) to DCACHE_SET_WAY, whose level argument is 0-based and inclusive: every idle
+ * entry of any core cleaned and invalidated by set/way its L1 and the L2 it shares with the other three cores of the
+ * cluster (SM6115: 16384 lines of the 1 MB Gold L2). With ~1500 idle entries per second per core both L2s were wiped
+ * thousands of times per second and every core ran from DRAM, and the flush itself (tens of us) was counted as idle.
+ * The cores are cache coherent and plain WFI keeps L1 and L2 powered (no PSCI CPU_SUSPEND here: cpu offline and sleep
+ * clean the caches on their own paths), so nothing has to be written back before WFI.
+ *
+ * guamp-idle-flush=0 (default): no cache maintenance before WFI. =1: the original FlushPoU_Dcache (for A/B tests).
+ * guamp_idle_wfi[] counts the idle entries per core and guamp_idle_flush_mach[] the time spent flushing (GuampCore).
+ */
+#define GUAMP_IDLE_CPUS 8
+TUNABLE(uint32_t, guamp_idle_flush, "guamp-idle-flush", 0);
+uint64_t guamp_idle_wfi[GUAMP_IDLE_CPUS];
+uint64_t guamp_idle_flush_mach[GUAMP_IDLE_CPUS];
+
 void
 platform_cache_idle_enter(
 	void)
 {
 	platform_cache_disable();
 
+	unsigned int cpu = (unsigned int)getCpuDatap()->cpu_number;
+	if (cpu < GUAMP_IDLE_CPUS) {
+		guamp_idle_wfi[cpu]++;
+	}
+	if (!guamp_idle_flush) {
+		return;
+	}
+	uint64_t start = mach_absolute_time();
+
 	/*
 	 * If we're only using a single CPU, just write back any
 	 * dirty cachelines.  We can avoid doing housekeeping
@@ -350,6 +376,9 @@ platform_cache_idle_enter(
 	} else {
 		FlushPoU_Dcache();
 	}
+	if (cpu < GUAMP_IDLE_CPUS) {
+		guamp_idle_flush_mach[cpu] += mach_absolute_time() - start;
+	}
 }
 
