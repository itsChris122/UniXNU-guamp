+/*
+ * guamp 06/11 (ag-perf-cpu): placement by priority inside the single pset (definitions at the end of the file, after
+ * guamp-sched-big). pset->perfcontrol_cpu_preferred_bitmask holds the Gold cores (guamp-sched-big, default 0xf0).
+ * guamp-sched-amp=<base priority> (default 31 = BASEPRI_DEFAULT; 0 = off): an idle core is chosen in the Gold cluster
+ * first for threads at or above it (UI 47, user initiated 37, default 31, kernel threads, realtime), in the Silver
+ * cluster first for those below (utility 20, background 4, maintenance), so background work no longer takes the idle
+ * Gold cores that the next frame needs. Both stay work conserving: with no idle core of the preferred cluster the
+ * other cluster's idle cores are used. guamp-sched-rt-big=1 (default; 0 = off): realtime threads (render server,
+ * audio, display link), which the original code put on the lowest numbered idle core = always a Silver one, take an
+ * idle Gold core first.
+ */
+static uint32_t guamp_sched_amp_pri = BASEPRI_DEFAULT;
+static uint32_t guamp_sched_rt_big = 1;
+static uint64_t guamp_sched_amp_placed[2];   /* idle core chosen: [0] Silver, [1] Gold (GuampCore line) */
+static uint64_t guamp_sched_rt_placed[2];
+
+static inline uint64_t
+guamp_sched_amp_preferred(processor_set_t pset, thread_t thread)
+{
+	uint64_t big = pset->perfcontrol_cpu_preferred_bitmask;
+	if (big == 0 || guamp_sched_amp_pri == 0 || thread->base_pri >= (int)guamp_sched_amp_pri) {
+		return big;
+	}
+	return pset->cpu_bitmask & ~big;
+}
+
+static inline uint64_t
+guamp_sched_amp_avoided(processor_set_t pset, thread_t thread)
+{
+	uint64_t big = pset->perfcontrol_cpu_preferred_bitmask;
+	if (big == 0 || guamp_sched_amp_pri == 0 || thread->base_pri >= (int)guamp_sched_amp_pri) {
+		return pset->perfcontrol_cpu_migration_bitmask;
+	}
+	return big;
+}
