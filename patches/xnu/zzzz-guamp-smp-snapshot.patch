+/* guamp: bounded, read-only SMP evidence for the native CPU load logger. */
+uint32_t guamp_smp_signal_flags(unsigned int cpu);
+uint32_t
+guamp_smp_signal_flags(unsigned int cpu)
+{
+    if (cpu > (unsigned int)ml_get_max_cpu_number()) { return UINT32_MAX; }
+    cpu_data_t *data = CpuDataEntries[cpu].cpu_data_vaddr;
+    return data ? os_atomic_load(&data->cpu_signal, relaxed) : UINT32_MAX;
+}
