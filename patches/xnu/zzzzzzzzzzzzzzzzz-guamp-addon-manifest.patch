+/* Persistent addon (owner 29/10): what an addon writes into Data stays there (nothing below /private/var/ngpu is ever removed by
+ * a boot without that entry), and the views mount from Data's content whatever the boot payload carries. The manifest
+ * /private/var/ngpu/.guamp-manifest records, for every file written, its name, mode, size and a hash of its compressed addon bytes
+ * (FNV-1a 64, no inflate needed). An addon entry whose record matches and whose Data file still has that size and mode is counted
+ * "same" without being inflated or read back, so a boot that carries the whole addon no longer re-reads it all, and a "delta"
+ * addon (scripts/compose-guamp-delta-addon.py) only has to carry what changed. A delete entry (mode NATIVE_GPU_ADDON_DELETE,
+ * size 0) unlinks that regular file from Data and drops its record. An addon with no entries (24-byte header) is valid: nothing is
+ * written and every view still mounts. guamp-addon-reinstall=N (one shot, /private/var/db/guamp-addon-reinstall-N.done) ignores
+ * the manifest and rewrites every file of the addon even when equal; guamp-addon-manifest=0 ignores the manifest (old behaviour:
+ * compare every file). A missing or malformed manifest is treated as empty. Never panics. */
+#define NATIVE_GPU_ADDON_DELETE 0x10000u
+#define NATIVE_GPU_MANIFEST_MAX 4096
+struct native_gpu_manifest_record {
+	char name[160];
+	uint64_t hash;
+	uint64_t size;
+	uint32_t mode;
+	uint32_t used;
+};
+static const char native_gpu_manifest_path[] = "/private/var/ngpu/.guamp-manifest";
+volatile int native_gpu_addon_manifest_records = -1, native_gpu_addon_manifest_skipped = 0, native_gpu_addon_deleted = 0;
+volatile int native_gpu_addon_manifest_error = 0;
+static uint64_t
+native_gpu_addon_hash(const uint8_t *packed, uint64_t packed_size, uint64_t size, uint32_t mode)
+{
+	uint64_t hash = 0xcbf29ce484222325ULL;
+	for (uint64_t i = 0; i < packed_size; i++) {
+		hash = (hash ^ packed[i]) * 0x100000001b3ULL;
+	}
+	return hash ^ (size * 0x9e3779b97f4a7c15ULL) ^ ((uint64_t)mode << 48);
+}
+/* Reads the manifest into records (at most NATIVE_GPU_MANIFEST_MAX); returns the count, 0 when absent or malformed. */
+static uint32_t
+native_gpu_manifest_read(struct native_gpu_manifest_record *records, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	if (vnode_open(native_gpu_manifest_path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx)) {
+		return 0;
+	}
+	uint8_t header[16];
+	uint32_t count = 0;
+	int resid = 0, error = vn_rdwr(UIO_READ, vp, (caddr_t)header, sizeof(header), 0, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx),
+	    &resid, vfs_context_proc(ctx));
+	if (!error && !resid && !memcmp(header, "NGPUMAN1", 8)) {
+		memcpy(&count, header + 8, 4);
+		if (count > NATIVE_GPU_MANIFEST_MAX) {
+			count = 0;
+		}
+		int bytes = (int)(count * sizeof(struct native_gpu_manifest_record));
+		if (count && (vn_rdwr(UIO_READ, vp, (caddr_t)records, bytes, sizeof(header), UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx),
+		    &resid, vfs_context_proc(ctx)) || resid)) {
+			count = 0;
+		}
+	}
+	vnode_close(vp, FREAD, ctx);
+	for (uint32_t i = 0; i < count; i++) {
+		if (!records[i].used || records[i].name[sizeof(records[i].name) - 1] || !records[i].name[0]) {
+			return 0;	/* malformed: start over */
+		}
+	}
+	return count;
+}
+static int
+native_gpu_manifest_write(const struct native_gpu_manifest_record *records, uint32_t count, vfs_context_t ctx)
+{
+	uint8_t header[16] = {'N', 'G', 'P', 'U', 'M', 'A', 'N', '1'};
+	uint32_t kept = 0;
+	for (uint32_t i = 0; i < count; i++) {
+		kept += records[i].used ? 1 : 0;
+	}
+	memcpy(header + 8, &kept, 4);
+	vnode_t vp = NULLVP;
+	int error = vnode_open(native_gpu_manifest_path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, 0600, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	int resid = 0;
+	off_t at = sizeof(header);
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)header, sizeof(header), 0, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	for (uint32_t i = 0; !error && i < count; i++) {
+		if (!records[i].used) {
+			continue;
+		}
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)&records[i], sizeof(records[i]), at, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		at += sizeof(records[i]);
+	}
+	if (!error && resid) {
+		error = EIO;
+	}
+	if (!error) {
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	int close_error = vnode_close(vp, FWRITE, ctx);
+	return error ? error : close_error;
+}
+static struct native_gpu_manifest_record *
+native_gpu_manifest_find(struct native_gpu_manifest_record *records, uint32_t count, const char *name)
+{
+	for (uint32_t i = 0; i < count; i++) {
+		if (records[i].used && !strcmp(records[i].name, name)) {
+			return &records[i];
+		}
+	}
+	return NULL;
+}
+/* The Data file is still a regular file with the recorded size and mode. */
+static int
+native_gpu_addon_present(const char *path, uint64_t size, uint32_t mode, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx)) {
+		return 0;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	VATTR_WANTED(&va, va_mode);
+	int present = vnode_vtype(vp) == VREG && !vnode_getattr(vp, &va, ctx) && va.va_data_size == size && (va.va_mode & 07777) == mode;
+	vnode_put(vp);
+	return present;
+}
+static int
+native_gpu_addon_delete(proc_t p, user_addr_t scratch, const char *path, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	int regular = vnode_vtype(vp) == VREG;
+	vnode_put(vp);
+	if (!regular) {
+		return EISDIR;	/* only regular files: directories stay */
+	}
+	struct unlink_args request = {.path = scratch + 0xa00};
+	int32_t result = 0;
+	error = copyout(path, request.path, strlen(path) + 1);
+	if (!error) {
+		error = unlink(p, &request, &result);
+	}
+	return error;
+}
