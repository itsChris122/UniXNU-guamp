+// guamp (UniXNU-guamp patches/adreno-metal/0023, NMB_PERF): the frames this process makes, for the kernel's GuampGpuPerf lines. A frame
+// is a drawable presented (presentDrawable:), or, in a process that never presented one (the render server, which swaps surfaces), a
+// commit with a render pass (commits within 4 ms of the previous one are the same frame). lost: the vsync periods (16.7 ms) skipped
+// between two frames less than 100 ms apart, i.e. inside an animation. Two atomics and a clock read per frame; nothing else.
+static std::atomic<uint64_t> gPerfFrames,gPerfLost,gPerfLastUs;
+static std::atomic<bool> gPerfPresents;
+static void perfFrame(bool present) {
+ if(present)gPerfPresents.store(true,std::memory_order_relaxed);
+ else if(gPerfPresents.load(std::memory_order_relaxed))return;
+ const uint64_t now=nowUs(),last=gPerfLastUs.exchange(now,std::memory_order_relaxed);
+ const uint64_t gap=last && now>last?now-last:0;
+ if(!present && last && gap<4000){gPerfLastUs.store(last,std::memory_order_relaxed);return;}
+ gPerfFrames.fetch_add(1,std::memory_order_relaxed);
+ if(gap && gap<100000) {const uint64_t periods=(gap+8333)/16667;if(periods>1)gPerfLost.fetch_add(periods-1,std::memory_order_relaxed);}
+}
