 // The scanout service's cost so far (native_bridge_metal_present_cost): frames, the ns of import, texture, encode, submit and wait, the copy
 // forms taken, and the textures made and reused.
+// guamp 0023: the frame report since the previous call, the kernel's GuampGpuPerfCore.h fields: [0] frames, [1] lost vsync periods,
+// [2] time inside the bridge's calls (draws, binds, passes, blits, resource creation and uploads, commits), [3] its waits for resources
+// in GPU use, [4] the process's command buffer waits beyond those, [5] commit to completion summed, [6] command buffers completed,
+// [7] the window in ms, [8] shader compiles (pipelines, libraries, functions), [9] scanout copies, [10] their cost, [11] their wait;
+// times in units of 10 us. Returns false when nothing was committed or presented since the previous call (then nothing is sent).
+extern "C" bool native_bridge_metal_perf_sample(uint32_t out[12]) {
+ static uint64_t last[13];static uint64_t lastAt;
+ const uint64_t now=nowUs();
+ auto t=[](const Timed &x){return x.total.load(std::memory_order_relaxed);};
+ const uint64_t v[13]={gPerfFrames.load(),gPerfLost.load(),
+  t(gTimeDraw)+t(gTimeBind)+t(gTimePassOpen)+t(gTimePassClose)+t(gTimeBlit)+t(gTimeCreate)+t(gTimeRegion)+t(gTimeCommit),
+  t(gTimeResourceWait),t(gTimeWaitCompleted)+t(gTimeWaitScheduled),t(gTimeEncodeToCommit),gTimeEncodeToCommit.count.load(),0,
+  t(gTimePipeline)+t(gTimeLibrary)+t(gTimeFunction),gPresent[0].load(),
+  (gPresent[1].load()+gPresent[2].load()+gPresent[3].load()+gPresent[4].load()+gPresent[5].load())/1000,gPresent[5].load()/1000,gCommits.load()};
+ uint64_t d[13];
+ for(unsigned i=0;i<13;i++){d[i]=v[i]>=last[i]?v[i]-last[i]:0;last[i]=v[i];}
+ const uint64_t span=lastAt && now>lastAt?now-lastAt:0;lastAt=now;
+ const bool moved=d[0] || d[12];
+ if(!moved)return false;
+ // The resource waits run through waitUntilCompleted, so they are taken out of the command buffer waits.
+ d[4]=d[4]>d[3]?d[4]-d[3]:0;
+ d[7]=span/1000;   // ms
+ for(unsigned i=0;i<12;i++) {
+  const uint64_t value=(i==0 || i==1 || i==6 || i==7 || i==9)?d[i]:d[i]/10;
+  out[i]=value>0xfffff?0xfffff:(uint32_t)value;
+ }
+ return true;
+}
