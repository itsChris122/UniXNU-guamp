+// guamp (UniXNU-guamp patches/adreno-metal/0023): NMB_PERF=1 (the board adds it to NativeMetalEnv with guamp-gpu-perf) sends this
+// process's frame report (native_bridge_metal_perf_sample) to the kernel once a second, for its GuampGpuPerf lines: each field that is
+// not zero as two markers, 0x3000 | field << 8 | value >> 12 then 0x2000 | (value & 0xfff), and 0x3f00, 0x2001 to end it (the kernel's
+// GuampGpuPerfCore.h). About 20 refused opens a second while the process draws, none while it is idle; without NMB_PERF no thread.
+static void startPerfReport(unsigned port) {
+    const char *on = getenv("NMB_PERF");
+    if (!on || !strtoul(on, nullptr, 0)) return;
+    Gpu *gpu = makeGpu(port);
+    if (!gpu || !gpu->openFn) return;
+    if (void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_NOW | RTLD_LOCAL)) {
+        if (auto retain = (int (*)(unsigned))dlsym(iokit, "IOObjectRetain")) retain(port);   // the thread keeps using the port
+    }
+    pthread_t thread;
+    if (pthread_create(&thread, nullptr, [](void *argument) -> void * {
+            Gpu *g = static_cast<Gpu *>(argument);
+            uint32_t fields[12];
+            for (;;) {
+                sleep(1);
+                if (!native_bridge_metal_perf_sample(fields)) continue;
+                for (unsigned k = 0; k < 12; ++k) {
+                    if (!fields[k]) continue;
+                    g->mark(0x3000u | k << 8 | fields[k] >> 12);
+                    g->mark(0x2000u | (fields[k] & 0xfff));
+                }
+                g->mark(0x3f00u);
+                g->mark(0x2001u);
+            }
+            return nullptr;
+        }, gpu) == 0) pthread_detach(thread);
+}
