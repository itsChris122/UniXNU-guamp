+// The slot of a fragment function's name, 1-based (0: none, or no slot left): "_frag", "_lph" and "_lpf" dropped, 15 characters kept.
+static int fnSlotFor(NSString *name) {
+ if(!gFnOn || !name.length)return 0;
+ std::string n=name.UTF8String;
+ for(const char *cut:{"_frag","_lph","_lpf"})for(size_t at;(at=n.find(cut))!=std::string::npos;)n.erase(at,strlen(cut));
+ if(n.size()>15)n.resize(15);
+ std::lock_guard<std::mutex> lock(gFnLock);
+ const unsigned have=gFnCount.load();
+ for(unsigned i=0;i<have;i++)if(n==gFnNames[i])return (int)i+1;
+ if(have>=kFnSlots)return 0;
+ memcpy(gFnNames[have],n.c_str(),n.size()+1);gFnCount.store(have+1);
+ return (int)have+1;
+}
+// Whether a full-screen surface sampled now holds what it held at its previous such draw (its seed unchanged): a few surfaces, by ID.
+static bool fsSurfaceStatic(IOSurfaceRef surface) {
+ struct Seen {uint32_t id,seed;};
+ static Seen seen[8];static unsigned next;static std::mutex lock;
+ const uint32_t id=IOSurfaceGetID(surface),seed=IOSurfaceGetSeed(surface);
+ std::lock_guard<std::mutex> guard(lock);
+ for(Seen &s:seen)if(s.id==id){const bool same=s.seed==seed;s.seed=seed;return same;}
+ seen[next++%8]={id,seed};
+ return false;
+}
