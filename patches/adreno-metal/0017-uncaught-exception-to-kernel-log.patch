         exceptiondiag::start(); // the throw site of an uncaught exception, for the kernel's THROW row (ExceptionDiag.h)
+        // guamp 0017: and to the kernel log, through the same text stream as the client problems, from this process's accelerator port.
+        static unsigned gExceptionPort;
