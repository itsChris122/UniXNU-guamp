+/// guamp (UniXNU-guamp patches/adreno-metal/0040): the device's memory into the caller's fourteen words: the bytes of its pooled blocks
+/// with a placement, placed in them, of its empty pooled blocks, of its dedicated blocks and of the host memory imported; the blocks of
+/// those four kinds; the bytes allocated so far; then the process's setPurgeableState requests (volatile, their bytes, empty, their bytes).
+/// Diagnostic only.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_device_memory_census(device: *const NmbDevice, out: *mut u64) -> bool {
+    guard(false, || {
+        if out.is_null() {
+            return Err("null census".into());
+        }
+        // SAFETY: the header's fourteen words.
+        let out = unsafe { std::slice::from_raw_parts_mut(out, 14) };
+        out[..10].copy_from_slice(&get(device)?.0.memory_census());
+        out[10..].copy_from_slice(&metal2vulkan_runtime::purgeable_census());
+        Ok(true)
+    })
+}
+
 /// The device's texture copy counts into the caller's eight words: linear images at Metal's row pitch made, refused by the driver and
 /// refused again from memory, textures given a shadow image, shadow copies in and texels copied back, and passes over linear images
 /// rendered in place and through copies.
