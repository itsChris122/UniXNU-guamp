+// guamp (UniXNU-guamp patches/adreno-metal/0001): the CPU's view of the surfaces a command buffer's render passes write. flushSurfaces only
+// cleans (DC CVAC) and skips a surface whose seed did not move, so lines the CPU still holds (the kernel's zero fill of a new surface, an
+// earlier CPU read) stayed valid after the GPU wrote DRAM: another process reading the surface (a screenshot, an app snapshot, its
+// downscaled copy) could see those stale lines instead of the GPU's pixels. A written surface is cleaned and invalidated (DC CIVAC, to the
+// point of coherency, so the lines go for every process that maps the pages) at commit, whatever its seed, and again once the GPU has
+// completed. Only its first NMB_SURFACE_INVALIDATE completed writes (default 4, 0 = off) are walked: a capture surface is written once,
+// while the render server's own framebuffers (about 5 MB, ~2 ms per MB here) are rewritten every frame and are read by the display
+// driver's copy, which keeps its own cache maintenance.
+static std::unordered_map<uint64_t,uint32_t> gSurfaceWrites;   // (IOSurfaceID, mapping page): completed writes walked (gSurfaceSeedLock)
+static std::atomic<uint64_t> gSurfaceInvalidations,gSurfaceInvalidateBytes;
+static unsigned surfaceInvalidateLimit() {
+ static const unsigned limit=[]{const char *v=getenv("NMB_SURFACE_INVALIDATE");return v?(unsigned)strtoul(v,nullptr,0):4u;}();
+ return limit;
+}
+static void cleanInvalidateToCoherency(uintptr_t start,size_t bytes) {
+ for(uintptr_t at=start&~(uintptr_t)63,end=start+bytes;at<end;at+=64)__asm__ volatile("dc civac, %0"::"r"(at):"memory");
+ __asm__ volatile("dsb sy":::"memory");
+}
+static void invalidateWrittenSurfaces(NSMutableSet *written,bool completed) {
+ const unsigned limit=surfaceInvalidateLimit();
+ if(!limit || !written.count)return;
+ std::vector<std::pair<uintptr_t,size_t>> ranges;
+ for(NBTexture *texture in written)if(IOSurfaceRef surface=texture.surface) {
+  const uintptr_t base=reinterpret_cast<uintptr_t>(IOSurfaceGetBaseAddress(surface));
+  const uint64_t key=((uint64_t)IOSurfaceGetID(surface)<<32)^(uint64_t)(base>>12);
+  {
+   std::lock_guard<std::mutex> lock(gSurfaceSeedLock);
+   uint32_t &walked=gSurfaceWrites[key];
+   if(walked>=limit)continue;
+   if(completed)walked++;
+  }
+  ranges.push_back({base,IOSurfaceGetAllocSize(surface)});
+ }
+ std::sort(ranges.begin(),ranges.end());
+ ranges.erase(std::unique(ranges.begin(),ranges.end(),[](const std::pair<uintptr_t,size_t> &a,const std::pair<uintptr_t,size_t> &b){return a.first==b.first;}),ranges.end());
+ for(const std::pair<uintptr_t,size_t> &r:ranges) {
+  cleanInvalidateToCoherency(r.first,r.second);
+  gSurfaceInvalidations++;gSurfaceInvalidateBytes+=r.second;
+ }
+}
