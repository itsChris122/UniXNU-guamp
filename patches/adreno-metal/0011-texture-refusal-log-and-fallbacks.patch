+// The pixel format a texture of format f is made in when the runtime refuses f, or 0 when nothing stands in for it.
+static uint32_t substituteFormat(uint32_t f) {
+ const bool compressed=(f>=130 && f<=153) || (f>=160 && f<=167) || (f>=170 && f<=183) || (f>=186 && f<=233);
+ const bool packed=f>=40 && f<=43;
+ const bool ycbcr=(f>=240 && f<=241) || (f>=500 && f<=520);
+ if(compressed || packed || ycbcr)return srgbFormat(f)?71u:70u;
