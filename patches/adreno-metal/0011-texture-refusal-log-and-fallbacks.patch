+ snprintf(line,sizeof line,"texref %.1s f%llu t%llu u%llx s%u %llux%llu m%llu n%llu",stage,(unsigned long long)d.format,
+          (unsigned long long)d.type,(unsigned long long)d.usage,storage,(unsigned long long)d.width,(unsigned long long)d.height,
+          (unsigned long long)d.levels,(unsigned long long)d.samples);
