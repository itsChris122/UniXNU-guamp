+ if(!handle) {
+  const uint64_t usage=t.usage&~(uint64_t)(MTLTextureUsageShaderWrite|MTLTextureUsagePixelFormatView|0x20u);   // 0x20: ShaderAtomic
+  if(usage!=t.usage){NmbTextureDescriptor u=t;u.usage=usage;if((handle=nmb_texture_new(gDevice,&u)))t=u;}
+ }
+ for(uint32_t f=substituteFormat((uint32_t)t.format),tries=0;!handle && f && tries<2;f=substituteFormat(f),tries++) {
