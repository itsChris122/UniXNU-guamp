+  if((handle=nmb_texture_new(gDevice,&u))){*substituted=(uint32_t)d.format;t=u;}
+ }
+ if(!handle){reportTextureRefusal(t,"fallback",lastError());return nullptr;}
+ gTextureFallbacks++;
+ NBLOG(@"native-metal: texture fallback fmt %llu -> %llu usage 0x%llx -> 0x%llx storage %llu -> %llu (%llux%llu)",(unsigned long long)d.format,
+       (unsigned long long)t.format,(unsigned long long)d.usage,(unsigned long long)t.usage,(unsigned long long)storage,
+       (unsigned long long)((t.options&MTLResourceStorageModeMask)>>MTLResourceStorageModeShift),(unsigned long long)d.width,(unsigned long long)d.height);
+ return handle;
+}
