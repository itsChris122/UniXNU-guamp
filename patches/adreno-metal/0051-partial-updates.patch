+/// guamp (partial updates): passes ended; colour 0 loaded; cleared; passes whose draws' scissors bound them; the pixels of those bounds;
+/// of those passes' render areas; texels the shadow copies in moved; texels of their whole images.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_device_partial_counts(device: *const NmbDevice, out: *mut u64) -> bool {
+    guard(false, || {
+        if out.is_null() {
+            return Err("null counts".into());
+        }
+        // SAFETY: the header's eight words.
+        let out = unsafe { std::slice::from_raw_parts_mut(out, 8) };
+        let w = get(device)?.0.work_counts();
+        out.copy_from_slice(&[w.passes_ended, w.passes_color0_load, w.passes_color0_clear, w.passes_bounded, w.bounded_area_pixels,
+                              w.bounded_extent_pixels, w.shadow_texels_copied_in, w.shadow_texels_in_whole]);
+        Ok(true)
+    })
+}
