++/// guamp (UniXNU-guamp, AdrenoMetal bridge patch 0025): Turnip on an Adreno 6xx (the Moto G9
++/// Play's A610) is in no table above, so every opaque color write was rounded to Metal's code in
++/// the shader and every `half` operation ran in `f32` with a rounding after it. On QuartzCore's
++/// `fixed_frag_lph_cpf` (its 199 variants of one render server) the color rounding alone was 43 %
++/// of the fragment ALU instructions: about 20 a channel of an opaque BGRA8 write, about 70 and a
++/// table read a channel of an sRGB one. These facts are ASSUMED from what Turnip declares on
++/// a6xx, not measured as the rows above are: `f32` and `f16` arithmetic rounding to nearest even,
++/// `f32` denormals flushed (as Metal flushes them), `f16` denormals flushed where Metal keeps them
++/// (a difference below 2^-14 only), and the render backend's unorm and sRGB conversion, at most one
++/// code from Metal's at an exact tie. `METAL2VULKAN_GUAMP_ADRENO_FACTS`: unset or `all` takes every
++/// one, `colors` the color writes only, `0` none (Metal's exact routes, as before). The facts are
++/// part of the profile and its fingerprint, so the shader cache keeps each choice's entries apart.
++pub(crate) const GUAMP_ADRENO_A6XX: &[DriverDeviation] = &[
++    DriverDeviation::MetalColorWrites,
++    DriverDeviation::MetalFloatDenormals,
++    DriverDeviation::MetalHalfArithmetic,
++    DriverDeviation::MetalHalfConversion,
++    DriverDeviation::MetalHalfQuantize,
++    DriverDeviation::MetalHalfFma,
++];
++
++/// Qualcomm's vendor id, as Turnip reports it.
++const QUALCOMM_VENDOR_ID: u32 = 0x5143;
++
++/// The guamp facts `description` takes (`GUAMP_ADRENO_A6XX`): Turnip on a Qualcomm GPU whose
++/// `deviceID` (Turnip's chip id) is of the 6xx generation, `0x06xxxxxx` (the A610: `0x06010000`).
++pub(crate) fn guamp_adreno_facts(description: &DeviceDescription) -> &'static [DriverDeviation] {
++    if description.driver_id != Some(DriverId::MESA_TURNIP)
++        || description.vendor_id != QUALCOMM_VENDOR_ID
++        || description.device_id >> 24 != 6
++    {
++        return &[];
++    }
++    match std::env::var("METAL2VULKAN_GUAMP_ADRENO_FACTS").as_deref() {
++        Ok("0") | Ok("none") => &[],
++        Ok("colors") => &GUAMP_ADRENO_A6XX[..1],
++        _ => GUAMP_ADRENO_A6XX,
++    }
+ }
+ 
+ /// A driver's measured answer where Vulkan leaves the result undefined, or its measured cost of
+@@ -2236,3 +2280,41 @@ pub(crate) const fn nvidia(major: u32, minor: u32, patch: u32) -> u32 {
+ pub(crate) const fn moltenvk(major: u32, minor: u32, patch: u32) -> u32 {
+     major * 10000 + minor * 100 + patch
+ }
++
