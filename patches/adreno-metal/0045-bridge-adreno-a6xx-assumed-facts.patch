+ /// The deviations of the driver `description` names, on its GPU's vendor, at its release.
+ pub(crate) fn deviations(description: &DeviceDescription) -> BTreeMap<DriverDeviation, Standing> {
+-    among(
++    let mut facts = among(
+         DEVIATIONS,
