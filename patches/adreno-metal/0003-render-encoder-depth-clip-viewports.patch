+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_render_set_viewports(encoder: *mut NmbEncoder, viewports: *const f64, count: u64) -> bool {
+    guard(false, || {
+        // The runtime takes 1 to 16 viewports (set_viewports); a larger count is refused here before the read.
+        if viewports.is_null() || count == 0 || count > 16 {
+            return Err(format!("{count} viewports"));
+        }
+        // SAFETY: the header's six values for each of the count viewports.
+        let v = unsafe { std::slice::from_raw_parts(viewports, count as usize * 6) };
+        let list: Vec<Viewport> = v.chunks_exact(6).map(|v| Viewport::new(v[0], v[1], v[2], v[3], v[4], v[5])).collect();
+        render(encoder)?.set_viewports(&list).map_err(e("viewports"))?;
+        Ok(true)
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_render_set_scissors(encoder: *mut NmbEncoder, rects: *const u64, count: u64) -> bool {
+    guard(false, || {
+        if rects.is_null() || count == 0 || count > 256 {
+            return Err(format!("{count} scissor rectangles"));
+        }
+        // SAFETY: the header's four values for each of the count rectangles.
+        let r = unsafe { std::slice::from_raw_parts(rects, count as usize * 4) };
+        let list: Vec<ScissorRect> = r.chunks_exact(4).map(|r| ScissorRect::new(r[0], r[1], r[2], r[3])).collect();
+        render(encoder)?.set_scissor_rects(&list).map_err(e("scissor rectangles"))?;
+        Ok(true)
+    })
+}
+
+/// `setDepthClipMode:` (Maps' VectorKit sets it for every render item). `Clamp` is the runtime's own: refused where the device has no
