+// guamp: Maps (VectorKit ggl::MetalRenderItemEncoder::encode) sets the depth clip mode for every item and aborted on the missing selector.
+// The runtime takes it (clamp needs the device's depthClamp); a refusal keeps clipping and does not fail the command buffer, since the two
+// differ only for geometry past the near and far planes. Logged once.
+- (void)setDepthClipMode:(MTLDepthClipMode)mode {
+ const uint32_t value=(uint32_t)mode;
+ if(depthClipSet && depthClipPushed==value){++gStateSkipped[kStateOther];return;}
+ depthClipPushed=value;depthClipSet=true;
+ const uint64_t began=nowUs();
+ if(!nmb_render_set_depth_clip_mode(self.handle,value)){
+  static std::atomic<bool> told{false};
+  if(!told.exchange(true))NBLOG(@"native-metal: setDepthClipMode:%u kept as clip: %@",value,lastError());
+ }
+ gTimeState[kStateOther].add(began);
+}
