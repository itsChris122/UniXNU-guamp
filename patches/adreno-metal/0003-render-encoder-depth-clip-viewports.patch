+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_render_set_depth_clip_mode(encoder: *mut NmbEncoder, mode: u64) -> bool {
+    guard(false, || {
+        render(encoder)?.set_depth_clip_mode(raw::<DepthClipMode>(mode, "depth clip mode")?).map_err(e("depth clip mode"))?;
+        Ok(true)
+    })
+}
