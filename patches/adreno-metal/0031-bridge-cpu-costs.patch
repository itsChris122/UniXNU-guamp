++//! A compositor-like frame loop for measuring the runtime's CPU cost per draw, per pass close and per commit
++//! (guamp bench, local): each frame one render pass of DRAWS draws over a 256x256 BGRA target, the draws
++//! switching between two pipelines every four, each with its own vertex bytes, as Core Animation encodes.
++//!
++//! FRAMES=400 cargo run --release -p metal2vulkan-runtime --example draw_costs
++mod common;
++
++use metal2vulkan::metal::{PixelFormat, PrimitiveType, TextureUsage};
++use metal2vulkan::pipeline::{ColorAttachmentDescriptor, RenderPipelineDescriptor, StageSource};
++use metal2vulkan_runtime::{
++    ClearColor, Device, LoadAction, PipelineOptions, RenderPassDescriptor, ResourceOptions, StoreAction,
++    TextureDescriptor,
++};
++use std::time::{Duration, Instant};
++
++const DRAWS: usize = 40;
++
++/// This thread's CPU time: what the encoding thread spends, whatever else runs on the machine.
++fn thread_cpu() -> Duration {
++    let mut t = libc::timespec { tv_sec: 0, tv_nsec: 0 };
