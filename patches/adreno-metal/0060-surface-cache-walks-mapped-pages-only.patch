+static std::atomic<uint64_t> gCacheWalkSkippedBytes,gCacheWalkSkippedRanges;
+template<typename Walk> static void forMappedSpans(const char *what,uintptr_t start,size_t bytes,Walk &&walk) {
+ const uintptr_t end=start+bytes;
+ if(!bytes || end<start)return;
+ uintptr_t at=start;uint64_t skipped=0;
+ while(at<end) {
+  vm_address_t address=(vm_address_t)at;vm_size_t size=0;natural_t depth=0;
+  vm_region_submap_short_info_data_64_t info={};mach_msg_type_number_t count=VM_REGION_SUBMAP_SHORT_INFO_COUNT_64;
+  if(vm_region_recurse_64(mach_task_self(),&address,&size,&depth,(vm_region_recurse_info_t)&info,&count)!=KERN_SUCCESS || !size)break;
+  if((uintptr_t)address>=end)break;
+  const uintptr_t from=std::max<uintptr_t>((uintptr_t)address,at),to=std::min<uintptr_t>((uintptr_t)address+(uintptr_t)size,end);
+  if(to<=from)break;
+  skipped+=from-at;
+  if(info.protection&VM_PROT_READ)walk(from,(size_t)(to-from));else skipped+=to-from;
+  at=to;
+ }
+ if(at<end)skipped+=end-at;
+ if(!skipped)return;
+ gCacheWalkSkippedBytes+=skipped;
+ if(gCacheWalkSkippedRanges++<3)
+  NBLOG(@"native-metal: %s skipped %llu unmapped bytes of %llx+%llx",what,(unsigned long long)skipped,(unsigned long long)start,(unsigned long long)bytes);
+}
