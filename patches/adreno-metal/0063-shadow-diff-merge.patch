++/// guamp (diff copy back, `NMB_SHADOW_DIFF`): which writes through a shadow of bytes reach the
++/// buffer as a merge (`shadow_merge.rs`: only the bytes the command changed against the shadow
++/// as it was copied in) instead of a copy back of the whole written area. A copy back rewrites
++/// every texel of the area, so bytes something outside the encoder's ordering wrote meanwhile
++/// (another process's work on the same surface, a CPU write racing the GPU) are set back to
++/// what the copy in saw; a merge leaves every byte the command did not change. The same result
++/// for a well-ordered program, at the merge's cost (a scratch of three copies of the texture's
++/// bytes and one compute dispatch, in place of one copy back). `NMB_SHADOW_DIFF=1` merges every
++/// such write, `=2` only those whose area the command does not bound (no scissor bound, so the
++/// copy back would be the whole texture); unset or `0` copies back as before.
++#[derive(Clone, Copy, Debug, PartialEq, Eq)]
++pub(super) enum DiffBack {
++    Off,
++    Unbounded,
++    All,
++}
++
++impl DiffBack {
++    /// The setting `NMB_SHADOW_DIFF` names.
++    pub(super) fn parse(value: Option<&str>) -> DiffBack {
++        match value.map(str::trim) {
++            Some("1") | Some("all") => DiffBack::All,
++            Some("2") | Some("unbounded") => DiffBack::Unbounded,
++            _ => DiffBack::Off,
++        }
++    }
++
++    /// The setting of this process, read once.
++    fn current() -> DiffBack {
++        static ON: std::sync::OnceLock<DiffBack> = std::sync::OnceLock::new();
++        *ON.get_or_init(|| DiffBack::parse(std::env::var("NMB_SHADOW_DIFF").ok().as_deref()))
++    }
++
++    /// Whether `shadow`, a command's use, writes through a shadow whose writes this setting
++    /// merges: one a merge serves, that keeps what it writes, and that does not replace every
++    /// texel (a cleared attachment changes them all anyway).
++    fn merges(self, shadow: &ShadowUse) -> bool {
++        let wanted = match self {
++            DiffBack::Off => false,
++            DiffBack::All => true,
++            DiffBack::Unbounded => shadow.area.is_none(),
++        };
++        wanted
++            && shadow.writes
++            && !shadow.overwrites
++            && !shadow.copies.drops_writes
++            && shadow.copies.unmerged().is_none()
++    }
++}
++
+ /// The rectangle bounding `a` and `b`, each `[x0, y0, x1, y1)`; `None` (anywhere) where either is.
+ fn bounding(a: Option<[u32; 4]>, b: Option<[u32; 4]>) -> Option<[u32; 4]> {
+     let ([a0, a1, a2, a3], [b0, b1, b2, b3]) = (a?, b?);
+@@ -1060,12 +1110,22 @@ fn bounding(a: Option<[u32; 4]>, b: Option<[u32; 4]>) -> Option<[u32; 4]> {
+ /// the scratch of a merge.
+ pub(super) struct ShadowSync<M = Arc<ShadowMerge>> {
+     entries: Vec<Entry<M>>,
++    /// guamp: which writes reach the buffer as merges ([`DiffBack`]).
++    diff: DiffBack,
+ }
+ 
+ impl<M> Default for ShadowSync<M> {
+     fn default() -> Self {
++        ShadowSync::with_diff(DiffBack::current())
++    }
++}
++
++impl<M> ShadowSync<M> {
++    /// An encoder's, whose writes reach the buffer as `diff` says.
++    pub(super) fn with_diff(diff: DiffBack) -> Self {
+         ShadowSync {
+             entries: Vec::new(),
++            diff,
+         }
+     }
+ }
+@@ -1156,7 +1216,8 @@ impl<M: Clone> ShadowSync<M> {
+         }
+         let mut kept = Vec::new();
+         for (i, shadow) in shadows.iter().enumerate() {
+-            if two_ways(shadows, i, uses) {
++            // guamp: or a write this encoder merges back in any case ([`DiffBack`]).
++            if two_ways(shadows, i, uses) || self.diff.merges(shadow) {
+                 kept.push((Arc::clone(&shadow.copies), merge(&shadow.copies)?));
+             }
+         }
