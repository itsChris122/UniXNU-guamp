++/// guamp (`NMB_SHADOW_DIFF`): a write through a shadow of bytes reaches the buffer as a merge
++/// of the bytes it changed, everywhere (`1`) or where its area is unbounded (`2`); a pass that
++/// replaces every texel, and the setting off, copy back as before.
++#[test]
++fn a_diff_setting_merges_writes_back_instead_of_copying_them() {
++    use super::super::shadow::DiffBack;
++    assert_eq!(DiffBack::parse(None), DiffBack::Off);
++    assert_eq!(DiffBack::parse(Some("0")), DiffBack::Off);
++    assert_eq!(DiffBack::parse(Some("1")), DiffBack::All);
++    assert_eq!(DiffBack::parse(Some(" 2 ")), DiffBack::Unbounded);
++    let buffer = ResourceKey::new();
++    let t = shadow(buffer, 256..1280);
++    let key = t.shadow_key;
++    let area = Some([0, 0, 16, 4]);
++    let pass = |area: Option<[u32; 4]>, overwrites: bool| ShadowUse {
++        copies: Arc::clone(&t),
++        writes: true,
++        overwrites,
++        kept: false,
++        area,
++        loads: area,
++    };
++    let (_, written) = through(&t, true);
++    let uses = [written];
++    let run = |diff: DiffBack, shadow: ShadowUse| {
++        let mut sync = ShadowSync::<u32>::with_diff(diff);
++        let shadows = [shadow];
++        let before = sync.before(&shadows, &uses, |_| Ok(7)).unwrap();
++        sync.after(&shadows, &uses);
++        let areas: Vec<_> = before.iter().map(|copy| copy.area).collect();
++        (moved(&before), areas, moved(&sync.finish()))
++    };
++    // Off: a copy in of the loaded rectangle, a copy back of it.
++    assert_eq!(
++        run(DiffBack::Off, pass(area, false)),
++        (vec![Moved::Into(key)], vec![area], vec![Moved::Back(key)])
++    );
++    // All: the whole texture in (a merge compares every byte), kept, merged at the end.
++    assert_eq!(
++        run(DiffBack::All, pass(area, false)),
++        (
++            vec![Moved::Into(key), Moved::Keep(key, 7)],
++            vec![None, None],
++            vec![Moved::Merge(key, 7)]
++        )
++    );
++    // Unbounded: a bounded write copies back its rectangle, an unbounded one merges.
++    assert_eq!(
++        run(DiffBack::Unbounded, pass(area, false)),
++        (vec![Moved::Into(key)], vec![area], vec![Moved::Back(key)])
++    );
++    assert_eq!(
++        run(DiffBack::Unbounded, pass(None, false)),
++        (
++            vec![Moved::Into(key), Moved::Keep(key, 7)],
++            vec![None, None],
++            vec![Moved::Merge(key, 7)]
++        )
++    );
++    // A pass that replaces every texel takes no copy in and copies back, whatever the setting.
++    assert_eq!(
++        run(DiffBack::All, pass(None, true)),
++        (vec![], vec![], vec![Moved::Back(key)])
++    );
++    // A read is never kept.
++    let mut sync = ShadowSync::<u32>::with_diff(DiffBack::All);
++    let (read, used) = through(&t, false);
++    let copies = sync.before(&[read], &[used], |_| Ok(1)).unwrap();
++    assert_eq!(moved(&copies), [Moved::Into(key)]);
++}
